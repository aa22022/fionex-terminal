# =============================================================

function log_returns(prices::Vector{Float64})
    n = length(prices)
    if n < 2; return Float64[]; end
    [log(prices[i+1]/prices[i]) for i in 1:n-1 if prices[i]>0 && prices[i+1]>0]
end

function ema_vec(prices::Vector{Float64}, period::Int)
    alpha = 2.0 / (period + 1)
    out = Vector{Float64}(undef, length(prices))
    out[1] = prices[1]
    for i in 2:length(prices)
        out[i] = alpha * prices[i] + (1.0 - alpha) * out[i-1]
    end
    return out
end

function calc_rsi(prices::Vector{Float64}, period::Int=14)
    if length(prices) < period + 1; return 50.0; end
    ch = diff(prices[end-period:end])
    ag = mean(max.(ch, 0.0))
    al = mean(max.(-ch, 0.0))
    al < 1e-15 && return 100.0
    return 100.0 - 100.0 / (1.0 + ag / al)
end

function calc_macd(prices::Vector{Float64})
    if length(prices) < 26; return 0.0, 0.0, 0.0; end
    e12 = ema_vec(prices, 12)
    e26 = ema_vec(prices, 26)
    ml = last(e12) - last(e26)
    ms = e12[15:end] .- e26[15:end]
    sl = length(ms) >= 9 ? last(ema_vec(ms, 9)) : ml
    return ml, sl, ml - sl
end

function bollinger_bands(prices::Vector{Float64}, period::Int=20)
    if length(prices) < period
        m = mean(prices); s = std(prices)
        return m, m+2s, m-2s
    end
    r = prices[end-period+1:end]
    m = mean(r); s = std(r)
    return m, m+2s, m-2s
end

function calc_atr(prices::Vector{Float64}, period::Int=14)
    if length(prices) < period+1; return std(diff(prices)); end
    ranges = [abs(prices[i]-prices[i-1]) for i in 2:length(prices)]
    return mean(ranges[end-period+1:end])
end

# =============================================================
#  GARCH(1,1)
# =============================================================

function garch_forecast_vol(returns::Vector{Float64}, days::Int=7)
    n = length(returns)
    if n < 10; return fill(std(returns), days); end
    omega = 0.00001; alpha_g = 0.1; beta_g = 0.85
    sigma2 = var(returns)
    for r in returns; sigma2 = omega + alpha_g * r^2 + beta_g * sigma2; end
    vols = Float64[]
    for _ in 1:days
        sigma2 = omega + (alpha_g + beta_g) * sigma2
        push!(vols, sqrt(sigma2))
    end
    return vols
end

