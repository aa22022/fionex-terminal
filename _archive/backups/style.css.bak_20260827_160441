@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap');

/* ═══════════════════════════════════════════════════════════ */
/* CSS VARIABLES - Design System                              */
/* ═══════════════════════════════════════════════════════════ */
:root {
  /* Colors */
  --bg: #0a0d12;
  --bg-2: #0d1116;
  --panel: #10141a;
  --panel-2: #151a22;
  --panel-3: #1a2028;
  --border: #1e2630;
  --border-2: #2a3340;
  --border-bright: #3a4555;
  
  /* Text */
  --text: #d4dae3;
  --text-2: #8a95a5;
  --muted: #5c6878;
  --muted-2: #4a5460;
  
  /* Semantic */
  --up: #26a67a;
  --up-bg: #26a67a15;
  --up-border: #26a67a44;
  --down: #c4444e;
  --down-bg: #c4444e15;
  --down-border: #c4444e44;
  --warn: #c49a3c;
  --warn-bg: #c49a3c15;
  --warn-border: #c49a3c44;
  --info: #5a7fb8;
  --info-bg: #5a7fb815;
  --info-border: #5a7fb844;
  --purple: #8b5cf6;
  --purple-bg: #8b5cf615;
  --purple-border: #8b5cf644;
  --accent: #b8975a;
  --accent-bg: #b8975a15;
  --accent-border: #b8975a44;
  
  /* Layout */
  --nav-height: 48px;
  --statusbar-height: 24px;
  --radius: 4px;
  --radius-lg: 6px;
  --shadow: 0 2px 8px rgba(0,0,0,0.3);
  
  /* Fonts */
  --font-mono: 'Consolas', 'Courier New', monospace;
}

/* ═══════════════════════════════════════════════════════════ */
/* RESET & BASE                                                */
/* ═══════════════════════════════════════════════════════════ */
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  font-family: 'Vazirmatn', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  direction: rtl;
  font-size: 13px;
  line-height: 1.55;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

body {
  padding-top: var(--nav-height);
  padding-bottom: var(--statusbar-height);
  min-height: 100vh;
}

/* ═══════════════════════════════════════════════════════════ */
/* NAVIGATION BAR (Top)                                        */
/* ═══════════════════════════════════════════════════════════ */
.topnav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--nav-height);
  background: var(--panel);
  border-bottom: 1px solid var(--border-2);
  display: flex;
  align-items: center;
  padding: 0 20px;
  z-index: 1000;
  box-shadow: 0 1px 0 rgba(0,0,0,0.3);
}

.topnav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 24px;
  font-size: 14px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.topnav-brand::before {
  content: "◆";
  color: var(--accent);
  font-size: 16px;
}

.topnav-menu {
  display: flex;
  gap: 2px;
  flex: 1;
  overflow-x: auto;
  scrollbar-width: none;
}

.topnav-menu::-webkit-scrollbar { display: none; }

.topnav-link {
  padding: 6px 14px;
  color: var(--text-2);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  border-radius: var(--radius);
  transition: all 0.15s;
  white-space: nowrap;
  border: 1px solid transparent;
  background: transparent;
  font-family: inherit;
  position: relative;
}

.topnav-link:hover {
  color: var(--text);
  background: var(--panel-2);
}

.topnav-link.active {
  color: var(--accent);
  background: var(--accent-bg);
  border-color: var(--accent-border);
  font-weight: 600;
}

.topnav-link .badge {
  display: inline-block;
  background: var(--down);
  color: white;
  font-size: 9px;
  padding: 1px 5px;
  border-radius: 8px;
  margin-right: 4px;
  vertical-align: middle;
}

.topnav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-right: 12px;
}

.topnav-time {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted);
  padding: 4px 10px;
  background: var(--panel-2);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.topnav-btn {
  background: transparent;
  border: 1px solid var(--border-2);
  color: var(--text-2);
  padding: 5px 12px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  border-radius: var(--radius);
  transition: all 0.15s;
  font-family: inherit;
}

.topnav-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.topnav-btn:active {
  background: var(--accent-bg);
}

/* ═══════════════════════════════════════════════════════════ */
/* MAIN CONTAINER                                              */
/* ═══════════════════════════════════════════════════════════ */
.main-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 12px 16px;
}

.page {
  display: none;
  animation: fadeIn 0.2s;
}

.page.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════════════════════════════ */
/* PAGE HEADER                                                 */
/* ═══════════════════════════════════════════════════════════ */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding: 10px 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  flex-wrap: wrap;
  gap: 8px;
}

.page-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}

.page-title-icon {
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-bg);
  border: 1px solid var(--accent-border);
  border-radius: 3px;
  color: var(--accent);
  font-size: 12px;
}

.page-subtitle {
  font-size: 10px;
  color: var(--muted);
  margin-top: 2px;
}

.page-actions {
  display: flex;
  gap: 6px;
  align-items: center;
}

/* ═══════════════════════════════════════════════════════════ */
/* SECTIONS & CARDS                                            */
/* ═══════════════════════════════════════════════════════════ */
.section {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 8px;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 14px;
  border-bottom: 1px solid var(--border);
  background: var(--panel-2);
  flex-wrap: wrap;
  gap: 6px;
}

.section-title {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-title::before {
  content: "▸";
  color: var(--accent);
  font-size: 10px;
}

.section-body {
  padding: 12px 14px;
}

.section-body.no-pad {
  padding: 0;
}

/* Grid Layouts */
.grid { display: grid; gap: 8px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-5 { grid-template-columns: repeat(5, 1fr); }
.grid-6 { grid-template-columns: repeat(6, 1fr); }
.grid-auto { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
.grid-auto-lg { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }

/* Column layouts */
.col-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.col-3-1 { display: grid; grid-template-columns: 3fr 1fr; gap: 8px; }
.col-1-3 { display: grid; grid-template-columns: 1fr 3fr; gap: 8px; }
.col-2-1 { display: grid; grid-template-columns: 2fr 1fr; gap: 8px; }

/* ═══════════════════════════════════════════════════════════ */
/* KPI CELLS                                                   */
/* ═══════════════════════════════════════════════════════════ */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.kpi {
  background: var(--panel);
  padding: 12px 14px;
  transition: background 0.15s;
}

.kpi:hover {
  background: var(--panel-2);
}

.kpi-label {
  font-size: 9px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.6px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.kpi-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  direction: ltr;
  text-align: right;
  letter-spacing: -0.3px;
}

.kpi-sub {
  font-size: 9px;
  color: var(--muted-2);
  margin-top: 2px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kpi-change {
  font-size: 10px;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 3px;
  direction: ltr;
}

.kpi-change.up { color: var(--up); background: var(--up-bg); }
.kpi-change.down { color: var(--down); background: var(--down-bg); }
.kpi-change.flat { color: var(--muted); background: var(--panel-2); }

/* ═══════════════════════════════════════════════════════════ */
/* CHART CONTAINER                                             */
/* ═══════════════════════════════════════════════════════════ */
.chart-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  margin-bottom: 8px;
}

.chart-title {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 8px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chart-panel canvas {
  width: 100% !important;
  height: 320px !important;
}

.chart-panel.sm canvas { height: 200px !important; }
.chart-panel.md canvas { height: 260px !important; }
.chart-panel.lg canvas { height: 400px !important; }

/* ═══════════════════════════════════════════════════════════ */
/* TABLES                                                      */
/* ═══════════════════════════════════════════════════════════ */
.tbl-wrap {
  border-radius: var(--radius);
  overflow-x: auto;
  border: 1px solid var(--border);
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

th {
  background: var(--panel-2);
  color: var(--muted);
  padding: 8px 8px;
  text-align: center;
  font-weight: 600;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 1px solid var(--border-2);
  white-space: nowrap;
  position: sticky;
  top: 0;
}

td {
  padding: 7px 8px;
  text-align: center;
  border-bottom: 1px solid var(--border);
  font-variant-numeric: tabular-nums;
}

tr:hover td {
  background: var(--panel-2);
}

td.pos { color: var(--up); font-weight: 600; }
td.neg { color: var(--down); font-weight: 600; }
td.warn { color: var(--warn); font-weight: 600; }

/* ═══════════════════════════════════════════════════════════ */
/* BADGES & LABELS                                             */
/* ═══════════════════════════════════════════════════════════ */
.badge {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 3px;
  font-size: 9px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border: 1px solid;
}

.badge-up { background: var(--up-bg); color: var(--up); border-color: var(--up-border); }
.badge-down { background: var(--down-bg); color: var(--down); border-color: var(--down-border); }
.badge-warn { background: var(--warn-bg); color: var(--warn); border-color: var(--warn-border); }
.badge-info { background: var(--info-bg); color: var(--info); border-color: var(--info-border); }
.badge-accent { background: var(--accent-bg); color: var(--accent); border-color: var(--accent-border); }
.badge-purple { background: var(--purple-bg); color: var(--purple); border-color: var(--purple-border); }
.badge-muted { background: var(--panel-2); color: var(--muted); border-color: var(--border-2); }

.badge-grade-a-plus {
  background: linear-gradient(135deg, var(--up-bg), var(--accent-bg));
  color: var(--up);
  border: 1px solid var(--up);
  font-weight: 700;
}

.badge-grade-a { background: var(--up-bg); color: var(--up); border: 1px solid var(--up); font-weight: 700; }
.badge-grade-b { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn); font-weight: 700; }
.badge-grade-c { background: var(--info-bg); color: var(--info); border: 1px solid var(--info); }
.badge-grade-d { background: var(--panel-2); color: var(--muted); border: 1px solid var(--border-2); }

/* ═══════════════════════════════════════════════════════════ */
/* BUTTONS                                                     */
/* ═══════════════════════════════════════════════════════════ */
.btn {
  background: var(--panel-2);
  border: 1px solid var(--border-2);
  color: var(--text-2);
  padding: 5px 12px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  border-radius: var(--radius);
  transition: all 0.15s;
  font-family: inherit;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.btn.active {
  background: var(--accent-bg);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

.btn-group {
  display: flex;
  gap: 2px;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.btn-primary:hover {
  background: transparent;
  color: var(--accent);
}

/* ═══════════════════════════════════════════════════════════ */
/* SIGNAL & ALERT BOXES                                        */
/* ═══════════════════════════════════════════════════════════ */
.signal-list {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 12px;
}

.signal-item {
  padding: 4px 10px;
  margin-bottom: 2px;
  font-size: 11px;
  color: var(--text-2);
  border-right: 2px solid var(--border-2);
  line-height: 1.6;
}

.signal-item:hover {
  background: var(--panel-2);
  border-right-color: var(--accent);
}

.alert {
  padding: 8px 14px;
  border-radius: var(--radius);
  font-size: 11px;
  font-weight: 500;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.alert-danger { background: var(--down-bg); color: var(--down); border: 1px solid var(--down-border); }
.alert-warning { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-border); }
.alert-info { background: var(--info-bg); color: var(--info); border: 1px solid var(--info-border); }

/* ═══════════════════════════════════════════════════════════ */
/* STATUS BAR (Bottom)                                         */
/* ═══════════════════════════════════════════════════════════ */
.statusbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: var(--statusbar-height);
  background: var(--panel);
  border-top: 1px solid var(--border-2);
  display: flex;
  align-items: center;
  padding: 0 16px;
  font-size: 10px;
  color: var(--muted);
  gap: 16px;
  z-index: 999;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--up);
  display: inline-block;
  animation: pulse 2s infinite;
}

.status-dot.warn { background: var(--warn); }
.status-dot.err { background: var(--down); }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.status-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 8px;
  border-left: 1px solid var(--border);
}

.status-item:first-child {
  border-left: none;
}

.status-spacer { flex: 1; }

/* ═══════════════════════════════════════════════════════════ */
/* PREDICTION CARDS                                            */
/* ═══════════════════════════════════════════════════════════ */
.pred-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
}

.pred-title {
  font-size: 9px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.pred-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  direction: ltr;
  text-align: right;
}

.pred-trend {
  font-size: 11px;
  color: var(--text-2);
  margin-top: 4px;
}

.pred-range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
  padding: 6px 0;
  border-top: 1px solid var(--border);
  font-size: 10px;
  direction: ltr;
}

.pred-lo { color: var(--down); font-weight: 600; }
.pred-hi { color: var(--up); font-weight: 600; }
.pred-sep { flex: 1; height: 1px; background: var(--border-2); margin: 0 8px; }

/* ═══════════════════════════════════════════════════════════ */
/* SETUP CARDS (for FX Scanner)                                */
/* ═══════════════════════════════════════════════════════════ */
.setup-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.2s;
}

.setup-card:hover {
  border-color: var(--accent-border);
  transform: translateY(-1px);
  box-shadow: var(--shadow);
}

.setup-header {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setup-symbol {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
}

.setup-body {
  padding: 10px 12px;
  background: var(--panel-2);
  border-bottom: 1px solid var(--border);
  font-size: 10.5px;
  line-height: 1.7;
}

.setup-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 3px;
}

.setup-label {
  color: var(--text-2);
}

.setup-value {
  color: var(--text);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.setup-reasons {
  padding: 8px 12px;
  font-size: 10px;
  color: var(--text-2);
  flex-grow: 1;
}

.setup-reason-item {
  margin-bottom: 3px;
  padding-right: 4px;
}

.setup-reason-item.good { color: var(--up); }
.setup-reason-item.bad { color: var(--warn); }

/* ═══════════════════════════════════════════════════════════ */
/* CURRENCY STRENGTH BAR                                       */
/* ═══════════════════════════════════════════════════════════ */
.strength-bar {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 10px 14px;
  border-radius: var(--radius);
}

.strength-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 5px;
  font-size: 11px;
}

.strength-currency {
  font-weight: 700;
  color: var(--text);
}

.strength-name {
  font-size: 9px;
  color: var(--text-2);
  font-weight: normal;
}

.strength-score {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.strength-progress {
  background: var(--border);
  height: 5px;
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 6px;
}

.strength-progress-fill {
  height: 100%;
  transition: width 0.3s;
}

.strength-momentum {
  display: flex;
  justify-content: space-between;
  font-size: 9px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

/* ═══════════════════════════════════════════════════════════ */
/* SPACING UTILITIES                                           */
/* ═══════════════════════════════════════════════════════════ */
.mt-4 { margin-top: 4px; }
.mt-8 { margin-top: 8px; }
.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.mb-4 { margin-bottom: 4px; }
.mb-8 { margin-bottom: 8px; }
.mb-12 { margin-bottom: 12px; }
.mb-16 { margin-bottom: 16px; }

/* ═══════════════════════════════════════════════════════════ */
/* LOADING STATE                                               */
/* ═══════════════════════════════════════════════════════════ */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  color: var(--muted);
  font-size: 11px;
}

.loading::before {
  content: "";
  width: 12px;
  height: 12px;
  border: 2px solid var(--border-2);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-left: 8px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ═══════════════════════════════════════════════════════════ */
/* RESPONSIVE                                                  */
/* ═══════════════════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .grid-6, .kpi-grid { grid-template-columns: repeat(3, 1fr); }
  .grid-4, .grid-5 { grid-template-columns: repeat(2, 1fr); }
  .col-3-1, .col-1-3, .col-2-1 { grid-template-columns: 1fr; }
}

@media (max-width: 700px) {
  .topnav-brand span { display: none; }
  .grid-3, .grid-2 { grid-template-columns: 1fr; }
  .grid-6, .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .main-container { padding: 8px; }
}


/* ═══════════════════════════════════════════════════════════ */
/* PHASE 2: HEATMAP, WATCHLIST & MODALS                        */
/* ═══════════════════════════════════════════════════════════ */

/* Heatmap Grid */
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 4px;
}

.heatmap-tile {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 10px;
  text-align: center;
  transition: transform 0.15s, border-color 0.15s;
  cursor: pointer;
}

.heatmap-tile:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
}

.heatmap-sym {
  font-weight: 700;
  font-size: 11.5px;
  color: var(--text);
  margin-bottom: 2px;
}

.heatmap-ret {
  font-size: 13px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  border-radius: 3px;
  padding: 2px 4px;
  display: inline-block;
  margin-top: 2px;
}

/* Watchlist Star Button */
.star-btn {
  background: transparent;
  border: none;
  color: var(--muted);
  cursor: pointer;
  font-size: 13px;
  padding: 0 4px;
  transition: color 0.15s, transform 0.15s;
}

.star-btn:hover {
  transform: scale(1.2);
  color: var(--warn);
}

.star-btn.starred {
  color: var(--warn) !important;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.filter-group {
  display: flex;
  gap: 4px;
  align-items: center;
}


/* ═══════════════════════════════════════════════════════════ */
/* PHASE 4: CANDLESTICK CHART MODAL & PRICE ACTION ENGINE      */
/* ═══════════════════════════════════════════════════════════ */
.modal-backdrop {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(5, 7, 10, 0.85);
  backdrop-filter: blur(4px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: modalFadeIn 0.15s ease-out;
}

@keyframes modalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-box {
  background: var(--panel);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 960px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 12px 36px rgba(0,0,0,0.6);
  overflow: hidden;
}

.modal-header {
  padding: 12px 18px;
  border-bottom: 1px solid var(--border);
  background: var(--panel-2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-close-btn {
  background: transparent;
  border: none;
  color: var(--muted);
  font-size: 20px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
  transition: color 0.15s;
}

.modal-close-btn:hover {
  color: var(--down);
}

.modal-body {
  padding: 14px 18px;
  overflow-y: auto;
}

.modal-price-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--panel-2);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: var(--radius);
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 11px;
}

.candlestick-canvas-wrapper {
  position: relative;
  width: 100%;
  height: 380px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 12px;
}

.candlestick-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.level-legend-bar {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 10px;
  color: var(--text-2);
  background: var(--panel-2);
  padding: 8px 12px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.legend-line-sample {
  width: 14px;
  height: 2px;
  display: inline-block;
}
