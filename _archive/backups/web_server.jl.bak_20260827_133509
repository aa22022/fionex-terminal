function update_data!()
    println("\n========== UPDATE START (LOCAL ASSEMBLY) ==========")
    t_start = time()

    # فاز ۱: تعریف متغیرهای موقت محلی خارج از محیط قفل جهت دریافت امن داده‌ها بدون مسدود کردن ترد اصلی
    local_data = nothing
    local_analysis = nothing
    local_prediction = nothing
    local_backtest = nothing
    local_sentiment = nothing
    local_relationship_map = nothing
    local_fx_scan = nothing
    local_portfolio_risk = nothing

    # بازخوانی زمان آخرین محاسبات تحت قفل به صورت فوق سریع
    last_sentiment_cached, last_backtest_cached = lock(STATE_LOCK) do
        (STATE.last_sentiment, STATE.last_backtest)
    end

    try
        # دریافت داده‌های پایه از وب‌سرویس‌های خارجی
        println("  [1/10] fetch data...")
        local_data = fetch_all_data(1100)

        println("  [2/10] macro data...")
        macrodata = fetch_macro_data(180)
        local_data["macro"] = macrodata
        println("       DXY=$(round(macrodata["dxy"]["current"], digits=2)) | US10Y=$(round(macrodata["us10y"]["current"], digits=2)) | VIX=$(round(macrodata["vix"]["current"], digits=2))")

        println("  [3/10] calendar events...")
        events = fetch_upcoming_events(14)
        local_data["events"] = events
        println("       events=$(length(events))")

        println("  [4/10] news sentiment analysis...")
        if last_sentiment_cached == DateTime(2000,1,1) || (now() - last_sentiment_cached) > Minute(30)
            try
                local_sentiment = fetch_news_sentiment(24)
                last_sentiment_cached = now()
                if local_sentiment !== nothing
                    println("       news_score=$(local_sentiment.overall_score) | level=$(local_sentiment.alert_level) | items=$(length(local_sentiment.news_items))")
                else
                    println("       no news sentiment available")
                end
            catch e
                @error "       news analysis error: $e"
                local_sentiment = nothing
            end
        else
            println("       using sentiment cache")
            local_sentiment = lock(STATE_LOCK) do STATE.sentiment end
        end
        local_data["sentiment"] = local_sentiment

        println("  [5/10] cross-market relationships...")
        try
            others = Dict{String,Vector{Float64}}()
            others["usd"] = local_data["usd_irr"]["prices"]
            for c in local_data["currencies"]
                length(c.prices) >= 20 && (others[c.symbol] = c.prices)
            end
            macrod = get(local_data, "macro", Dict())
            if haskey(macrod, "dxy") && haskey(macrod["dxy"], "prices")
                others["DXY"] = macrod["dxy"]["prices"]
            end
            if haskey(macrod, "vix") && haskey(macrod["vix"], "prices")
                others["VIX"] = macrod["vix"]["prices"]
            end
            control = get(others, "usd", nothing)
            local_relationship_map = compute_relationships(
                "gold",
                local_data["gold_oz"]["prices"],
                others;
                control_series = control
            )
            println("       relationships=$(length(local_relationship_map.relations)) | leading=$(length(local_relationship_map.leading_assets)) | lagging=$(length(local_relationship_map.lagging_assets))")
        catch e
            @error "       relationship calculation error: $e"
            local_relationship_map = nothing
        end

        println("  [6/10] FX Strength & Multi-Pair Scanning...")
        try
            rates_dict = Dict{String, Vector{Float64}}()
            usd_rates = Dict{String, Vector{Float64}}()
            for c in local_data["currencies"]
                usd_rates[c.symbol] = c.prices
            end
            usd_rates["USD"] = fill(1.0, length(local_data["gold_oz"]["prices"]))
            
            # همگام‌سازی بلادرنگ داده‌های کریپتو به لایه رتبه‌بندی قدرت
            if haskey(local_data, "btc")
                usd_rates["BTC"] = local_data["btc"]["prices"]
            end
            if haskey(local_data, "eth")
                usd_rates["ETH"] = local_data["eth"]["prices"]
            end
            if haskey(local_data, "sol")
                usd_rates["SOL"] = local_data["sol"]["prices"]
            end
            usd_rates["USDT"] = fill(1.0, length(local_data["gold_oz"]["prices"]))

            for pair in MarketRegistry.ALL_FX_PAIRS
                if pair.category == "crypto"
                    key_lc = lowercase(pair.base)
                    if haskey(local_data, key_lc)
                        rates_dict[pair.symbol] = local_data[key_lc]["prices"]
                    end
                elseif haskey(usd_rates, pair.base) && haskey(usd_rates, pair.quote_)
                    b_prices = usd_rates[pair.base]
                    q_prices = usd_rates[pair.quote_]
                    n_len = min(length(b_prices), length(q_prices))
                    pair_prices = [q_prices[end-n_len+i] / b_prices[end-n_len+i] for i in 1:n_len]
                    rates_dict[pair.symbol] = pair_prices
                end
            end

            ccys = collect(keys(MarketRegistry.CURRENCY_NAMES))
            ccys = filter(c -> c != "IRR" && haskey(usd_rates, c), ccys)
            strengths = compute_all_strengths(rates_dict, MarketRegistry.BASE_PAIRS_MAP, ccys)

            setups = scan_all_pairs(MarketRegistry.ALL_FX_PAIRS, rates_dict, strengths)
            report_text = generate_daily_report(setups, strengths)

            try
                TradeJournal.record_setups!(setups)
                TradeJournal.evaluate_active_signals!(rates_dict, local_data["gold_oz"]["dates"])
            catch je
                @error "       Journal tracking error: $je"
            end

            try
                local_portfolio_risk = PortfolioRisk.evaluate_portfolio_risk(setups, rates_dict; account_balance=1000.0, max_portfolio_risk_pct=5.0)
                println("       portfolio_risk: health=$(local_portfolio_risk.portfolio_health) | risk_level=\$$(local_portfolio_risk.total_risk_usd)")
            catch pe
                @error "       Portfolio risk processing error: $pe"
                local_portfolio_risk = nothing
            end

            local_fx_scan = Dict(
                "computed_at" => string(Dates.now())[1:19],
                "rates_dict"  => rates_dict,
                "strengths"   => strengths,
                "setups"      => setups,
                "report"      => report_text
            )
            println("       ranked_ccys=$(length(ccys)) | setups_scanned=$(length(setups))")
        catch e
            @error "       FX Scan Core error: $e"
            local_fx_scan = nothing
        end

        println("  [7/10] multi-engine quantitative forecasting...")
        local_analysis = calculate_all_ratios(local_data)
        local_prediction = predict_next_week(local_data, local_analysis)
        println("       forecast output gold=$(round(local_prediction.gold_oz_point, digits=1)) | usd_irr=$(round(local_prediction.usd_irr_point, digits=0))")

        println("  [8/10] historical predictive backtest check...")
        if last_backtest_cached == DateTime(2000,1,1) || (now() - last_backtest_cached) > Hour(6)
            try
                local_backtest = run_historical_backtest(
                    local_data["gold_oz"]["prices"], local_data["gold_oz"]["dates"],
                    local_data["usd_irr"]["prices"], local_data["usd_irr"]["dates"],
                    local_data["iran_gold"]["prices"], local_data["iran_gold"]["dates"];
                    test_days=240, min_train=30
                )
                last_backtest_cached = now()
                println("       backtest MAPE -> gold=$(round(local_backtest.gold_mape, digits=2))% | usd=$(round(local_backtest.usd_mape, digits=2))%")
            catch e
                @error "       backtesting error: $e"
                local_backtest = nothing
            end
        else
            println("       using cached backtest suite")
            local_backtest = lock(STATE_LOCK) do STATE.backtest end
        end

        println("  [9/10] persisting records inside SQLite database...")
        try
            save_actual_snapshot!(local_data, local_analysis)
            save_prediction_run!(local_prediction)
            println("       sqlite commit complete")
        catch e
            @error "       sqlite persistence failure: $e"
        end

        # فاز ۲: تعویض ایمن رفرنس‌های سراسری تحت لایه محافظتی قفل
        lock(STATE_LOCK) do
            STATE.data = local_data
            STATE.analysis = local_analysis
            STATE.prediction = local_prediction
            STATE.backtest = local_backtest
            STATE.sentiment = local_sentiment
            STATE.relationship_map = local_relationship_map
            STATE.fx_scan = local_fx_scan
            STATE.portfolio_risk = local_portfolio_risk
            STATE.last_sentiment = last_sentiment_cached
            STATE.last_backtest = last_backtest_cached
            STATE.last_update = now()
        end

        println("========== LOCAL ASSEMBLY COMPLETED IN ($(round(time() - t_start, digits=1))s) ==========\n")

    catch e
        @error "CRITICAL CORE DATA COMPILATION FAILURE" exception=(e, catch_backtrace())
    end
end

function ensure_data()
    # تکنیک بررسی دوجانبه قفل (Double-Checked Locking Pattern) جهت راندمان بالا
    need_update = false
    lock(STATE_LOCK) do
        need_update = (STATE.data === nothing || (now() - STATE.last_update) > Minute(30))
    end

    if need_update
        is_already_updating = false
        lock(STATE_LOCK) do
            if IS_UPDATING[]
                is_already_updating = true
            else
                IS_UPDATING[] = true
            end
        end

        if is_already_updating
            # اگر ترد دیگری در حال اجرای محاسبات آپدیت باشد، ترد فعلی منتظر باز شدن وضعیت می‌ماند
            while true
                sleep(0.1)
                lock(STATE_LOCK) do
                    is_already_updating = IS_UPDATING[]
                end
                if !is_already_updating
                    break
                end
            end
        else
            try
                update_data!()
            finally
                lock(STATE_LOCK) do
                    IS_UPDATING[] = false
                end
            end
        end
    end
end

# ------------------------------------------------------------
# File serving with Strict Security (Anti-Path-Traversal)
# ------------------------------------------------------------

function read_template_file(filename::String)
    # تضمین غیرقابل نفوذ بودن مسیر فایل قالب‌ها
    target_path = abspath(joinpath(TEMPLATES_DIR, filename))
    if startswith(target_path, TEMPLATES_DIR) && isfile(target_path)
        return read(target_path)
    end
    @warn "Security Warning: Blocked access attempt to template file outside designated directory: $filename"
    return UInt8[]
end

function handle_index(req)
    body_data = read_template_file("index.html")
    if isempty(body_data)
        return HTTP.Response(404, ["Content-Type" => "text/plain; charset=utf-8"], body="قالب مورد نظر یافت نشد.")
    end
    return HTTP.Response(
        200,
        [
            "Content-Type" => "text/html; charset=utf-8",
            "Cache-Control" => "no-store, no-cache, must-revalidate, max-age=0",
            "Pragma" => "no-cache"
        ],
        body = body_data
    )
end

function handle_static_file(path::String)
    # پاک‌سازی و مسطح‌سازی پارامترهای آدرس static
    rel_file = replace(path, "/static/" => "")
    rel_file = replace(rel_file, "\\" => "/") # هماهنگ‌سازی آدرس‌های ویندوز
    
    target_path = abspath(joinpath(STATIC_DIR, rel_file))
    
    # تأیید قطعی عدم خروج مسیر نسبی از ایزولاسیون پوشه static
    if startswith(target_path, STATIC_DIR) && isfile(target_path)
        ctype = endswith(target_path, ".css") ? "text/css; charset=utf-8" :
                endswith(target_path, ".js")  ? "application/javascript; charset=utf-8" :
                endswith(target_path, ".png") ? "image/png" :
                endswith(target_path, ".svg") ? "image/svg+xml" : "application/octet-stream"
        try
            return HTTP.Response(
                200, 
                [
                    "Content-Type" => ctype, 
                    "Cache-Control" => "public, max-age=31536000",
                    "Access-Control-Allow-Origin" => "*"
                ], 
                body=read(target_path)
            )
        catch e
            return HTTP.Response(500, ["Content-Type" => "text/plain"], body="Internal Server Error")
        end
    else
        @warn "Security Block: Directory traversal attempt detected on request: $path"
        return HTTP.Response(403, ["Content-Type" => "text/plain; charset=utf-8"], body="دسترسی غیرمجاز: مسیر درخواستی خارج از پوشه عمومی است.")
    end
end

# ------------------------------------------------------------
# Secure Rate Limiter
# ------------------------------------------------------------

function get_client_ip(req::HTTP.Request)
    forwarded = HTTP.header(req, "X-Forwarded-For")
    if !isempty(forwarded)
        return String(split(forwarded, ",")[1])
    end
    return "127.0.0.1"
end

function is_rate_limited(ip::String, max_requests::Int, window_seconds::Float64)
    lock(RATE_LIMIT_LOCK) do
        current_time = time()
        timestamps = get!(IP_REQUESTS, ip, Float64[])
        # فیلتر کردن رکوردهای خارج از بازه زمانی تعریف شده
        filter!(t -> current_time - t < window_seconds, timestamps)
        if length(timestamps) >= max_requests
            return true
        end
        push!(timestamps, current_time)
        return false
    end
end

