# ------------------------------------------------------------

function handle_api(req)
    try
        ensure_data()
        resp = build_api_response()
        resp = clean_json_value(resp)

        return HTTP.Response(
            200,
            [
                "Content-Type" => "application/json; charset=utf-8",
                "Access-Control-Allow-Origin" => "*",
                "Cache-Control" => "no-store, no-cache, must-revalidate, max-age=0",
                "Pragma" => "no-cache"
            ],
            body = JSON3.write(resp)
        )
    catch e
        @error "API response build error" exception=(e, catch_backtrace())
        return HTTP.Response(
            500,
            ["Content-Type" => "application/json; charset=utf-8"],
            body = JSON3.write(Dict("status" => "error", "message" => "خطای سرور: محاسبات ریاضی با لودینگ متناقص روبرو شد."))
        )
    end
end

function handle_refresh(req)
    try
        # اجرای غیرمسدودکننده فرآیند به‌روزرسانی سراسری دیتابیس
        update_data!()
        return HTTP.Response(
            200,
            ["Content-Type" => "application/json; charset=utf-8"],
            body = JSON3.write(Dict("status" => "success", "message" => "به‌روزرسانی همگام کدهای بازار انجام پذیرفت."))
        )
    catch e
        return HTTP.Response(
            500,
            ["Content-Type" => "application/json; charset=utf-8"],
            body = JSON3.write(Dict("status" => "error", "message" => string(e)))
        )
    end
end

function handle_backtest_range(req)
    try
        ensure_data()
        uri = HTTP.URI(req.target)
        params = HTTP.queryparams(uri)
        test_days = try parse(Int, get(params, "days", "20")) catch; 20 end
        test_days = clamp(test_days, 5, 5000)
        
        # دسترسی کاملاً ایمن و تردسیف به کپی متغیرهای سراسری
        d = lock(STATE_LOCK) do
            STATE.data
        end

        if d === nothing
            return HTTP.Response(503, 
                ["Content-Type" => "application/json; charset=utf-8"],
                body = JSON3.write(Dict("status" => "error", "message" => "سیستم هنوز آماده دریافت دستور بک‌تست نیست. لطفا چند ثانیه صبر کنید."))
            )
        end
        
        bt = run_historical_backtest(
            d["gold_oz"]["prices"], d["gold_oz"]["dates"],
            d["usd_irr"]["prices"], d["usd_irr"]["dates"],
            d["iran_gold"]["prices"], d["iran_gold"]["dates"];
            test_days=test_days, min_train=30
        )
        
        bt_gold = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.gold_results]
        bt_usd = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.usd_results]
        bt_iran = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.iran_results]
        
        resp = Dict(
            "status" => "success",
            "test_days" => bt.total_days,
            "gold_mape" => round(bt.gold_mape, digits=2),
            "usd_mape" => round(bt.usd_mape, digits=2),
            "iran_mape" => round(bt.iran_mape, digits=2),
            "gold_direction" => round(bt.gold_direction_accuracy, digits=1),
            "usd_direction" => round(bt.usd_direction_accuracy, digits=1),
            "iran_direction" => round(bt.iran_direction_accuracy, digits=1),
            "info" => bt.info,
            "gold" => bt_gold,
            "usd" => bt_usd,
            "iran" => bt_iran
        )
        
        return HTTP.Response(200,
            ["Content-Type" => "application/json; charset=utf-8",
             "Access-Control-Allow-Origin" => "*"],
            body=JSON3.write(clean_json_value(resp))
        )
    catch e
        @error "Backtest API computation failure" exception=(e, catch_backtrace())
        return HTTP.Response(500,
            ["Content-Type" => "application/json; charset=utf-8"],
            body=JSON3.write(Dict("status" => "error", "message" => string(e)))
        )
    end
end

# ------------------------------------------------------------
# Router
# ------------------------------------------------------------

function router(req::HTTP.Request)
    path = HTTP.URI(req.target).path

    # ۱. هندلر سلامت سیستم (Health Check Endpoint) جهت استفاده از مانیتورینگ خودکار
    if path == "/health"
        is_stale, last_up = lock(STATE_LOCK) do
            ((STATE.data === nothing || (now() - STATE.last_update) > Hour(1)), STATE.last_update)
        end
        health_status = Dict(
            "status" => is_stale ? "degraded" : "healthy",
            "uptime_stamp" => string(now()),
            "last_database_update" => string(last_up),
            "julia_runtime" => "v" * string(VERSION)
        )
        return HTTP.Response(200, ["Content-Type" => "application/json; charset=utf-8"], body=JSON3.write(health_status))
    end

    # ۲. مسیردهی قالب اصلی پورتال
    if path == "/" || path == "/index.html"
        return handle_index(req)
    
    # ۳. مسیردهی امن فایلهای استاتیک با مکانیزم ضد هک مسیر نفوذ
    elseif startswith(path, "/static/")
        return handle_static_file(path)
    
    # ۴. مسیرهای API های محاسباتی با لایه دفاعی Rate Limiter
    elseif path == "/api/data"
        return handle_api(req)
        
    elseif path == "/api/refresh"
        client_ip = get_client_ip(req)
        if is_rate_limited(client_ip, 2, 60.0) # محدودیت حداکثر ۲ درخواست در دقیقه برای متد سنگین آپدیت کلی دیتابیس
            return HTTP.Response(429, 
                ["Content-Type" => "application/json; charset=utf-8"], 
                body=JSON3.write(Dict("status" => "error", "message" => "تعداد به‌روزرسانی بیش از حد مجاز است. لطفا ۶۰ ثانیه دیگر شکیبا باشید."))
            )
        end
        return handle_refresh(req)
        
    elseif startswith(path, "/api/backtest")
        client_ip = get_client_ip(req)
        if is_rate_limited(client_ip, 5, 60.0) # محدودیت حداکثر ۵ درخواست در دقیقه برای متدهای سنگین پردازشی بک‌تست تاریخی
            return HTTP.Response(429, 
                ["Content-Type" => "application/json; charset=utf-8"], 
                body=JSON3.write(Dict("status" => "error", "message" => "سرور تحت فشار محاسباتی است. لطفا لحظاتی دیگر تلاش کنید."))
            )
        end
        return handle_backtest_range(req)
    else
        return HTTP.Response(404, ["Content-Type" => "text/plain; charset=utf-8"], body="آدرس درخواستی در سامانه یافت نشد.")
    end
end

