# ------------------------------------------------------------
# Text / JSON safety helpers
# ------------------------------------------------------------

function looks_mojibake(s::AbstractString)
    return occursin("Ãƒ", s) || occursin("Ã˜", s) || occursin("Ã™", s) ||
           occursin("Ã‚", s) || occursin("Ã¢", s)
end

function repair_once_string(s::AbstractString)
    txt = String(s)
    bytes = UInt8[]
    for ch in txt
        v = Int(ch)
        if v > 255
            return txt
        end
        push!(bytes, UInt8(v))
    end
    try
        return String(bytes)
    catch
        return txt
    end
end

function fix_mojibake_string(s::AbstractString)
    txt = String(s)
    if !looks_mojibake(txt)
        return txt
    end
    best = txt
    for _ in 1:3
        fixed = repair_once_string(best)
        if fixed == best
            break
        end
        best = fixed
        if !looks_mojibake(best)
            break
        end
    end
    return best
end

function clean_json_value(x)
    if x isa AbstractFloat
        return isfinite(x) ? x : nothing
    elseif x isa AbstractString
        return fix_mojibake_string(x)
    elseif x isa Dict
        return Dict(k => clean_json_value(v) for (k, v) in x)
    elseif x isa AbstractVector
        return [clean_json_value(v) for v in x]
    else
        return x
    end
end

