    Storage.init_db()
    
    println("\n=======================================================")
    println("  Gold Forecast System v5.0 (Thread-Safe Framework)")
    println("=======================================================")
    println("  Web Engine Interface: Running on Web Standard port")
    println("  Dashboard Address: http://localhost:$port")
    println("  Monitoring Check:  http://localhost:$port/health")
    println("=======================================================\n")
    
    # همگام‌سازی خطایاب در اولین لودینگ همزمان با بوت شدن سرور بدون بلاک کردن اجرای لایه HTTP
    println("Running early stage startup diagnostics & data sync...")
