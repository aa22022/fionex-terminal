function build_market_alert(data::Union{Dict,Nothing})
    data === nothing && return Dict("level" => "UNKNOWN", "message" => "--", "gold_move" => 0.0, "usd_move" => 0.0)
    try
        gp = data["gold_oz"]["prices"]
        up = data["usd_irr"]["prices"]

        gmove = length(gp) >= 2 ? abs(gp[end] - gp[end-1]) / gp[end-1] * 100 : 0.0
        umove = length(up) >= 2 ? abs(up[end] - up[end-1]) / up[end-1] * 100 : 0.0
        maxmove = max(gmove, umove)

        if maxmove > 2.0
            return Dict(
                "level" => "HIGH",
                "message" => "بازار پرنوسان - پیش‌بینی با احتیاط",
                "gold_move" => round(gmove, digits=2),
                "usd_move" => round(umove, digits=2)
            )
        elseif maxmove > 1.0
            return Dict(
                "level" => "MEDIUM",
                "message" => "نوسان متوسط در بازار",
                "gold_move" => round(gmove, digits=2),
                "usd_move" => round(umove, digits=2)
            )
        else
            return Dict(
                "level" => "LOW",
                "message" => "نوسان بازار در بازه عادی و آرام",
                "gold_move" => round(gmove, digits=2),
                "usd_move" => round(umove, digits=2)
            )
        end
    catch
        return Dict(
            "level" => "UNKNOWN",
            "message" => "--",
            "gold_move" => 0.0,
            "usd_move" => 0.0
        )
    end
end

