function update_data!()
    println("\n========== UPDATE ==========")
    t = time()

    STATE.data = fetch_all_data(1100)

    println("  [6/10] macro data...")
    macrodata = fetch_macro_data(180)
    STATE.data["macro"] = macrodata
    println("       DXY=$(round(macrodata["dxy"]["current"], digits=2)) | US10Y=$(round(macrodata["us10y"]["current"], digits=2)) | VIX=$(round(macrodata["vix"]["current"], digits=2))")

    println("  [7/10] events...")
    events = fetch_upcoming_events(14)
    STATE.data["events"] = events
    println("       events=$(length(events))")

    println("  [8/10] news sentiment...")
    if STATE.sentiment === nothing || (now() - STATE.last_sentiment) > Minute(30)
        try
            STATE.sentiment = fetch_news_sentiment(24)
            STATE.last_sentiment = now()
            if STATE.sentiment !== nothing
                println("       news_score=$(STATE.sentiment.overall_score) | level=$(STATE.sentiment.alert_level) | items=$(length(STATE.sentiment.news_items))")
            else
                println("       no news sentiment available")
            end
        catch e
            println("       news error: $e")
            STATE.sentiment = nothing
        end
    else
        println("       using sentiment cache")
    end

    STATE.data["sentiment"] = STATE.sentiment

    println("  [8b/10] relationship analysis...")
    relationship_map = try
        others = Dict{String,Vector{Float64}}()
        others["usd"] = STATE.data["usd_irr"]["prices"]
        for c in STATE.data["currencies"]
            length(c.prices) >= 20 && (others[c.symbol] = c.prices)
        end
        macrod = get(STATE.data, "macro", Dict())
        if haskey(macrod, "dxy") && haskey(macrod["dxy"], "prices")
            others["DXY"] = macrod["dxy"]["prices"]
        end
        if haskey(macrod, "vix") && haskey(macrod["vix"], "prices")
            others["VIX"] = macrod["vix"]["prices"]
        end
        control = get(others, "usd", nothing)
        rel = compute_relationships(
            "gold",
            STATE.data["gold_oz"]["prices"],
            others;
            control_series = control
        )
        println("       relationships=$(length(rel.relations)) | leading=$(length(rel.leading_assets)) | lagging=$(length(rel.lagging_assets))")
        rel
    catch e
        println("       relationship error: $e")
        nothing
    end
    STATE.relationship_map = relationship_map

    println("  [8c/10] FX Strength & Pair Scanning...")
    try
        rates_dict = Dict{String, Vector{Float64}}()

        usd_rates = Dict{String, Vector{Float64}}()
        for c in STATE.data["currencies"]
            usd_rates[c.symbol] = c.prices
        end
        usd_rates["USD"] = fill(1.0, length(STATE.data["gold_oz"]["prices"]))
        
        # تزریق زنده قیمت‌های کریپتو به لایه رتبه‌بندی قدرت
        if haskey(STATE.data, "btc")
            usd_rates["BTC"] = STATE.data["btc"]["prices"]
        end
        if haskey(STATE.data, "eth")
            usd_rates["ETH"] = STATE.data["eth"]["prices"]
        end
        if haskey(STATE.data, "sol")
            usd_rates["SOL"] = STATE.data["sol"]["prices"]
        end
        usd_rates["USDT"] = fill(1.0, length(STATE.data["gold_oz"]["prices"]))

        for pair in MarketRegistry.ALL_FX_PAIRS
            if pair.category == "crypto"
                key_lc = lowercase(pair.base)
                if haskey(STATE.data, key_lc)
                    rates_dict[pair.symbol] = STATE.data[key_lc]["prices"]
                end
            elseif haskey(usd_rates, pair.base) && haskey(usd_rates, pair.quote_)
                b_prices = usd_rates[pair.base]
                q_prices = usd_rates[pair.quote_]
                n_len = min(length(b_prices), length(q_prices))
                pair_prices = [q_prices[end-n_len+i] / b_prices[end-n_len+i] for i in 1:n_len]
                rates_dict[pair.symbol] = pair_prices
            end
        end

        ccys = collect(keys(MarketRegistry.CURRENCY_NAMES))
        ccys = filter(c -> c != "IRR" && haskey(usd_rates, c), ccys)
        strengths = compute_all_strengths(rates_dict, MarketRegistry.BASE_PAIRS_MAP, ccys)

        setups = scan_all_pairs(MarketRegistry.ALL_FX_PAIRS, rates_dict, strengths)
        report_text = generate_daily_report(setups, strengths)

        # 1. Trade Journal
        try
            TradeJournal.record_setups!(setups)
            TradeJournal.evaluate_active_signals!(rates_dict, STATE.data["gold_oz"]["dates"])
        catch je
            println("       Journal record error: $je")
        end

        # 2. Portfolio Risk Assessment
        try
            STATE.portfolio_risk = PortfolioRisk.evaluate_portfolio_risk(setups, rates_dict; account_balance=1000.0, max_portfolio_risk_pct=5.0)
            println("       portfolio_risk: health=$(STATE.portfolio_risk.portfolio_health) | alerts=$(length(STATE.portfolio_risk.correlation_alerts)) | total_risk=\$$(STATE.portfolio_risk.total_risk_usd)")
        catch pe
            println("       Portfolio risk error: $pe")
            STATE.portfolio_risk = nothing
        end

        STATE.fx_scan = Dict(
            "computed_at" => string(Dates.now())[1:19],
            "rates_dict"  => rates_dict,
            "strengths"   => strengths,
            "setups"      => setups,
            "report"      => report_text
        )
        println("       currencies_ranked=$(length(ccys)) | scanned_pairs=$(length(setups)) | tradable_A_B=$(length(filter(s->s.trade_quality in ["A+","A","B"], setups)))")
    catch e
        println("       FX Scan error: $e")
        STATE.fx_scan = nothing
    end

    println("  [9/10] forecast...")
    STATE.analysis = calculate_all_ratios(STATE.data)
    STATE.prediction = predict_next_week(STATE.data, STATE.analysis)
    println("       gold=$(round(STATE.prediction.gold_oz_point, digits=2)) | usd=$(round(STATE.prediction.usd_irr_point, digits=0)) | iran18=$(round(STATE.prediction.iran_gold_point, digits=0))")

    println("  [10/10] backtest...")
    if STATE.backtest === nothing || (now() - STATE.last_backtest) > Hour(6)
        try
            STATE.backtest = run_historical_backtest(
                STATE.data["gold_oz"]["prices"], STATE.data["gold_oz"]["dates"],
                STATE.data["usd_irr"]["prices"], STATE.data["usd_irr"]["dates"],
                STATE.data["iran_gold"]["prices"], STATE.data["iran_gold"]["dates"];
                test_days=240, min_train=30
            )
            STATE.last_backtest = now()
            println("       backtest MAPE | gold=$(round(STATE.backtest.gold_mape, digits=2))% | usd=$(round(STATE.backtest.usd_mape, digits=2))% | iran18=$(round(STATE.backtest.iran_mape, digits=2))%")
        catch e
            println("       backtest error: $e")
            STATE.backtest = nothing
        end
    else
        println("       using backtest cache")
    end

    try
        save_actual_snapshot!(STATE.data, STATE.analysis)
        save_prediction_run!(STATE.prediction)
        println("       sqlite saved")
    catch e
        println("       sqlite error: $e")
    end

    STATE.last_update = now()
    println("========== DONE ($(round(time() - t, digits=1))s) ==========\n")
end

function ensure_data()
    if STATE.data === nothing || (now() - STATE.last_update) > Minute(30)
        update_data!()
    end
end

