function read_file(path::String)
    full = joinpath(@__DIR__, "..", path)
    return isfile(full) ? read(full) : UInt8[]
end

function handle_index(req)
    return HTTP.Response(
        200,
        [
            "Content-Type" => "text/html; charset=utf-8",
            "Cache-Control" => "no-store, no-cache, must-revalidate, max-age=0",
            "Pragma" => "no-cache"
        ],
        body = read_file("templates/index.html")
    )
end

function handle_css(req)
    return HTTP.Response(
        200,
        [
            "Content-Type" => "text/css; charset=utf-8",
            "Cache-Control" => "no-store, no-cache, must-revalidate, max-age=0",
            "Pragma" => "no-cache"
        ],
        body = read_file("static/style.css")
    )
end

