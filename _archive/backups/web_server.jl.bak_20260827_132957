# ------------------------------------------------------------
# API handlers
# ------------------------------------------------------------

function handle_api(req)
    try
        ensure_data()
        resp = build_api_response()
        resp = clean_json_value(resp)

        return HTTP.Response(
            200,
            [
                "Content-Type" => "application/json; charset=utf-8",
                "Access-Control-Allow-Origin" => "*",
                "Cache-Control" => "no-store, no-cache, must-revalidate, max-age=0",
                "Pragma" => "no-cache"
            ],
            body = JSON3.write(resp)
        )
    catch e
        @error "API error" exception=(e, catch_backtrace())
        return HTTP.Response(
            500,
            ["Content-Type" => "application/json"],
            body = JSON3.write(Dict("status" => "error", "message" => string(e)))
        )
    end
end

function handle_refresh(req)
    try
        update_data!()
        return HTTP.Response(
            200,
            ["Content-Type" => "application/json"],
            body = JSON3.write(Dict("status" => "success"))
        )
    catch e
        return HTTP.Response(
            500,
            ["Content-Type" => "application/json"],
            body = JSON3.write(Dict("status" => "error", "message" => string(e)))
        )
    end
end

function handle_backtest_range(req)
    try
        ensure_data()
        uri = HTTP.URI(req.target)
        params = HTTP.queryparams(uri)
        test_days = try parse(Int, get(params, "days", "20")) catch; 20 end
        test_days = clamp(test_days, 5, 5000)
        
        d = STATE.data
        bt = run_historical_backtest(
            d["gold_oz"]["prices"], d["gold_oz"]["dates"],
            d["usd_irr"]["prices"], d["usd_irr"]["dates"],
            d["iran_gold"]["prices"], d["iran_gold"]["dates"];
            test_days=test_days, min_train=30
        )
        
        bt_gold = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.gold_results]
        bt_usd = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.usd_results]
        bt_iran = [Dict("date"=>r.date,"actual"=>r.actual,"predicted"=>r.predicted,"error"=>r.error_pct) for r in bt.iran_results]
        
        resp = Dict(
            "status" => "success",
            "test_days" => bt.total_days,
            "gold_mape" => round(bt.gold_mape, digits=2),
            "usd_mape" => round(bt.usd_mape, digits=2),
            "iran_mape" => round(bt.iran_mape, digits=2),
            "gold_direction" => round(bt.gold_direction_accuracy, digits=1),
            "usd_direction" => round(bt.usd_direction_accuracy, digits=1),
            "iran_direction" => round(bt.iran_direction_accuracy, digits=1),
            "info" => bt.info,
            "gold" => bt_gold,
            "usd" => bt_usd,
            "iran" => bt_iran
        )
        
        return HTTP.Response(200,
            ["Content-Type"=>"application/json; charset=utf-8",
             "Access-Control-Allow-Origin"=>"*"],
            body=JSON3.write(clean_json_value(resp))
        )
    catch e
        @error "Backtest API error" exception=(e, catch_backtrace())
        return HTTP.Response(500,
            ["Content-Type"=>"application/json"],
            body=JSON3.write(Dict("status"=>"error","message"=>string(e)))
        )
    end
end

# ------------------------------------------------------------
# Router
# ------------------------------------------------------------

function router(req::HTTP.Request)
    path = HTTP.URI(req.target).path
    if path == "/" || path == "/index.html"
        return handle_index(req)
    elseif startswith(path, "/static/")
        rel_file = replace(path, "/static/" => "")
        fpath = joinpath(@__DIR__, "..", "static", rel_file)
        if isfile(fpath)
            ctype = endswith(fpath, ".css") ? "text/css; charset=utf-8" :
                    endswith(fpath, ".js")  ? "application/javascript; charset=utf-8" :
                    endswith(fpath, ".png") ? "image/png" :
                    endswith(fpath, ".svg") ? "image/svg+xml" : "application/octet-stream"
            return HTTP.Response(200, ["Content-Type" => ctype, "Cache-Control" => "no-store"], body=read(fpath))
        else
            return HTTP.Response(404, "Static file not found: $rel_file")
        end
    elseif path == "/api/data"
        return handle_api(req)
    elseif path == "/api/refresh"
        return handle_refresh(req)
    elseif startswith(path, "/api/backtest")
        return handle_backtest_range(req)
    else
        return HTTP.Response(404, "Not Found")
    end
end

