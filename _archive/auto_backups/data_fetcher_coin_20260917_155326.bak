module DataFetcher

using Dates, Statistics, JSON3, SQLite, DBInterface, HTTP

export fetch_all_data, fetch_upcoming_events, fetch_live_forex_rates, CurrencyData

struct CurrencyData
    symbol::String
    name_fa::String
    prices::Vector{Float64}
    dates::Vector{DateTime}
    latest::Float64
    change_pct::Float64
end

const BROWSER_UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
const DB_PATH = joinpath(@__DIR__, "..", "data", "forecast.db")
const TROY_GRAM = 31.1034768

# ==================================================================
# دریافت خام URL
# ==================================================================
function fetch_raw_url(url::String; timeout::Int=8)::Union{String, Nothing}
    try
        cmd = `curl.exe -4 -s -L -k --connect-timeout $timeout --max-time $(timeout + 5) -H "User-Agent: $BROWSER_UA" -H "Accept-Language: fa-IR,fa;q=0.9,en;q=0.8" $url`
        out = read(cmd, String)
        if length(out) > 100 && !occursin("تعلیق دسترسی", out)
            return out
        end
    catch
    end

    try
        ps_cmd = `powershell.exe -NoProfile -NonInteractive -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; (Invoke-WebRequest -Uri '$url' -UseBasicParsing -TimeoutSec $timeout -Headers @{'User-Agent'='$BROWSER_UA';'Accept-Language'='fa-IR,fa;q=0.9'}).Content"`
        out_ps = read(ps_cmd, String)
        if length(out_ps) > 100 && !occursin("تعلیق دسترسی", out_ps)
            return out_ps
        end
    catch
    end

    return nothing
end

# ==================================================================
# بازیابی آخرین قیمت‌های معتبر دیتابیس
# ==================================================================
function get_last_snapshot_prices()::Dict{String, Float64}
    res = Dict{String, Float64}("gold_oz" => 0.0, "usd_irr" => 0.0, "iran_gold" => 0.0)
    try
        if isfile(DB_PATH)
            db = SQLite.DB(DB_PATH)
            rows = DBInterface.execute(db, "SELECT gold_oz, usd_irr, iran_gold FROM snapshots WHERE gold_oz > 100 AND usd_irr > 1000 ORDER BY id DESC LIMIT 1")
            if !isnothing(rows) && !isempty(rows)
                r = first(rows)
                g = tryparse(Float64, string(r.gold_oz))
                u = tryparse(Float64, string(r.usd_irr))
                i = tryparse(Float64, string(r.iran_gold))
                g !== nothing && g > 0.0 && (res["gold_oz"] = g)
                u !== nothing && u > 0.0 && (res["usd_irr"] = u)
                i !== nothing && i > 0.0 && (res["iran_gold"] = i)
            end
        end
    catch
    end
    return res
end

# ==================================================================
# پارسر جدید TGJU - استخراج از id="l-KEY" و info-price
# ==================================================================
function extract_tgju_live_price(html::String, row_key::String)::Float64
    # الگوی جدید: <li id="l-KEY" ...> ... <span class="info-price">XXX,XXX</span>
    pattern = Regex("<li\\s+id=\"l-$row_key\"[^>]*>.*?<span\\s+class=\"info-price\">\\s*([0-9,.]+)\\s*</span>", "s")
    m = match(pattern, html)

    # پشتیبانی از quote تک
    if m === nothing
        pattern2 = Regex("<li\\s+id='l-$row_key'[^>]*>.*?<span\\s+class=\"info-price\">\\s*([0-9,.]+)\\s*</span>", "s")
        m = match(pattern2, html)
    end

    if m !== nothing
        num_clean = replace(m.captures[1], "," => "")
        val = tryparse(Float64, num_clean)
        return val !== nothing ? val : 0.0
    end
    return 0.0
end

# ==================================================================
# دریافت زنده TGJU
# ==================================================================
function fetch_tgju_live()::Dict{String, Float64}
    res = Dict{String, Float64}()

    html = fetch_raw_url("https://www.tgju.org"; timeout=12)
    html === nothing && return res

    # دلار آزاد (ریال -> تومان)
    usd_rial = extract_tgju_live_price(html, "price_dollar_rl")
    usd_rial <= 0.0 && (usd_rial = extract_tgju_live_price(html, "price_dollar"))
    usd_rial > 0.0 && (res["usd_toman"] = usd_rial / 10.0)

    # طلای ۱۸ عیار (ریال -> تومان)
    g18_rial = extract_tgju_live_price(html, "geram18")
    g18_rial > 0.0 && (res["gold_18k_toman"] = g18_rial / 10.0)

    # انس طلا (دلار بدون تبدیل)
    ons = extract_tgju_live_price(html, "ons")
    ons > 0.0 && (res["gold_oz"] = ons)

    return res
end

# ==================================================================
# دریافت آمار زنده نوبیتکس
# ==================================================================
function fetch_live_nobitex_stats()::Dict{String, Float64}
    res = Dict{String, Float64}()
    urls = ["https://apiv2.nobitex.ir/market/stats", "https://api.nobitex.ir/market/stats"]

    for url in urls
        raw = fetch_raw_url(url; timeout=6)
        raw === nothing && continue
        try
            j = JSON3.read(raw)
            if haskey(j, :stats)
                for (k, v) in pairs(j.stats)
                    if haskey(v, :latest)
                        val = tryparse(Float64, string(v.latest))
                        if val !== nothing && val > 0.0
                            res[lowercase(string(k))] = val
                        end
                    end
                end
                !isempty(res) && return res
            end
        catch
        end
    end
    return res
end

# ==================================================================
# دریافت نرخ زنده فارکس از Frankfurter
# ==================================================================
function fetch_live_forex_rates()::Dict{String, Float64}
    rates = Dict{String, Float64}("USD" => 1.0)
    raw = fetch_raw_url("https://api.frankfurter.app/latest?from=USD&to=EUR,GBP,JPY,CHF,CAD,AUD,NZD,CNY,TRY"; timeout=8)
    raw === nothing && return rates
    try
        j = JSON3.read(raw)
        if haskey(j, :rates)
            for (k, v) in pairs(j.rates)
                sym = uppercase(string(k))
                val = tryparse(Float64, string(v))
                if val !== nothing && val > 0.0
                    rates[sym] = val
                end
            end
        end
    catch
    end
    return rates
end

# ==================================================================
# تاریخچه UDF نوبیتکس
# ==================================================================
function fetch_crypto_udf_history(symbol::String, days::Int, current_time::DateTime)::Tuple{Vector{Float64}, Vector{DateTime}}
    prices = Float64[]
    dates = DateTime[]
    to_ts = Int(round(datetime2unix(current_time)))
    from_ts = Int(round(datetime2unix(current_time - Day(days + 15))))

    urls = [
        "https://apiv2.nobitex.ir/market/udf/history?symbol=$symbol&resolution=D&from=$from_ts&to=$to_ts",
        "https://api.nobitex.ir/market/udf/history?symbol=$symbol&resolution=D&from=$from_ts&to=$to_ts"
    ]

    for url in urls
        raw_nobi = fetch_raw_url(url; timeout=7)
        raw_nobi === nothing && continue
        try
            j = JSON3.read(raw_nobi)
            if haskey(j, :s) && j.s == "ok" && haskey(j, :c) && haskey(j, :t)
                for i in 1:length(j.c)
                    p = tryparse(Float64, string(j.c[i]))
                    p !== nothing && p > 0.0 && push!(prices, p)
                    push!(dates, unix2datetime(Float64(j.t[i])))
                end
                length(prices) > 2 && return prices, dates
            end
        catch
        end
    end
    return prices, dates
end

# ==================================================================
# همگام‌سازی زمانی بدون تولید داده جعلی
# ==================================================================
function align_series_to_dates(
    source_prices::Vector{Float64},
    source_dates::Vector{DateTime},
    target_dates::Vector{DateTime},
    anchor_price::Float64
)::Vector{Float64}
    n = length(target_dates)
    n == 0 && return Float64[]

    if isempty(source_prices) || all(x -> x <= 0.0, source_prices)
        anchor = anchor_price > 0.0 ? anchor_price : 1.0
        return fill(anchor, n)
    end

    aligned = Float64[]
    for t_dt in target_dates
        idx = findlast(d -> d <= t_dt, source_dates)
        if idx !== nothing
            push!(aligned, source_prices[idx])
        else
            push!(aligned, source_prices[1])
        end
    end

    for i in 1:length(aligned)
        if aligned[i] <= 0.0
            aligned[i] = (i > 1 ? aligned[i-1] : (anchor_price > 0.0 ? anchor_price : 1.0))
        end
    end
    return aligned
end

# ==================================================================
# تجمیع نهایی داده‌ها
# ==================================================================
function fetch_all_data(history_days::Int=180)
    days = clamp(history_days, 60, 365)
    current_time = now()

    tgju_live = fetch_tgju_live()
    nobi_stats = fetch_live_nobitex_stats()
    fx_rates_live = fetch_live_forex_rates()
    db_backup = get_last_snapshot_prices()

    # ---------- دلار ----------
    usd_live_toman = get(tgju_live, "usd_toman", 0.0)
    usd_source = "TGJU"
    if usd_live_toman <= 0.0 && haskey(nobi_stats, "usdt-rls")
        usd_live_toman = nobi_stats["usdt-rls"] / 10.0
        usd_source = "Nobitex"
    end
    if usd_live_toman <= 0.0 && db_backup["usd_irr"] > 0.0
        usd_live_toman = db_backup["usd_irr"]
        usd_source = "Database"
    end

    # ---------- انس ----------
    gold_live_usd = get(tgju_live, "gold_oz", 0.0)
    gold_source = "TGJU"
    if gold_live_usd <= 0.0 && haskey(nobi_stats, "paxg-usdt")
        gold_live_usd = nobi_stats["paxg-usdt"]
        gold_source = "Nobitex"
    end
    if gold_live_usd <= 0.0 && db_backup["gold_oz"] > 0.0
        gold_live_usd = db_backup["gold_oz"]
        gold_source = "Database"
    end

    # ---------- طلای ۱۸ ----------
    g18_live_toman = get(tgju_live, "gold_18k_toman", 0.0)
    g18_source = "TGJU"
    if g18_live_toman <= 0.0 && gold_live_usd > 0.0 && usd_live_toman > 0.0
        g18_live_toman = (gold_live_usd / TROY_GRAM) * 0.75 * usd_live_toman * 1.012
        g18_source = "فرمول رسمی"
    end
    if g18_live_toman <= 0.0 && db_backup["iran_gold"] > 0.0
        g18_live_toman = db_backup["iran_gold"]
        g18_source = "Database"
    end

    # ---------- تاریخچه UDF ----------
    raw_usd_p, raw_usd_d = fetch_crypto_udf_history("USDTIRT", days, current_time)
    if !isempty(raw_usd_p) && usd_live_toman > 0.0
        med = median(raw_usd_p)
        if med > 5.0 * usd_live_toman
            raw_usd_p = raw_usd_p ./ 10.0
        end
    end

    raw_gold_p, raw_gold_d = fetch_crypto_udf_history("PAXGUSDT", days, current_time)

    base_dates = if !isempty(raw_gold_d)
        raw_gold_d
    elseif !isempty(raw_usd_d)
        raw_usd_d
    else
        [DateTime(current_time - Day(days - i)) for i in 1:days]
    end

    gold_anchor = gold_live_usd > 0.0 ? gold_live_usd : (!isempty(raw_gold_p) ? raw_gold_p[end] : 0.0)
    gold_prices = align_series_to_dates(raw_gold_p, raw_gold_d, base_dates, gold_anchor)
    if gold_live_usd > 0.0 && !isempty(gold_prices); gold_prices[end] = gold_live_usd; end

    usd_anchor = usd_live_toman > 0.0 ? usd_live_toman : (!isempty(raw_usd_p) ? raw_usd_p[end] : 0.0)
    usd_prices = align_series_to_dates(raw_usd_p, raw_usd_d, base_dates, usd_anchor)
    if usd_live_toman > 0.0 && !isempty(usd_prices); usd_prices[end] = usd_live_toman; end

    iran_prices = Float64[]
    for i in 1:length(base_dates)
        push!(iran_prices, (gold_prices[i] / TROY_GRAM) * 0.75 * usd_prices[i] * 1.012)
    end
    if g18_live_toman > 0.0 && !isempty(iran_prices); iran_prices[end] = g18_live_toman; end

    # ---------- رمزارزها ----------
    raw_btc_p, raw_btc_d = fetch_crypto_udf_history("BTCUSDT", days, current_time)
    raw_eth_p, raw_eth_d = fetch_crypto_udf_history("ETHUSDT", days, current_time)
    raw_sol_p, raw_sol_d = fetch_crypto_udf_history("SOLUSDT", days, current_time)

    live_btc = get(nobi_stats, "btc-usdt", !isempty(raw_btc_p) ? raw_btc_p[end] : 0.0)
    live_eth = get(nobi_stats, "eth-usdt", !isempty(raw_eth_p) ? raw_eth_p[end] : 0.0)
    live_sol = get(nobi_stats, "sol-usdt", !isempty(raw_sol_p) ? raw_sol_p[end] : 0.0)

    btc_prices = align_series_to_dates(raw_btc_p, raw_btc_d, base_dates, live_btc)
    eth_prices = align_series_to_dates(raw_eth_p, raw_eth_d, base_dates, live_eth)
    sol_prices = align_series_to_dates(raw_sol_p, raw_sol_d, base_dates, live_sol)

    if !isempty(btc_prices) && live_btc > 0.0; btc_prices[end] = live_btc; end
    if !isempty(eth_prices) && live_eth > 0.0; eth_prices[end] = live_eth; end
    if !isempty(sol_prices) && live_sol > 0.0; sol_prices[end] = live_sol; end

    # ---------- فارکس ----------
    fx_symbols = ["EUR", "GBP", "JPY", "CHF", "CAD", "AUD", "NZD", "CNY", "TRY"]
    names_fa = Dict(
        "EUR"=>"یورو", "GBP"=>"پوند انگلیس", "JPY"=>"ین ژاپن", "CHF"=>"فرانک سوئیس",
        "CAD"=>"دلار کانادا", "AUD"=>"دلار استرالیا", "NZD"=>"دلار نیوزیلند",
        "CNY"=>"یوان چین", "TRY"=>"لیر ترکیه"
    )

    currencies = CurrencyData[]
    rates = copy(fx_rates_live)
    rates["USD"] = 1.0

    for sym in fx_symbols
        live_rate = get(rates, sym, 0.0)
        c_prices = live_rate > 0.0 ? fill(live_rate, length(base_dates)) : fill(0.0, length(base_dates))
        push!(currencies, CurrencyData(sym, get(names_fa, sym, sym), c_prices, base_dates, live_rate, 0.0))
    end

    return Dict{String,Any}(
        "gold_oz"    => Dict("prices" => gold_prices, "dates" => base_dates, "provider" => gold_source),
        "usd_irr"    => Dict("prices" => usd_prices, "dates" => base_dates, "provider" => usd_source),
        "iran_gold"  => Dict("prices" => iran_prices, "dates" => base_dates, "provider" => g18_source),
        "currencies" => currencies,
        "rates"      => rates,
        "btc" => Dict("prices" => btc_prices, "dates" => base_dates, "provider" => "Nobitex"),
        "eth" => Dict("prices" => eth_prices, "dates" => base_dates, "provider" => "Nobitex"),
        "sol" => Dict("prices" => sol_prices, "dates" => base_dates, "provider" => "Nobitex")
    )
end

function fetch_upcoming_events(days_ahead::Int=14)
    return Dict[]
end

end