:root {
    --bg: #070a0f;
    --bg-panel: #0e131f;
    --bg-card: #0b0e14;
    --border: #1b2438;
    --cyan: #06d6d6;
    --gold: #facc15;
    --green: #22c55e;
    --red: #ef4444;
    --text: #f8fafc;
    --muted: #94a3b8;
    --dim: #64748b;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Vazirmatn', Tahoma, -apple-system, sans-serif;
    direction: rtl;
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* ============ Header ============ */
.terminal-header {
    background: #090d15;
    border-bottom: 2px solid #141b2d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    gap: 20px;
    flex-wrap: wrap;
}

.brand { display: flex; align-items: center; gap: 12px; }

.brand-logo {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, #06d6d6, #3b82f6);
    color: #070a0f;
    font-weight: 900;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    box-shadow: 0 0 15px rgba(6,214,214,0.4);
}

.brand-text h1 { font-size: 1.2rem; letter-spacing: 1.5px; color: #fff; }
.brand-text span { font-size: 0.72rem; color: var(--cyan); }

.terminal-nav { display: flex; gap: 6px; flex-wrap: wrap; }

.nav-btn {
    background: #0e131f;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
}

.nav-btn:hover { color: #fff; border-color: var(--cyan); }

.nav-btn.active {
    background: #141c2e;
    color: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 12px rgba(6,214,214,0.25);
}

.hotkey {
    background: #1b2438;
    color: var(--cyan);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.7rem;
    font-family: monospace;
}

.header-widgets { display: flex; align-items: center; gap: 12px; }

.live-clock {
    font-family: monospace;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gold);
}

.refresh-btn {
    background: #0e131f;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 6px;
}

.refresh-btn:hover { border-color: var(--cyan); color: var(--cyan); }
.refresh-btn:disabled { opacity: 0.5; cursor: not-allowed; }

.status-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--muted);
}

.status-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #64748b;
    transition: all 0.3s;
}

.status-dot.online { background: var(--green); box-shadow: 0 0 8px var(--green); }

/* ============ Alert Banner ============ */
.alert-banner {
    background: #0c101a;
    border-bottom: 1px solid var(--border);
    padding: 8px 20px;
    font-size: 0.82rem;
    color: var(--muted);
    font-family: monospace;
}

.alert-ok { color: #4ade80; }
.alert-warn { color: var(--gold); }
.alert-error { color: #f87171; }

/* ============ Main ============ */
.terminal-main { flex: 1; padding: 20px; }

.page { display: none; }
.page.active { display: block; }

.page-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    padding-right: 12px;
    border-right: 4px solid var(--cyan);
}

.page-code {
    background: #141c2e;
    color: var(--cyan);
    font-family: monospace;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
}

.page-header h2 { font-size: 1.15rem; }
.page-subtitle { font-size: 0.78rem; color: var(--dim); }

/* ============ Grids ============ */
.grid-2 { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }

/* ============ Panels ============ */
.panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
}

.panel-head {
    background: #0b0e17;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 700;
    color: #f1f5f9;
}

.panel-body { padding: 16px; }

.chart-body {
    height: 300px;
    padding: 12px;
    position: relative;
}

.chart-body canvas { max-height: 276px; }

/* ============ KPI ============ */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
}

.kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.kpi-head { display: flex; justify-content: space-between; align-items: center; }
.kpi-head h4 { font-size: 0.82rem; color: var(--muted); font-weight: 600; }

.badge {
    background: #141c2e;
    color: var(--cyan);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
}

.kpi-value {
    font-family: monospace;
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
}

.kpi-value .unit {
    font-size: 0.75rem;
    color: var(--dim);
    margin-right: 4px;
}

/* ============ Regime ============ */
.regime-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.85rem;
}

.regime-signals {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.signal-item {
    background: rgba(34,197,94,0.08);
    color: #4ade80;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 0.8rem;
}

/* ============ Heatmap ============ */
.heatmap-grid { display: flex; flex-direction: column; gap: 6px; }

.heatmap-header,
.heatmap-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 8px;
    align-items: center;
}

.heatmap-header { font-size: 0.75rem; color: var(--dim); padding: 4px 8px; }

.heatmap-row {
    padding: 8px;
    background: var(--bg-card);
    border-radius: 6px;
    border: 1px solid var(--border);
}

.hm-name { font-size: 0.85rem; font-weight: 600; }

.hm-val {
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
    padding: 4px;
    border-radius: 4px;
}

.hm-val.up { color: #4ade80; background: rgba(34,197,94,0.08); }
.hm-val.down { color: #f87171; background: rgba(239,68,68,0.08); }

/* ============ Targets ============ */
.target-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
}

.target-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
}

.target-card h4 { font-size: 0.8rem; color: var(--muted); margin-bottom: 6px; }

.target-val {
    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
}

.target-range {
    font-family: monospace;
    font-size: 0.72rem;
    display: flex;
    justify-content: space-between;
}

/* ============ Strengths ============ */
.strength-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 10px;
}

.strength-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px;
    text-align: center;
    position: relative;
}

.strength-card .rank {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.7rem;
    color: var(--dim);
    font-family: monospace;
}

.strength-card .ccy {
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    margin-top: 6px;
}

.strength-card .name {
    font-size: 0.7rem;
    color: var(--muted);
    margin-bottom: 6px;
}

.strength-card .score {
    font-family: monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
}

.strength-card .bar {
    height: 4px;
    background: #1b2438;
    border-radius: 2px;
    margin: 6px 0;
    overflow: hidden;
}

.strength-card .bar .fill {
    height: 100%;
    background: linear-gradient(90deg, #06d6d6, #22c55e);
    border-radius: 2px;
}

.strength-card .bias {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 0;
}

.strength-card .bias.buy { color: #4ade80; }
.strength-card .bias.sell { color: #f87171; }
.strength-card .bias.neutral { color: var(--dim); }

/* ============ Setups ============ */
.setups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 12px;
}

.setup-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    border-top: 3px solid #64748b;
}

.setup-card.buy { border-top-color: #22c55e; }
.setup-card.sell { border-top-color: #ef4444; }

.setup-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.setup-symbol { display: flex; align-items: center; gap: 8px; }

.setup-symbol .sym {
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
}

.bias-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
}

.bias-badge.buy {
    background: rgba(34,197,94,0.15);
    color: #4ade80;
    border: 1px solid rgba(34,197,94,0.3);
}

.bias-badge.sell {
    background: rgba(239,68,68,0.15);
    color: #f87171;
    border: 1px solid rgba(239,68,68,0.3);
}

.bias-badge.neutral {
    background: rgba(100,116,139,0.15);
    color: #94a3b8;
}

.setup-grade {
    padding: 2px 10px;
    border-radius: 4px;
    font-family: monospace;
    font-weight: 800;
    font-size: 0.85rem;
}

.conf-bar {
    height: 6px;
    background: #1b2438;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 4px;
}

.conf-fill { height: 100%; border-radius: 3px; }

.conf-label {
    font-size: 0.72rem;
    color: var(--dim);
    margin-bottom: 10px;
    font-family: monospace;
}

.setup-body {
    background: #090c12;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
}

.setup-body .row {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
    font-size: 0.8rem;
}

.setup-body .row span { color: var(--muted); }
.setup-body .row b { font-family: monospace; }

.setup-reasons {
    font-size: 0.72rem;
    color: var(--dim);
    background: rgba(6,214,214,0.04);
    border: 1px dashed rgba(6,214,214,0.2);
    padding: 8px;
    border-radius: 4px;
}

.empty {
    text-align: center;
    padding: 30px;
    color: var(--dim);
    font-size: 0.85rem;
}

/* ============ Data table ============ */
.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
}

.data-table th,
.data-table td {
    padding: 8px 10px;
    text-align: right;
    border-bottom: 1px solid var(--border);
}

.data-table th {
    color: var(--dim);
    font-weight: 700;
    background: #0b0e17;
}

.data-table td { font-family: monospace; }
.data-table tr:hover td { background: rgba(6,214,214,0.03); }

/* ============ Colors ============ */
.up { color: #4ade80 !important; }
.down { color: #f87171 !important; }
.gold { color: var(--gold) !important; }
.cyan { color: var(--cyan) !important; }
.green { color: var(--green) !important; }

/* ============ Footer ============ */
.terminal-footer {
    background: #090d15;
    border-top: 1px solid var(--border);
    padding: 10px 20px;
    display: flex;
    gap: 24px;
    font-size: 0.78rem;
    color: var(--dim);
    font-family: monospace;
    align-items: center;
    flex-wrap: wrap;
}

.terminal-footer .copyright { margin-right: auto; color: var(--cyan); }

/* ============ Responsive ============ */
@media (max-width: 1100px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
}

@media (max-width: 700px) {
    .terminal-header { flex-direction: column; align-items: stretch; }
    .terminal-nav { justify-content: center; }
    .header-widgets { justify-content: center; }
}