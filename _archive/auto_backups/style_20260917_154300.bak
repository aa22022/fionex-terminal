/* ================================================================
   🏛️ FIONEX TERMINAL v5.0 - BLOOMBERG OBSIDIAN THEME
   ================================================================ */

:root {
    --bg-main: #070A0F;
    --bg-panel: #0E131F;
    --bg-card: #0B0E14;
    --border-color: #1B2438;
    --accent-cyan: #06D6D6;
    --accent-gold: #FACC15;
    --accent-green: #22C55E;
    --accent-red: #EF4444;
    --accent-purple: #A855F7;
    --text-main: #F8FAFC;
    --text-muted: #94A3B8;
    --text-dim: #64748B;
    --font-fa: 'Vazirmatn', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body.terminal-body {
    background: var(--bg-main);
    color: var(--text-main);
    font-family: var(--font-fa);
    direction: rtl;
    line-height: 1.5;
    overflow-x: hidden;
}

/* 🔷 هدر بلومبرگ */
.terminal-header {
    background: #090D15;
    border-bottom: 2px solid #141B2D;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 24px;
}

.terminal-brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.terminal-logo {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #06D6D6, #3B82F6);
    color: #070A0F;
    font-weight: 900;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    box-shadow: 0 0 15px rgba(6, 214, 214, 0.4);
}

.brand-text h1 {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    letter-spacing: 1px;
    color: #FFFFFF;
}

.brand-text .sub {
    font-size: 0.72rem;
    color: var(--accent-cyan);
}

.terminal-nav {
    display: flex;
    gap: 8px;
}

.nav-btn {
    background: #0E131F;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 8px 18px;
    border-radius: 6px;
    font-family: var(--font-fa);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
}

.nav-btn .hotkey {
    background: #1B2438;
    color: var(--accent-cyan);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
}

.nav-btn:hover {
    color: #FFFFFF;
    border-color: var(--accent-cyan);
}

.nav-btn.active {
    background: #141C2E;
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(6, 214, 214, 0.2);
}

.terminal-widgets {
    display: flex;
    align-items: center;
    gap: 14px;
}

.live-clock {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-gold);
}

.terminal-btn {
    background: #0E131F;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 6px 14px;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-fa);
    font-size: 0.8rem;
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #64748B;
}

.status-dot.online {
    background: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
}

/* نوار هشدار */
.alert-strip {
    background: #0C101A;
    border-bottom: 1px solid var(--border-color);
    padding: 6px 24px;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
}

/* ناحیه اصلی */
.terminal-main {
    padding: 20px 24px;
}

.page-section {
    display: none !important;
}

.page-section.active {
    display: block !important;
}

.panel-title-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    border-right: 4px solid var(--accent-cyan);
    padding-right: 12px;
}

.panel-title-bar h2 {
    font-size: 1.25rem;
    font-weight: 800;
}

.panel-title-bar .panel-code {
    background: #141C2E;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
}

.panel-title-bar .panel-subtitle {
    font-size: 0.8rem;
    color: var(--text-dim);
}

/* پنل‌های استاندارد بلومبرگ */
.term-panel {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
}

.panel-head {
    background: #0B0E17;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 0.9rem;
}

.panel-head span {
    color: #F1F5F9;
}

.panel-head .panel-meta {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
}

.panel-body {
    padding: 16px;
}

/* کادرهای KPI */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin-bottom: 18px;
}

.kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.kpi-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.kpi-head h4 {
    font-size: 0.82rem;
    color: var(--text-muted);
}

.kpi-card .value {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
}

.kpi-card .unit {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-right: 4px;
}

.source-badge {
    background: #141C2E;
    color: var(--accent-cyan);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-mono);
}

.kpi-tickers {
    display: flex;
    gap: 6px;
}

.kpi-ticker-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
}

.kpi-ticker-tag.up { color: #4ADE80; background: rgba(34, 197, 94, 0.1); }
.kpi-ticker-tag.down { color: #F87171; background: rgba(239, 68, 68, 0.1); }
.kpi-ticker-tag.neutral { color: var(--text-dim); background: rgba(100, 116, 139, 0.1); }

/* ردیف ۳ تایی F1 */
.widgets-row-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 18px;
}

.overview-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
}

.chart-body {
    height: 250px;
    padding: 12px;
}

/* ویجت حباب سکه */
.bubble-widget {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bubble-main-stat {
    display: flex;
    gap: 12px;
    align-items: center;
}

.bubble-pct-box {
    padding: 10px 14px;
    border-radius: 8px;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
}

.bubble-pct-box .pct-num {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 800;
    color: #FFFFFF;
}

.bubble-pct-box .pct-lbl {
    font-size: 0.7rem;
    color: var(--text-dim);
}

.bubble-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.bubble-details .b-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    border-bottom: 1px dashed rgba(27, 36, 56, 0.6);
    padding-bottom: 3px;
}

.bubble-status-badge {
    padding: 8px 12px;
    border-radius: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.bubble-status-badge .status-title { font-size: 0.8rem; font-weight: 700; color: #F87171; }
.bubble-status-badge.up .status-title { color: #4ADE80; }
.bubble-status-badge.neutral .status-title { color: var(--accent-cyan); }
.bubble-status-badge .status-desc { font-size: 0.7rem; color: var(--text-dim); }

/* گیج فشار */
.gauge-widget {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.gauge-meter-wrapper {
    position: relative;
    width: 140px;
    height: 70px;
    overflow: hidden;
}

.gauge-meter {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: conic-gradient(from 180deg at 50% 50%, #EF4444 0deg, #FACC15 90deg, #22C55E 180deg);
}

.gauge-arc {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 112px;
    height: 112px;
    background: var(--bg-panel);
    border-radius: 50%;
}

.gauge-needle {
    position: absolute;
    bottom: 50%;
    left: 50%;
    width: 3px;
    height: 52px;
    background: #FFFFFF;
    transform-origin: bottom center;
    border-radius: 2px;
    transition: transform 0.5s ease;
}

.gauge-center-cap {
    position: absolute;
    top: calc(50% - 6px);
    left: calc(50% - 6px);
    width: 12px;
    height: 12px;
    background: var(--accent-cyan);
    border-radius: 50%;
}

.gauge-score-num {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
}

.gauge-status-text {
    font-size: 0.75rem;
    font-weight: 700;
}

.gauge-bars-container {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    color: var(--text-dim);
    margin-top: 4px;
}

.pressure-bar-fill-box {
    flex: 1;
    height: 5px;
    background: var(--border-color);
    border-radius: 3px;
    overflow: hidden;
}

.pressure-fill { height: 100%; border-radius: 3px; }

/* تقویم رویدادها */
.calendar-events-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.event-item-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 8px 10px;
}

.event-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.event-curr-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    background: #141C2E;
    color: var(--accent-cyan);
    padding: 1px 5px;
    border-radius: 3px;
}

.event-title {
    flex: 1;
    font-size: 0.75rem;
    font-weight: 700;
}

.event-impact-tag {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 3px;
}

.event-impact-tag.high { color: #F87171; background: rgba(239, 68, 68, 0.15); }
.event-impact-tag.medium { color: #FACC15; background: rgba(250, 204, 21, 0.15); }

.event-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--text-dim);
}

.countdown-timer { color: var(--accent-cyan); font-family: var(--font-mono); }

/* نقشه حرارتی F1 */
.heatmap-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
}

.heatmap-row {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, 1fr);
    gap: 8px;
}

.heatmap-cell {
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 0.8rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.heatmap-cell.asset-label {
    background: var(--bg-card);
    font-weight: 700;
}

.heatmap-cell.val-cell {
    font-family: var(--font-mono);
    font-weight: 700;
}

/* رژیم بازار */
.regime-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.regime-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 6px;
}

.regime-signals {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
}

.sig-item {
    font-size: 0.75rem;
    color: #4ADE80;
    background: rgba(34, 197, 94, 0.08);
    padding: 4px 8px;
    border-radius: 4px;
}

/* ================================================================
   💰 صفحه F2 (طلا و ارز ایران)
   ================================================================ */
.chart-controls-bar {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.tf-selector, .indicator-selector {
    display: flex;
    align-items: center;
    gap: 8px;
}

.ctrl-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-weight: 700;
}

.tf-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 4px 12px;
    border-radius: 4px;
    font-family: var(--font-fa);
    font-size: 0.8rem;
    cursor: pointer;
}

.tf-btn.active {
    background: #141C2E;
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
}

.ind-checkbox {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
}

.ind-checkbox input {
    accent-color: var(--accent-cyan);
}

.charts-three-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.chart-box {
    height: 320px;
    padding: 12px;
    position: relative;
    width: 100%;
}

.chart-box canvas {
    max-height: 296px !important;
}

.multi-target-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.target-horizon-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.target-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.horizon-title { font-size: 0.85rem; font-weight: 700; }

.horizon-badge {
    font-size: 0.65rem;
    padding: 1px 6px;
    border-radius: 3px;
    font-weight: 700;
}
.horizon-badge.cyan { background: rgba(6, 214, 214, 0.15); color: var(--accent-cyan); }
.horizon-badge.green { background: rgba(34, 197, 94, 0.15); color: #4ADE80; }
.horizon-badge.gold { background: rgba(250, 204, 21, 0.15); color: var(--accent-gold); }
.horizon-badge.purple { background: rgba(168, 85, 247, 0.15); color: #C084FC; }

.target-confidence-bar {
    height: 10px;
    background: #141B2D;
    border-radius: 5px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.conf-fill {
    position: absolute;
    right: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-cyan), #22C55E);
}

.conf-label {
    position: relative;
    z-index: 2;
    font-size: 0.6rem;
    font-weight: 700;
    color: #FFFFFF;
}

.target-items {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px dashed var(--border-color);
    padding-top: 6px;
}

.t-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
}

.t-item .lbl { color: var(--text-dim); }
.t-item .val { font-family: var(--font-mono); font-weight: 700; }
.t-item .ret { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; }
.t-item .ret.up { color: #4ADE80; }
.t-item .ret.down { color: #F87171; }

/* ================================================================
   🔗 F3 & F4 (روابط و بک‌تست)
   ================================================================ */
.relations-grid-2, .backtest-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
}

.chart-box-tall {
    height: 320px;
    padding: 12px;
}

.matrix-heatmap-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
    text-align: center;
}

.matrix-heatmap-table th, .matrix-heatmap-table td {
    padding: 8px 4px;
    border: 1px solid var(--border-color);
}

.matrix-heatmap-table td.row-header {
    background: #0B0E14;
    font-weight: 700;
    text-align: right;
    padding-right: 8px;
}

.arbitrage-cards-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.arb-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.arb-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
}

.arb-badge {
    font-size: 0.65rem;
    color: var(--accent-cyan);
    background: rgba(6, 214, 214, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
}

.arb-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
}

.arb-row .lbl { color: var(--text-dim); }
.arb-row .val { font-family: var(--font-mono); font-weight: 700; }

.factor-stacked-bar {
    display: flex;
    height: 20px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 12px;
}

.factor-bar-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: #070A0F;
}

.factor-legend-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.factor-legend-item {
    display: flex;
    gap: 6px;
    font-size: 0.75rem;
}

.factor-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 4px;
}

.backtest-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 16px;
}

.bt-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 4px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
}

.bt-btn.active {
    background: #141C2E;
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
}

.model-grade-card {
    display: flex;
    align-items: center;
    gap: 14px;
}

.grade-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--accent-green);
    color: var(--accent-green);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* فوتر بلومبرگ */
.terminal-footer {
    background: #090D15;
    border-top: 1px solid var(--border-color);
    padding: 8px 24px;
    display: flex;
    gap: 24px;
    font-size: 0.78rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
}

.terminal-footer .footer-item { display: flex; gap: 4px; }
.terminal-footer .copyright { margin-right: auto; }

/* رنگ‌های کمکی */
.text-cyan { color: var(--accent-cyan) !important; }
.text-gold { color: var(--accent-gold) !important; }
.gold { color: var(--accent-gold) !important; }
.up { color: #4ADE80 !important; }
.down { color: #F87171 !important; }

@media (max-width: 1200px) {
    .charts-three-grid, .widgets-row-3, .multi-target-grid { grid-template-columns: 1fr; }
    .relations-grid-2, .backtest-grid-2, .overview-grid { grid-template-columns: 1fr; }
}