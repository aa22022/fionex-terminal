// ================================================================
// 🎯 کنترلر ناوبری
// ================================================================
function renderCurrentPage() {
    const activeTab = document.querySelector(".nav-btn.active");
    if (!activeTab) { renderOverview(); return; }
    const pageId = activeTab.getAttribute("data-page");
    
    if (pageId === "page-overview") renderOverview();
    else if (pageId === "page-gold") renderGold();
    else if (pageId === "page-fx") renderFX();
    else if (pageId === "page-relations") renderRelations();
    else if (pageId === "page-backtest") renderBacktestDefault();
    else if (pageId === "page-reports") renderReports();
}

async function loadData() {
    try {
        const statusDot = document.getElementById("statusDot");
        if (statusDot) statusDot.style.animation = "pulseLive 0.6s infinite alternate";
        
        const resp = await fetch("/api/data");
        if (resp.ok) {
            window.appState = await resp.json();
            renderCurrentPage();
            
            const lastUp = document.getElementById("lastUp");
            if (lastUp && window.appState.last_update) {
                lastUp.innerText = toPersianDate(window.appState.last_update, true);
            }
        }
        if (statusDot) statusDot.style.animation = "pulseLive 1.5s infinite alternate";
    } catch (e) {
        console.error("خطا در ارتباط با سرور:", e);
    }
}

async function refreshData() {
    try {
        await fetch("/api/refresh");
        await loadData();
    } catch (e) {
        console.error("خطا در رفرش دستی:", e);
    }
}

document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll(".nav-btn");
    btns.forEach(btn => {
        btn.addEventListener("click", () => {
            btns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            
            document.querySelectorAll(".page-section").forEach(p => {
                p.classList.remove("active");
                p.style.display = "none";
            });
            const targetPage = btn.getAttribute("data-page");
            const pageEl = document.getElementById(targetPage);
            if (pageEl) {
                pageEl.classList.add("active");
                pageEl.style.display = "block";
            }
            
            renderCurrentPage();
        });
    });

    const refreshBtn = document.getElementById("btnRefresh");
    if (refreshBtn) refreshBtn.addEventListener("click", refreshData);
    
    updateClock();
    loadData();
    setInterval(loadData, 45000);
});