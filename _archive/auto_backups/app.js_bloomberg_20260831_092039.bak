function renderHeatmap() {
    const el = document.getElementById("marketHeatmap");
    if (!el || !window.appState) return;
    
    const gh = window.appState.gold_history.prices;
    const uh = window.appState.usd_history.prices;
    const ih = window.appState.iran_gold_history.prices;
    const btc = window.appState.btc_history ? window.appState.btc_history.prices : [];
    const eth = window.appState.eth_history ? window.appState.eth_history.prices : [];
    
    function calcChange(arr, days) {
        if (!arr || arr.length < days + 1) return 0;
        const now = arr[arr.length - 1];
        const past = arr[arr.length - days - 1];
        return ((now - past) / past) * 100;
    }
    
    const assets = [
        { name: "انس طلا", data: gh },
        { name: "دلار تهران", data: uh },
        { name: "طلای ۱۸ عیار", data: ih },
        { name: "بیت‌کوین", data: btc },
        { name: "اتریوم", data: eth }
    ];
    
    el.innerHTML = assets.map(a => {
        const ch1 = calcChange(a.data, 1);
        const ch5 = calcChange(a.data, 5);
        const ch20 = calcChange(a.data, 20);
        const c1 = ch1 >= 0 ? '#2E7D5B' : '#C0392B';
        const c5 = ch5 >= 0 ? '#2E7D5B' : '#C0392B';
        const c20 = ch20 >= 0 ? '#2E7D5B' : '#C0392B';
        return `
            <div class="heatmap-card">
                <h4>${a.name}</h4>
                <div style="display:flex;gap:8px;justify-content:space-between;font-size:12px">
                    <span style="color:${c1}">۱ روز: ${formatDecimalFa(ch1)}%</span>
                    <span style="color:${c5}">۵ روز: ${formatDecimalFa(ch5)}%</span>
                    <span style="color:${c20}">۲۰ روز: ${formatDecimalFa(ch20)}%</span>
                </div>
            </div>
        `;
    }).join("");
}

function renderRegimeInfo() {
    const el = document.getElementById("ovRegimeInfo");
    if (!el || !window.appState) return;
    
    const p = window.appState.prediction;
    const trend = p ? p.trend : "نامشخص";
    const conf = p ? p.confidence : 0;
    
    el.innerHTML = `
        <div class="regime-card">
            <h4>📊 وضعیت رژیم بازار</h4>
            <p><strong>روند:</strong> ${trend}</p>
            <p><strong>اطمینان مدل:</strong> ${formatDecimalFa(conf)}%</p>
            <p><strong>سیگنال‌های کلیدی:</strong></p>
            <ul>
                ${(p && p.signals ? p.signals.map(s => `<li>${s}</li>`).join("") : "<li>--</li>")}
            </ul>
        </div>
    `;
}

function renderTopSetups() {
    const el = document.getElementById("ovTopSetups");
    if (!el || !window.appState) return;
    
    const setups = (window.appState.fx_scan && window.appState.fx_scan.setups) || [];
    const top5 = setups.slice(0, 5);
    
    if (top5.length === 0) {
        el.innerHTML = '<div style="padding:20px;text-align:center;color:#7F8C8D">ستاپ فعالی در حال حاضر یافت نشد.</div>';
        return;
    }
    
    el.innerHTML = top5.map(s => `
        <div class="setup-mini">
            <strong>${s.symbol}</strong> [${s.bias}]
            &nbsp;|&nbsp; کیفیت: ${s.trade_quality || '--'}
            &nbsp;|&nbsp; R/R: ${formatDecimalFa(s.risk_reward)}
        </div>
    `).join("");
}

function renderOverview() {
    if (!window.appState) return;
    renderOverviewKpi();
    renderHeatmap();
    renderRegimeInfo();
    renderTopSetups();
    
    const gh = window.appState.gold_history;
    if (gh) renderLineChart("ovChGoldMini", gh.dates, gh.prices, "روند انس جهانی", "#C9A961");
    
    const alertBanner = document.getElementById("alertBanner");
    if (alertBanner && window.appState.market_alert) {
        alertBanner.innerHTML = `<span class="alert-icon">◈</span> <span>${window.appState.market_alert.message}</span>`;
    }
}

// ================================================================
// 🥇 رندر صفحه طلا و ارز
// ================================================================
function renderGold() {
    if (!window.appState) return;
    const gh = window.appState.gold_history;
    const uh = window.appState.usd_history;
    const ih = window.appState.iran_gold_history;
    const hDots = window.appState.historical_prediction_dots || {};

    renderLineChart("chGold", gh.dates, gh.prices, "انس جهانی طلا (USD)", "#C9A961", hDots.gold_oz);
    renderLineChart("chUSD", uh.dates, uh.prices, "دلار تهران (تومان)", "#40826D", hDots.usd_irr);
    renderLineChart("chIran", ih.dates, ih.prices, "طلای ۱۸ عیار (تومان)", "#8B3A3A", hDots.iran_gold);
    
    const p = window.appState.prediction;
    const el = document.getElementById("goldPredGrid");
    if (el && p) {
        el.innerHTML = `
            <div class="pred-card">
                <h4>🎯 هدف قیمت انس طلا</h4>
                <p><strong>پیش‌بینی:</strong> ${formatDecimalFa(p.gold_oz.point)} USD</p>
                <p><strong>محدوده:</strong> ${formatDecimalFa(p.gold_oz.low)} تا ${formatDecimalFa(p.gold_oz.high)}</p>
            </div>
            <div class="pred-card">
                <h4>🎯 هدف قیمت دلار</h4>
                <p><strong>پیش‌بینی:</strong> ${formatPriceFa(p.usd_irr.point)} تومان</p>
                <p><strong>محدوده:</strong> ${formatPriceFa(p.usd_irr.low)} تا ${formatPriceFa(p.usd_irr.high)}</p>
            </div>
            <div class="pred-card">
                <h4>🎯 هدف قیمت طلای ۱۸</h4>
                <p><strong>پیش‌بینی:</strong> ${formatPriceFa(p.iran_gold.point)} تومان</p>
                <p><strong>محدوده:</strong> ${formatPriceFa(p.iran_gold.low)} تا ${formatPriceFa(p.iran_gold.high)}</p>
            </div>
        `;
    }
}

// ================================================================
// 💱 رندر فارکس و کریپتو
// ================================================================
function renderFX() {
    if (!window.appState || !window.appState.fx_scan) return;
    const setups = window.appState.fx_scan.setups || [];
    
    const fxEl = document.getElementById("fxSetups");
    const cryptoEl = document.getElementById("cryptoSetups");
    
    if (fxEl) {
        const fxSetups = setups.filter(s => s.category !== "crypto");
        fxEl.innerHTML = fxSetups.length === 0
            ? '<div style="padding:20px;text-align:center;color:#7F8C8D">ستاپ فعالی یافت نشد.</div>'
            : fxSetups.map(s => `
                <div class="setup-card">
                    <h4>${s.symbol} [${s.bias}]</h4>
                    <p>کیفیت: ${s.trade_quality || '--'} | R/R: ${formatDecimalFa(s.risk_reward)}</p>
                    <p>تارگت ۱: ${formatPriceFa(s.target1)}</p>
                    <p>استاپ: ${formatPriceFa(s.stop_loss)}</p>
                </div>
            `).join("");
    }
    
    if (cryptoEl) {
        const cryptoSetups = setups.filter(s => s.category === "crypto");
        cryptoEl.innerHTML = cryptoSetups.length === 0
            ? '<div style="padding:20px;text-align:center;color:#7F8C8D">ستاپ کریپتویی یافت نشد.</div>'
            : cryptoSetups.map(s => `
                <div class="setup-card">
                    <h4>${s.symbol} [${s.bias}]</h4>
                    <p>کیفیت: ${s.trade_quality || '--'} | R/R: ${formatDecimalFa(s.risk_reward)}</p>
                </div>
            `).join("");
    }
}

