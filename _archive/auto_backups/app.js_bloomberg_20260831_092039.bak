            ${rels.map(r => `
                <tr>
                    <td>${r.asset_b}</td>
                    <td>${formatDecimalFa(r.pearson_20d)}</td>
                    <td>${formatDecimalFa(r.pearson_60d)}</td>
                    <td>${r.strength}</td>
                </tr>
            `).join("")}
        </tbody>
    `;
}

