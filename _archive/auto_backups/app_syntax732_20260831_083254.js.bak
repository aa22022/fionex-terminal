    b.classList.toggle('active', b.textContent.trim().toLowerCase() === tf.toLowerCase());
  });
  renderFxStudioCandles();
}

/* ========================================================================= */
/* CANDLESTICK GENERATORS FOR TIMEFRAMES                                     */
/* ========================================================================= */
async function fetchBinanceLiveCandles(symbol, tf) {
  try {
    const interval = tf === '1w' ? '1w' : tf === '1d' ? '1d' : tf === '4h' ? '4h' : tf === '1h' ? '1h' : '15m';
    const url = `https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=${interval}&limit=60`;
    const r = await fetch(url);
    const data = await r.json();
    if (!Array.isArray(data)) return null;

    return data.map(k => {
      const isIntraday = ['15m','1h','4h'].includes(tf);
      return {
        time: isIntraday ? Math.floor(parseInt(k[0]) / 1000) : new Date(k[0]).toISOString().split('T')[0],
        open: parseFloat(k[1]),
        high: parseFloat(k[2]),
        low: parseFloat(k[3]),
        close: parseFloat(k[4])
      };
    });
  } catch(e) {
    console.warn("Binance direct klines fetch failed:", e);
    return null;
  }
}

function generateCandlesForTimeframe(rawPrices, curVal, tf, isUp, atr) {
  const numBars = 40;
  const bars = [];

  if (tf === '1w') {
    const sl = (rawPrices && rawPrices.length >= 10) ? rawPrices : Array(50).fill(curVal);
    let chunk = [];
    for (let i = 0; i < sl.length; i++) {
      chunk.push(sl[i]);
      if (chunk.length === 5 || i === sl.length - 1) {
        const o = chunk[0];
        const c = chunk[chunk.length - 1];
        const h = Math.max(...chunk) * 1.002;
        const l = Math.min(...chunk) * 0.998;
        
        const d = new Date();
        d.setDate(d.getDate() - (Math.floor((sl.length - 1 - i) / 5) * 7));
        const dateStr = d.toISOString().split('T')[0];

        bars.push({ time: dateStr, open: o, high: h, low: l, close: c });
        chunk = [];
      }
    }
    return bars.slice(-30);
  } else if (tf === '1d') {
    if (rawPrices && rawPrices.length >= 5) {
      const sl = rawPrices.slice(-numBars);
      for (let i = 0; i < sl.length; i++) {
        const c = sl[i];
        const o = i > 0 ? sl[i-1] : c * 0.998;
        const b_sz = Math.abs(c - o);
        const high = Math.max(o, c) + (b_sz * 0.22 + c * 0.0006);
        const low = Math.min(o, c) - (b_sz * 0.22 + c * 0.0006);
        
        const d = new Date();
        d.setDate(d.getDate() - (sl.length - 1 - i));
        const dateStr = d.toISOString().split('T')[0];

        bars.push({ time: dateStr, open: o, high: high, low: low, close: c });
      }
      return bars;
    }
  }

  // فرآیند نوسان‌گیری با زمان (تایم‌فریم‌های درون‌روزی ۱۵ دقیقه تا ۴ ساعته)
  const stepSec = tf === '15m' ? 900 : tf === '1h' ? 3600 : 14400;
  const tfVolFactor = tf === '15m' ? 0.3 : tf === '1h' ? 0.5 : 0.8;
  const nowSec = Math.floor(Date.now() / 1000);
  const startSec = nowSec - (numBars * stepSec);

  let p = curVal - (numBars * 0.15 * (isUp ? -1 : 1) * atr * tfVolFactor);

  for (let i = 0; i < numBars; i++) {
    const time = startSec + (i * stepSec);
    const isLast = (i === numBars - 1);
    const c = isLast ? curVal : p + (Math.sin(i * 0.55) * 0.5 * atr * tfVolFactor) + ((Math.random() - 0.49) * 0.9 * atr * tfVolFactor);
    const o = i === 0 ? c * 0.999 : bars[i-1].close;
    const high = Math.max(o, c) + Math.random() * atr * 0.35 * tfVolFactor;
    const low = Math.min(o, c) - Math.random() * atr * 0.35 * tfVolFactor;

    bars.push({ time: time, open: o, high: high, low: low, close: c });
    p = c;
  }

  return bars;
}

/* ========================================================================= */
/* TRADINGVIEW LIVE LIGHTWEIGHT CHARTS BUILDER                               */
/* ========================================================================= */
function buildTradingViewChart(containerId, barsData, setupObj) {
  const container = document.getElementById(containerId);
  if (!container) return null;

  if (typeof LightweightCharts === 'undefined') {
    container.innerHTML = '<div class="loading" style="padding:40px">در حال بارگذاری چارت TradingView...</div>';
    return null;
  }

  // پاکسازی کامل چارت قبلی از روی حافظه
  destroyChart(containerId);
  container.innerHTML = '';

  if (!barsData || barsData.length === 0) {
    container.innerHTML = '<div class="loading" style="padding:40px">داده‌ای برای نمایش موجود نیست</div>';
    return null;
  }

  barsData.sort((a, b) => (a.time > b.time ? 1 : -1));
  const uniqueBars = [];
  const seenTimes = new Set();
  for (const b of barsData) {
    if (!seenTimes.has(b.time)) {
      seenTimes.add(b.time);
      uniqueBars.push(b);
    }
  }

  try {
    const chart = LightweightCharts.createChart(container, {
      layout: {
        background: { color: '#0a0d14' },
        textColor: '#8a95a5',
        fontSize: 10,
        fontFamily: 'Vazirmatn, sans-serif'
      },
      grid: {
        vertLines: { color: '#161a22', style: 2 },
        horzLines: { color: '#161a22', style: 2 }
      },
      rightPriceScale: {
        borderColor: '#1e2630',
        scaleMargins: { top: 0.15, bottom: 0.15 }
      },
      timeScale: {
        borderColor: '#1e2630',
        timeVisible: true
      },
      crosshair: {
        mode: LightweightCharts.CrosshairMode.Normal,
        vertLine: { color: '#5c6878', width: 1, style: 3 },
        horzLine: { color: '#5c6878', width: 1, style: 3 }
      }
    });

    const candlestickSeries = chart.addCandlestickSeries({
      upColor: '#26a69a',
      downColor: '#ef5350',
      borderVisible: true,
      wickUpColor: '#26a69a',
      wickDownColor: '#ef5350',
      borderColor: '#36b78d',
      borderUpColor: '#26a69a',
      borderDownColor: '#ef5350'
    });

    candlestickSeries.setData(uniqueBars);

    if (setupObj && setupObj.levels) {
      const lv = setupObj.levels;
      if (setupObj.target1) {
        candlestickSeries.createPriceLine({
          price: setupObj.target1,
          color: '#26a67a',
          lineWidth: 2,
          lineStyle: LightweightCharts.LineStyle.Solid,
          axisLabelVisible: true,
          title: 'TP1: ' + setupObj.target1
        });
      }
      if (setupObj.stop_loss) {
        candlestickSeries.createPriceLine({
          price: setupObj.stop_loss,
          color: '#ef5350',
          lineWidth: 2,
          lineStyle: LightweightCharts.LineStyle.Solid,
          axisLabelVisible: true,
          title: 'SL: ' + setupObj.stop_loss
        });
      }
      if (lv.pivot) {
        candlestickSeries.createPriceLine({
          price: lv.pivot,
          color: '#b8975a',
          lineWidth: 1,
          lineStyle: LightweightCharts.LineStyle.Dashed,
          axisLabelVisible: true,
          title: 'Pivotal S/R'
        });
      }
    }

    chart.timeScale().fitContent();

    // استفاده از یک ResizeObserver امن و بستن بلافاصله آن به محض ریفرش صفحه
    const resizeObserver = new ResizeObserver(entries => {
      if (entries.length === 0 || !entries[0].contentRect) return;
      const { width, height } = entries[0].contentRect;
      if (width > 0 && height > 0) {
        try { chart.resize(width, height); } catch(e) {}
      }
    });
    resizeObserver.observe(container);

    APP.charts[containerId] = chart;
    APP.observers[containerId] = resizeObserver;
    return chart;
  } catch(err) {
    console.error("Error creating LightweightChart:", err);
    return null;
  }
}

/* ========================================================================= */
/* ON-PAGE CANDLESTICK STUDIOS (Gold & FX/Crypto)                            */
/* ========================================================================= */
async function switchStudioAsset(asset) {
  currentGoldStudioAsset = asset;
  ['gold','usd','iran','btc'].forEach(a => {
    const b = document.getElementById('btnCandle' + a.charAt(0).toUpperCase() + a.slice(1));
    if (b) b.classList.toggle('active', a === asset);
  });
  renderGoldStudioCandles();
}

async function renderGoldStudioCandles() {
    if (!window.appState) return;
    const g = window.appState.gold_history;
    renderTradingViewCandles("goldCandleContainer", g.prices, g.dates, "انس جهانی طلا");
};

  if (currentGoldStudioAsset === 'gold') {
    rawPrices = d.gold_history?.prices || [];
    name = 'انس جهانی طلا (XAU/USD)';
    unit = '$';
  } else if (currentGoldStudioAsset === 'usd') {
    rawPrices = d.usd_history?.prices || [];
    name = 'دلار آزاد تهران (USD/IRR)';
    unit = 'تومان';
  } else if (currentGoldStudioAsset === 'iran') {
    rawPrices = d.iran_gold_history?.prices || [];
    name = 'طلای ۱۸ عیار ایران';
    unit = 'تومان/گرم';
  } else if (currentGoldStudioAsset === 'btc') {
    name = 'بیت‌کوین (BTC/USDT)';
    unit = '$';
  }

  const curPrice = rawPrices.length > 0 ? rawPrices[rawPrices.length - 1] : 77000.0;
  const barEl = document.getElementById('studioPriceBar');

  async if (currentGoldStudioAsset === 'btc') {
    if (barEl) barEl.innerHTML = `<div>نماد: <b style="color:var(--accent);font-size:13px">${name} | ${tfLabelMap[tf] || tf}</b></div><div class="loading" style="padding:0;margin:0">دریافت دیتای زنده بایننس...</div>`;
    const liveBars = await fetchBinanceLiveCandles('BTCUSDT', tf);
    if (liveBars && liveBars.length > 0) {
      const bLivePrice = liveBars[liveBars.length - 1].close;
      if (barEl) {
        barEl.innerHTML = `
          <div>نماد: <b style="color:var(--accent);font-size:13px">${name} | تایم‌فریم: ${tfLabelMap[tf] || tf}</b></div>
          <div>قیمت لحظه‌ای: <b style="font-variant-numeric:tabular-nums;color:var(--up)">$${bLivePrice.toLocaleString()}</b></div>
          <div style="direction:ltr">وضعیت: <b style="color:var(--up)">🟢 Live Binance Feed</b></div>
        `;
      }
      buildTradingViewChart(containerId, liveBars, null);
      return;
    }
  }

  if (barEl) {
    barEl.innerHTML = `
      <div>نماد: <b style="color:var(--accent);font-size:13px">${name} | تایم‌فریم: ${tfLabelMap[tf] || tf}</b></div>
      <div>نرخ کلوز کندل: <b style="font-variant-numeric:tabular-nums">${unit} ${Number(curPrice).toLocaleString()}</b></div>
      <div style="direction:ltr">وضعیت: <b style="color:var(--accent)">تحلیل پرایس‌اکشن سیستم</b></div>
    `;
  }

  const generatedBars = generateCandlesForTimeframe(rawPrices, curPrice, tf, true, curPrice * 0.005);
  buildTradingViewChart(containerId, generatedBars, null);
}

function switchFxStudioSymbol(sym) {
  currentFxStudioSymbol = sym;
  renderFxStudioCandles();
}

async function renderFxStudioCandles() {
    if (!window.appState) return;
    const selector = document.getElementById("fxCandleSymbolSelector");
    if (!selector) return;
    const symbol = selector.value;
    
    // استخراج مستقیم تاریخچه جفت‌ارز از دیتای فارکس زنده بک‌اند
    let prices = [];
    let dates = window.appState.gold_history.dates; // استفاده از تاریخ‌های پایه همگام‌شده
    
    if (symbol === "BTCUSDT") {
        prices = window.appState.btc_history ? window.appState.btc_history.prices : [];
    } else if (symbol === "ETHUSDT") {
        prices = window.appState.eth_history ? window.appState.eth_history.prices : [];
    } else if (symbol === "SOLUSDT") {
        prices = window.appState.sol_history ? window.appState.sol_history.prices : [];
    } else if (window.appState.fx_scan && window.appState.fx_scan.rates_dict) {
        prices = window.appState.fx_scan.rates_dict[symbol] || [];
    }
    
    renderTradingViewCandles("fxStudioCandleContainer", prices, dates, symbol);
}" id="fxBtn_${s.symbol}" onclick="switchFxStudioSymbol('${s.symbol}')">
        ${s.symbol}
      </button>
    `).join('');
  } else if (selEl) {
    setups.slice(0, 14).forEach(s => {
      const btn = document.getElementById('fxBtn_' + s.symbol);
      if (btn) btn.classList.toggle('active', s.symbol === currentFxStudioSymbol);
    });
  }

  const s = setups.find(async item => item.symbol === currentFxStudioSymbol) || setups[0];
  if (!s) return;

  const curPrice = s.levels ? s.levels.current : 1.0;
  const biasColor = s.bias === 'long' ? 'var(--up)' : s.bias === 'short' ? 'var(--down)' : 'var(--muted)';
  const biasFa = s.bias === 'long' ? 'خرید (LONG)' : s.bias === 'short' ? 'فروش (SHORT)' : 'رنج و پایش';
  const tf = activeFxTf;
  const tfLabelMap = {'15m':'15 دقیقه (15m)','1h':'۱ ساعته (1H)','4h':'۴ ساعته (4H)','1d':'روزانه (D1)','1w':'هفتگی (W1)'};

  const barEl = document.getElementById('fxStudioPriceBar');
  const containerId = 'fxStudioCandleCanvas';

  if (s.category === 'crypto' || s.symbol.includes('USDT')) {
    if (barEl) barEl.innerHTML = `<div>نماد: <b style="color:var(--accent);font-size:13px">${s.symbol}</b></div><div class="loading" style="padding:0;margin:0">دریافت دیتای کریپتو...</div>`;
    const liveBars = await fetchBinanceLiveCandles(s.symbol, tf);
    if (liveBars && liveBars.length > 0) {
      const bLivePrice = liveBars[liveBars.length - 1].close;
      if (barEl) {
        barEl.innerHTML = `
          <div>نماد: <b style="color:var(--accent);font-size:13px">${s.symbol} | تایم‌فریم: ${tfLabelMap[tf] || tf}</b> <span class="badge badge-grade-${s.trade_quality.toLowerCase().replace('+','-plus')}">${s.trade_quality}</span></div>
          <div>قیمت لحظه‌ای: <b style="font-variant-numeric:tabular-nums;color:var(--up)">$${bLivePrice.toLocaleString()}</b></div>
          <div>سیگنال: <b style="color:${biasColor}">${biasFa}</b></div>
          <div>R:R: <b>1 : ${s.risk_reward}</b></div>
        `;
      }
      buildTradingViewChart(containerId, liveBars, s);
      return;
    }
  }

  if (barEl) {
    barEl.innerHTML = `
      <div>نماد: <b style="color:var(--accent);font-size:13px">${s.symbol} | تایم‌فریم: ${tfLabelMap[tf] || tf}</b> <span class="badge badge-grade-${s.trade_quality.toLowerCase().replace('+','-plus')}">${s.trade_quality}</span></div>
      <div>قیمت کلوز: <b style="font-variant-numeric:tabular-nums">$${Number(curPrice).toLocaleString()}</b></div>
      <div>جهت ستاپ: <b style="color:${biasColor}">${biasFa}</b></div>
      <div>ورود بهینه: <b style="font-variant-numeric:tabular-nums">${s.entry_low} - ${s.entry_high}</b></div>
      <div>R:R: <b>1 : ${s.risk_reward}</b></div>
    `;
  }

  const generatedBars = generateCandlesForTimeframe(s.history || [], curPrice, tf, s.bias === 'long', (s.levels ? s.levels.atr_daily : curPrice * 0.005));
  buildTradingViewChart(containerId, generatedBars, s);
}

function openChartModal(sym) {
  const d = APP.data;
  if (!d) return;

  const s = (d.fx_scan?.setups || []).find(item => item.symbol === sym);
  if (!s) return;

  currentActiveModalSymbol = sym;

  document.getElementById('modalSymbolTitle').textContent = s.symbol + ' (' + (s.base + '/' + s.quote) + ')';
  const qBadge = document.getElementById('modalQualityBadge');
  if (qBadge) {
    qBadge.className = 'badge badge-grade-' + s.trade_quality.toLowerCase().replace('+','-plus');
    qBadge.textContent = 'کلاس ' + s.trade_quality;
  }
  
  const iconEl = document.getElementById('modalAssetIcon');
  if (iconEl) {
    iconEl.textContent = s.base === 'BTC' ? '₿' : s.base === 'ETH' ? 'Ξ' : s.base === 'SOL' ? '◎' : s.symbol.includes('USD') ? '$' : '💱';
  }

  const biasColor = s.bias === 'long' ? 'var(--up)' : s.bias === 'short' ? 'var(--down)' : 'var(--muted)';
  const biasFa = s.bias === 'long' ? 'خرید (LONG)' : s.bias === 'short' ? 'فروش (SHORT)' : 'رنج و پایش';
  const curPrice = s.levels ? s.levels.current : '--';

  document.getElementById('modalPriceBar').innerHTML = `
    <div>قیمت زنده: <b style="color:var(--accent);font-size:13px">$${Number(curPrice).toLocaleString()}</b></div>
    <div>جهت پوزیشن: <b style="color:${biasColor}">${biasFa}</b></div>
    <div>ورود بهینه: <b style="font-variant-numeric:tabular-nums">${s.entry_low} - ${s.entry_high}</b></div>
    <div>حد سود: <b style="color:var(--up);font-variant-numeric:tabular-nums">${s.target1}</b></div>
    <div>حد ضرر: <b style="color:var(--down);font-variant-numeric:tabular-nums">${s.stop_loss}</b></div>
    <div>R:R: <b>1 : ${s.risk_reward}</b></div>
  `;

  const backdrop = document.getElementById('chartModalBackdrop');
  if (backdrop) backdrop.style.display = 'flex';

  setTimeout(() => {
    const bars = generateCandlesForTimeframe(s.history || [], s.levels ? s.levels.current : 1.0, '1d', s.bias === 'long', s.levels ? s.levels.atr_daily : 0.005);
    buildTradingViewChart('candlestickCanvas', bars, s);
  }, 40);
}

function closeChartModal() {
  const backdrop = document.getElementById('chartModalBackdrop');
  if (backdrop) backdrop.style.display = 'none';
  currentActiveModalSymbol = null;
}

