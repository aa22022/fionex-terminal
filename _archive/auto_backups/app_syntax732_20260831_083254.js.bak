function setGoldStudioTf(tf) {
  activeGoldTf = tf.toLowerCase();
  document.querySelectorAll('#goldStudioTfs .btn').forEach(b => {
    b.classList.toggle('active', b.textContent.trim().toLowerCase() === tf.toLowerCase());
