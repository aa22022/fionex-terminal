/* ========================================================================= */
/* GLOBAL STATE & CONFIGURATION (Memory Optimized)                           */
/* ========================================================================= */
const APP = {
  data: null,
  charts: {},       // نگهداری امن نمونه‌های فعال چارت‌های Chart.js و Lightweight Charts
  observers: {},    // ثبت و قطع اتصال ناظران ریسایز جهت جلوگیری از نشت حافظه
  currentPage: 'overview',
  lastFetch: 0
};

let currentHeatmapTf = '5d';
let currentWatchlistFilter = 'all';
let currentGoldStudioAsset = 'gold';
let currentFxStudioSymbol = 'EURUSD';
let activeGoldTf = '1d';
let activeFxTf = '1d';
let currentActiveModalSymbol = null;

/* ========================================================================= */
/* UTILITY, STRING CLEANING & SAFE PARSING                                   */
/* ========================================================================= */
function initChartDefaults() {
  try {
    if (typeof Chart !== 'undefined') {
      Chart.defaults.color = '#8a95a5';
      Chart.defaults.borderColor = '#1e2630';
      Chart.defaults.font.family = 'Vazirmatn';
      Chart.defaults.font.size = 10;
    }
  } catch(e) { console.warn("Chart defaults init failed:", e); }
}

function updateClock() {
  const el = document.getElementById('navTime');
  if (el) {
    const now = new Date();
    el.textContent = now.toLocaleTimeString('en-US', { hour12: false });
  }
}

// تخریب کاملاً امن و رهاسازی حافظه چارت‌ها و ناظران مربوطه
function destroyChart(id) {
  if (APP.charts[id]) {
    try {
      if (typeof APP.charts[id].destroy === 'function') {
        APP.charts[id].destroy(); // برای چارت‌های Chart.js
      } else if (typeof APP.charts[id].remove === 'function') {
        APP.charts[id].remove();  // برای چارت‌های Lightweight
      }
    } catch (e) {
      console.warn(`Error destroying chart instance (${id}):`, e);
    }
    APP.charts[id] = null;
  }
  
  // لغو اتصال ناظر ریسایز جهت بازپس‌گیری رم سیستم
  if (APP.observers[id]) {
    try {
      APP.observers[id].disconnect();
    } catch (e) {
      console.warn(`Error disconnecting ResizeObserver (${id}):`, e);
    }
    APP.observers[id] = null;
  }
}

function looksMojibake(str) {
  return typeof str === "string" && /Ãƒ|Ã˜|Ã™|Ã‚|Ã¢|â‚¬|â„¢|Å“|Å¾|Â¢/.test(str);
}

function latin1BytesToUtf8(str) {
  try {
    const bytes = Uint8Array.from(Array.from(str).map(ch => ch.charCodeAt(0) & 0xFF));
    return new TextDecoder("utf-8").decode(bytes);
  } catch { return str; }
}

function fixStr(str) {
  if (!looksMojibake(str)) return str;
  let cur = str;
  for (let i = 0; i < 4; i++) {
    const next = latin1BytesToUtf8(cur);
    if (next === cur) break;
    cur = next;
    if (!looksMojibake(cur)) break;
  }
  return cur;
}

function deepFix(obj) {
  if (obj === null || obj === undefined) return obj;
  if (typeof obj === "string") return fixStr(obj);
  if (Array.isArray(obj)) return obj.map(deepFix);
  if (typeof obj === "object") {
    const out = {};
    for (const [k, v] of Object.entries(obj)) out[k] = deepFix(v);
    return out;
  }
  return obj;
}

function fmt(n) {
  if (n === null || n === undefined || isNaN(n)) return '--';
  return Math.round(Number(n)).toLocaleString('fa-IR');
}

function fmtE(n, d = 2) {
  if (n === null || n === undefined || isNaN(n)) return '--';
  return Number(n).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}

function toShamsi(dateStr) {
  if (!dateStr) return dateStr;
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('fa-IR', { year: 'numeric', month: '2-digit', day: '2-digit' });
  } catch { return dateStr; }
}

function toShamsiShort(dateStr) {
  if (!dateStr) return dateStr;
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('fa-IR', { month: '2-digit', day: '2-digit' });
  } catch { return dateStr; }
}

function toShamsShortSafe(v) {
  try { return toShamsiShort(v); } catch { return v; }
}

function stripSpecial(str) {
  if (!str) return '';
  return String(str).replace(/[ \s]+/g, ' ').trim();
}

function getRegimeLabel(d) {
  const a = d.market_alert;
  if (!a || !a.level) return '--';
  if (a.level === 'HIGH') return 'پرنوسان';
  if (a.level === 'MEDIUM') return 'نوسان متوسط';
  return 'عادی';
}

/* ========================================================================= */
/* CORE API NETWORK LOGIC & PAGE ROUTER                                      */
/* ========================================================================= */
async function fetchData(force = false) {
  const now = Date.now();
  // کش موقت ۳۰ ثانیه‌ای جهت جلوگیری از بمباران ریکوئستی سرور جولیا
  if (!force && APP.data && (now - APP.lastFetch < 30000)) {
    return APP.data;
  }
  try {
    const loader = document.getElementById('globalLoader');
    if (loader) loader.style.display = 'block';
    
    const r = await fetch('/api/data?ts=' + now, { cache: 'no-store' });
    const raw = await r.json();
    if (raw && raw.status === "success") {
      APP.data = deepFix(raw);
      APP.lastFetch = Date.now();
    }
    
    if (loader) loader.style.display = 'none';
    return APP.data;
  } catch(e) {
    console.error("Critical error fetching system data:", e);
    const loader = document.getElementById('globalLoader');
    if (loader) loader.style.display = 'none';
    return null;
  }
}

async function doRefresh() {
  const refreshBtn = document.getElementById('btnRefresh');
  if (refreshBtn) refreshBtn.classList.add('loading-spin');
  try {
    const r = await fetch('/api/refresh', { method: 'GET', cache: 'no-store' });
    const res = await r.json();
    async if (res.status === 'success') {
      await fetchData(true);
      renderCurrentPage();
    } else {
      alert('خطا در به‌روزرسانی زنده: ' + res.message);
    }
  } catch(e) {
    console.error("Live refresh network exception:", e);
  } finally {
    if (refreshBtn) refreshBtn.classList.remove('loading-spin');
  }
}

function switchPage(pageId) {
  APP.currentPage = pageId;
  
  // مدیریت استایل تب فعال در منوی کناری دسکتاپ و ناوبری موبایل
  document.querySelectorAll('.nav-link').forEach(link => {
    const clickAttr = link.getAttribute('onclick');
    if (clickAttr && clickAttr.includes(pageId)) {
      link.classList.add('active');
    } else {
      link.classList.remove('active');
    }
  });

  // تعویض ویوها
  document.querySelectorAll('.page-section').forEach(sec => {
    if (sec.id === 'page-' + pageId) {
      sec.style.display = 'block';
    } else {
      sec.style.display = 'none';
    }
  });

  renderCurrentPage();
}

async function renderCurrentPage() {
  if (!APP.data) return;
  switch(APP.currentPage) {
    case 'overview': renderOverview(); break;
    case 'gold': renderGold(); break;
    case 'fx': renderFX(); break;
    case 'relations': renderRelations(); break;
    case 'backtest': renderBacktestDefault(); break;
    case 'reports': renderReports(); break;
  }
}

/* ========================================================================= */
/* WATCHLIST & STORAGE ENGINE                                                */
/* ========================================================================= */
function getWatchlist() {
  try {
    return JSON.parse(localStorage.getItem('trading_terminal_watchlist') || '[]');
  } catch { return []; }
}

function toggleWatchlist(sym, e) {
  if (e) e.stopPropagation();
  let list = getWatchlist();
  if (list.includes(sym)) {
    list = list.filter(s => s !== sym);
  } else {
    list.push(sym);
  }
  localStorage.setItem('trading_terminal_watchlist', JSON.stringify(list));
  updateWatchlistUI();
  renderFX();
}

async function updateWatchlistUI() {
  const list = getWatchlist();
  const el = document.getElementById('wlCount');
  if (el) el.textContent = list.length;
}

function setWatchlistFilter(mode) {
  currentWatchlistFilter = mode;
  document.getElementById('wlFilterAll')?.classList.toggle('active', mode === 'all');
  document.getElementById('wlFilterStarred')?.classList.toggle('active', mode === 'starred');
  renderFX();
}

