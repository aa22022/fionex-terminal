    <span id="sbRegime">حالت بازار: در حال شناسایی...</span>
  </div>
  <div class="status-item">
    <span id="sbSentiment">سنتیمنت خبری: --</span>
  </div>
  <div class="status-spacer"></div>
  <div class="status-item">
    <span>بروزرسانی خودکار دیتابیس: هر ۵ دقیقه</span>
  </div>
  <div class="status-item">
    <span>v6.0 Pro Enterprise</span>
  </div>
</footer>

<script src="/static/app.js"></script>

<!-- ========================================================= -->
<!-- Universal Fail-Safe Navigation Engine                      -->
<!-- ========================================================= -->
<script>
(function() {
    function initUniversalTabs() {
        console.log("Initializing Universal Tab Controller...");
        
        const tabMap = {
            "نمای کلی": "overview",
            "طلا و ارز": "gold",
            "طلا و ارز ایران": "gold",
            "اسکنر": "fx",
            "اسکنر فارکس": "fx",
            "اسکنر فارکس و کریپتو": "fx",
            "روابط": "relations",
            "روابط بازارها": "relations",
            "بک‌تست": "backtest",
            "بک‌تست و اعتبارسنجی": "backtest",
            "گزارش": "reports",
            "مرکز آنالیز": "reports",
            "مرکز آنالیز و گزارش‌ها": "reports"
        };

        const navSelectors = '.nav-link, .nav-item, .nav-btn, .tab-btn, .tab-link, .sidebar a, nav a, .sidebar button, nav button, [data-tab], [data-page], [data-target]';
        const navElements = document.querySelectorAll(navSelectors);
        const allSections = document.querySelectorAll('.tab-content, .page, .page-content, .tab-pane, section[id]');

        function switchTab(targetId, clickedEl) {
            if (!targetId) return;
            targetId = targetId.replace('#', '').trim();
            console.log("Switching to tab:", targetId);

            // ۱. غیرفعال کردن تمام کلاس‌های active از منوها
            navElements.forEach(el => {
                el.classList.remove('active');
                if (el.parentElement && el.parentElement.tagName === 'LI') {
                    el.parentElement.classList.remove('active');
                }
            });

            // ۲. فعال کردن المان کلیک‌شده
            if (clickedEl) {
                clickedEl.classList.add('active');
                if (clickedEl.parentElement && clickedEl.parentElement.tagName === 'LI') {
                    clickedEl.parentElement.classList.add('active');
                }
            }

            // ۳. پنهان کردن تمام صفحات و نمایش صفحه هدف
            allSections.forEach(sec => {
                const secId = sec.getAttribute('id');
                if (secId === targetId) {
                    sec.classList.add('active');
                    sec.style.display = '';
                } else if (sec.classList.contains('tab-content') || sec.classList.contains('page') || sec.classList.contains('tab-pane')) {
                    sec.classList.remove('active');
                }
            });

            // ۴. ارسال سیگنال تغییر اندازه جهت هماهنگی با نمودارها
            setTimeout(() => {
                window.dispatchEvent(new Event('resize'));
            }, 100);
        }

        // ثبت رویداد کلیک برای تمام المان‌های منو
        navElements.forEach(el => {
            el.addEventListener('click', function(e) {
                let targetId = this.getAttribute('data-tab') ||
                               this.getAttribute('data-page') ||
                               this.getAttribute('data-target') ||
                               this.getAttribute('href');

                if (!targetId || targetId === '#' || targetId === 'javascript:void(0)') {
                    const text = this.innerText.trim();
                    for (const key in tabMap) {
                        if (text.includes(key)) {
                            targetId = tabMap[key];
                            break;
                        }
                    }
                }

                if (targetId && targetId !== '#') {
                    e.preventDefault();
                    switchTab(targetId, this);
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUniversalTabs);
    } else {
        initUniversalTabs();
    }
})();
</script>
</body>
</html>