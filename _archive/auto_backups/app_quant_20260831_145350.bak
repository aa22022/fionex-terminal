// ================================================================
// 💎 FIONEX - Professional Persian Trading Terminal
// Gold Predictor v5.0
// ================================================================

window.appState = null;
let charts = {};

// ================================================================
// تقویم شمسی
// ================================================================
function gregorianToJalali(gy, gm, gd) {
    const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let jy = (gy <= 1600) ? 0 : 979;
    gy -= (gy <= 1600) ? 621 : 1600;
    const gy2 = (gm > 2) ? (gy + 1) : gy;
    let days = (365 * gy) + parseInt((gy2 + 3) / 4) - parseInt((gy2 + 99) / 100) + parseInt((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
    jy += 33 * parseInt(days / 12053);
    days %= 12053;
    jy += 4 * parseInt(days / 1461);
    days %= 1461;
    jy += parseInt((days - 1) / 365);
    if (days > 0) days = (days - 1) % 365;
    const jm = (days < 186) ? 1 + parseInt(days / 31) : 7 + parseInt((days - 186) / 30);
    const jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
    return [jy, jm, jd];
}

const PERSIAN_MONTHS = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];

function toPersianDate(dateStr, includeMonthName = false) {
    if (!dateStr) return "--";
    try {
        const cleanStr = String(dateStr).split("T")[0].split(" ")[0];
        const parts = cleanStr.split("-");
        if (parts.length < 3) return dateStr;
        const [jy, jm, jd] = gregorianToJalali(parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));
        if (includeMonthName) return `${jd} ${PERSIAN_MONTHS[jm - 1]} ${jy}`;
        return `${jy}/${String(jm).padStart(2, '0')}/${String(jd).padStart(2, '0')}`;
    } catch (e) { return dateStr; }
}

function fmtNum(num, digits = 2) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function fmtInt(num) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Math.round(Number(num)).toLocaleString('en-US');
}

function pctSign(v) { return v >= 0 ? '+' : ''; }

// ================================================================
// ساعت زنده
// ================================================================
function updateClock() {
    const el = document.getElementById("navTime");
    if (!el) return;
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const ss = String(now.getSeconds()).padStart(2, '0');
    el.innerText = `${hh}:${mm}:${ss}`;
}
setInterval(updateClock, 1000);

// ================================================================
// چارت‌ها
// ================================================================
function destroyChart(id) {
    if (charts[id]) { try { charts[id].destroy(); } catch (e) {} delete charts[id]; }
}

function renderLineChart(canvasId, labels, dataPoints, labelName, color, historicalDots = null) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    destroyChart(canvasId);

    const persianLabels = labels.map(d => toPersianDate(d));
    const canvasCtx = ctx.getContext('2d');
    const gradient = canvasCtx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, color + '50');
    gradient.addColorStop(1, color + '00');
    
    const datasets = [{
        label: labelName,
        data: dataPoints,
        borderColor: color,
        backgroundColor: gradient,
        borderWidth: 2,
        pointRadius: 0,
        pointHoverRadius: 6,
        pointBackgroundColor: color,
        pointBorderColor: '#0B0E14',
        pointBorderWidth: 2,
        tension: 0.3,
        fill: true
    }];

    if (historicalDots && historicalDots.length > 0) {
        const predVals = labels.map(d => {
            const m = historicalDots.find(x => x.target_date === d);
            return m ? m.predicted : null;
        });
        datasets.push({
            label: 'پیش‌بینی‌های ثبت‌شده',
            data: predVals,
            borderColor: '#FDE047',
            backgroundColor: '#FDE047',
            pointRadius: 7,
            pointHoverRadius: 10,
            pointBorderColor: '#0B0E14',
            pointBorderWidth: 2,
            showLine: false,
            fill: false
        });
    }

    charts[canvasId] = new Chart(ctx, {
        type: 'line',
        data: { labels: persianLabels, datasets: datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    align: 'end',
                    labels: {
                        color: '#9AA5C4',
                        font: { family: 'Vazirmatn', size: 11 },
                        padding: 10,
                        usePointStyle: true,
                        pointStyle: 'circle'
                    }
                },
                tooltip: {
                    backgroundColor: '#1A2030',
                    titleColor: '#06D6D6',
                    bodyColor: '#E4E9F5',
                    borderColor: '#06D6D6',
                    borderWidth: 1,
                    padding: 12,
                    cornerRadius: 6,
                    titleFont: { family: 'Vazirmatn', weight: '700' },
                    bodyFont: { family: 'Vazirmatn' }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(42, 51, 80, 0.5)', drawBorder: false },
                    ticks: { color: '#6B7699', font: { family: 'Vazirmatn', size: 10 }, maxTicksLimit: 8 }
                },
                y: {
                    grid: { color: 'rgba(42, 51, 80, 0.5)', drawBorder: false },
                    ticks: { color: '#6B7699', font: { family: 'Vazirmatn', size: 10 } }
                }
            }
        }
    });
}

// ================================================================
// تیکر بالای صفحه
// ================================================================
function updateTicker() {
    if (!window.appState) return;
    const cp = window.appState.current_prices;
    const tk = document.getElementById("tickerContent");
    if (!tk) return;
    
    const gh = window.appState.gold_history.prices;
    const uh = window.appState.usd_history.prices;
    const ih = window.appState.iran_gold_history.prices;
    
    function calcChange(arr) {
        if (!arr || arr.length < 2) return 0;
        return ((arr[arr.length - 1] - arr[arr.length - 2]) / arr[arr.length - 2]) * 100;
    }
    
    const items = [
        { sym: 'انس طلا', val: fmtNum(cp.gold_oz_usd), unit: ' USD', chg: calcChange(gh) },
        { sym: 'دلار تهران', val: fmtInt(cp.usd_irr), unit: ' تومان', chg: calcChange(uh) },
        { sym: 'طلای ۱۸', val: fmtInt(cp.iran_gold_gram18), unit: ' تومان', chg: calcChange(ih) },
        { sym: 'سکه امامی', val: fmtInt(cp.coin_emami), unit: ' تومان', chg: 0 },
        { sym: 'DXY', val: fmtNum(cp.dxy_real), unit: '', chg: 0 },
        { sym: 'US10Y', val: fmtNum(cp.us10y), unit: '%', chg: 0 },
        { sym: 'VIX', val: fmtNum(cp.vix), unit: '', chg: 0 }
    ];
    
    const html = (items.concat(items)).map(i => {
        const chgClass = i.chg >= 0 ? 'up' : 'down';
        const chgText = i.chg === 0 ? '' : `<span class="${chgClass}">${pctSign(i.chg)}${fmtNum(i.chg)}%</span>`;
        return `<span class="ticker-item"><span class="symbol">◆ ${i.sym}</span> <span class="value">${i.val}${i.unit}</span> ${chgText}</span>`;
    }).join('');
    
    tk.innerHTML = html;
}

