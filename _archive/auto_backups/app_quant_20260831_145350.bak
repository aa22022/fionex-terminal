    renderLineChart("chGold", gh.dates, gh.prices, "انس جهانی طلا (USD)", "#FDE047", hDots.gold_oz);
    renderLineChart("chUSD", uh.dates, uh.prices, "دلار تهران (تومان)", "#4ADE80", hDots.usd_irr);
    renderLineChart("chIran", ih.dates, ih.prices, "طلای ۱۸ عیار (تومان)", "#FB923C", hDots.iran_gold);
    
    const p = window.appState.prediction;
    const el = document.getElementById("goldPredGrid");
    if (el && p) {
        el.innerHTML = `
            <div class="pred-card">
                <h4>🎯 پیش‌بینی انس طلا</h4>
