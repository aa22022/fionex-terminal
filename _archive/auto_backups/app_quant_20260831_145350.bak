                <div class="row"><span class="lbl">کف:</span><span class="val">${fmtNum(p.gold_oz.low)}</span></div>
                <div class="row"><span class="lbl">سقف:</span><span class="val">${fmtNum(p.gold_oz.high)}</span></div>
            </div>
            <div class="pred-card">
                <h4>🎯 پیش‌بینی دلار تهران</h4>
                <div class="row"><span class="lbl">هدف:</span><span class="val">${fmtInt(p.usd_irr.point)}</span></div>
                <div class="row"><span class="lbl">کف:</span><span class="val">${fmtInt(p.usd_irr.low)}</span></div>
                <div class="row"><span class="lbl">سقف:</span><span class="val">${fmtInt(p.usd_irr.high)}</span></div>
            </div>
            <div class="pred-card">
                <h4>🎯 پیش‌بینی طلای ۱۸</h4>
                <div class="row"><span class="lbl">هدف:</span><span class="val">${fmtInt(p.iran_gold.point)}</span></div>
                <div class="row"><span class="lbl">کف:</span><span class="val">${fmtInt(p.iran_gold.low)}</span></div>
                <div class="row"><span class="lbl">سقف:</span><span class="val">${fmtInt(p.iran_gold.high)}</span></div>
            </div>
        `;
    }
}

// ================================================================
// فارکس و کریپتو
// ================================================================
// ================================================================
// توابع کمکی فرمت‌بندی ایمن و بدون خطا
// ================================================================
function fmtNum(num) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US');
}

function fmtDecimal(num, digits = 2) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function pctSign(num) {
    if (num === null || num === undefined || isNaN(num)) return "";
    return num > 0 ? "+" : "";
}

function fmtSmart(num) {
    if (num === null || num === undefined || isNaN(num) || num === 0) return "--";
    const n = Math.abs(num);
    if (n < 10) return Number(num).toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
    if (n < 1000) return Number(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return Math.round(Number(num)).toLocaleString('en-US');
}

function strengthColor(score) {
    if (score >= 75) return 'linear-gradient(90deg, #4ADE80, #22C55E)';
    if (score >= 60) return 'linear-gradient(90deg, #06D6D6, #22D3EE)';
    if (score >= 45) return 'linear-gradient(90deg, #FDE047, #FACC15)';
    if (score >= 30) return 'linear-gradient(90deg, #FB923C, #F97316)';
    return 'linear-gradient(90deg, #F87171, #EF4444)';
}

function biasClass(bias) {
    if (!bias) return 'neutral';
    const b = String(bias).toUpperCase();
    if (b.includes('BUY') || b.includes('صعودی')) return 'buy';
    if (b.includes('SELL') || b.includes('نزولی')) return 'sell';
    return 'neutral';
}

function gradeColor(quality) {
    if (quality === 'A+') return '#4ADE80';
    if (quality === 'A') return '#06D6D6';
    if (quality === 'B') return '#FDE047';
    if (quality === 'C') return '#FB923C';
    return '#F87171';
}

function renderProSetupCard(s) {
    try {
        const bias = (s.bias || '').toUpperCase();
        const biasClassCard = bias === 'BUY' ? 'buy' : bias === 'SELL' ? 'sell' : 'neutral';
        const biasIcon = bias === 'BUY' ? '📈' : bias === 'SELL' ? '📉' : '➖';
        const biasText = bias === 'BUY' ? 'خرید' : bias === 'SELL' ? 'فروش' : 'خنثی';
        const gradeCol = gradeColor(s.trade_quality || 'B');
        const confidence = s.confidence || 50;

        return `
            <div class="pro-setup-card ${biasClassCard}">
                <div class="pro-setup-header">
                    <div class="pro-symbol-block">
                        <span class="pro-symbol">${s.symbol}</span>
                        <span class="pro-bias-badge ${biasClassCard}">${biasIcon} ${biasText}</span>
                    </div>
                    <div class="pro-grade" style="background: ${gradeCol}; color: #0B0E14">
                        ${s.trade_quality || 'B'}
                    </div>
                </div>

                <div class="pro-confidence">
                    <div class="confidence-label">درصد اطمینان:</div>
                    <div class="confidence-bar">
                        <div class="confidence-fill" style="width: ${confidence}%; background: ${gradeCol}"></div>
                    </div>
                    <div class="confidence-value">${fmtDecimal(confidence, 1)}%</div>
                </div>

                <div class="pro-setup-body">
                    <div class="pro-metric">
                        <span class="lbl">💵 ناحیه ورود:</span>
                        <span class="val">${fmtSmart(s.entry_low)} - ${fmtSmart(s.entry_high)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🎯 تارگت ۱:</span>
                        <span class="val up">${fmtSmart(s.target1)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🎯 تارگت ۲:</span>
                        <span class="val up">${fmtSmart(s.target2)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🛑 حد ضرر:</span>
                        <span class="val down">${fmtSmart(s.stop_loss)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">⚖️ نسبت R/R:</span>
                        <span class="val gold">${fmtDecimal(s.risk_reward, 2)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🕐 تایم‌فریم:</span>
                        <span class="val">${s.timeframe_align || '1D'}</span>
                    </div>
                </div>

                ${(s.reasons_for && s.reasons_for.length > 0) ? `
                    <div class="pro-reasons">
                        <div class="reasons-title">✅ دلایل تحلیلی:</div>
                        ${s.reasons_for.slice(0, 3).map(r => `<div class="reason-item">• ${r}</div>`).join('')}
                    </div>
                ` : ''}
            </div>
        `;
    } catch (e) {
        console.error("خطا در رندر کارت ستاپ:", e);
        return '';
    }
}

// ================================================================
// تابع رندر اسکنر فارکس و کریپتو (F3)
// ================================================================
function renderFX() {
    try {
        if (!window.appState || !window.appState.fx_scan) return;
        const scan = window.appState.fx_scan;
        const setups = scan.setups || [];
        const strengths = scan.strengths || [];

        const fxEl = document.getElementById("fxSetups");
        const cryptoEl = document.getElementById("cryptoSetups");
        if (!fxEl) return;

        // ساخت پنل قدرت ارزها در بالای بخش فارکس
        let strengthHtml = '';
        if (strengths.length > 0) {
            strengthHtml = `
                <div class="strength-panel">
                    <div class="strength-title">
                        <span>⚡ قدرت لحظه‌ای ارزها (Currency Strength Meter)</span>
                        <span class="strength-legend">قوی‌ترین → ضعیف‌ترین</span>
                    </div>
                    <div class="strength-grid">
                        ${strengths.map((s, i) => `
                            <div class="strength-card rank-${i + 1}">
                                <div class="strength-rank">#${i + 1}</div>
                                <div class="strength-symbol">${s.currency}</div>
                                <div class="strength-name">${s.name_fa || s.currency}</div>
                                <div class="strength-stars">${s.strength_level || '⭐⭐⭐'}</div>
                                <div class="strength-score-bar">
                                    <div class="score-fill" style="width: ${s.score || 50}%; background: ${strengthColor(s.score || 50)}"></div>
                                </div>
                                <div class="strength-score-num">${fmtDecimal(s.score, 1)}%</div>
                                <div class="strength-bias ${biasClass(s.trend_bias)}">${s.trend_bias || 'خنثی'}</div>
                                <div class="strength-momentum">
                                    <span>۵ روزه:</span>
                                    <span class="${(s.momentum_5d || 0) >= 0 ? 'up' : 'down'}">${pctSign(s.momentum_5d)}${fmtDecimal(s.momentum_5d, 2)}%</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    ${strengths.length >= 2 ? `
                    <div class="best-pair-panel">
                        <span class="best-pair-label">🎯 بهترین ترکیب معاملاتی امروز:</span>
                        <span class="best-pair-value">${strengths[0].currency}/${strengths[strengths.length - 1].currency}</span>
                        <span class="best-pair-hint">(خرید قوی‌ترین در برابر ضعیف‌ترین)</span>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        // تفکیک ستاپ‌های فارکس و کریپتو
        const fxSetups = setups.filter(s => s.category !== "crypto");
        const cryptoSetups = setups.filter(s => s.category === "crypto");

        fxEl.innerHTML = strengthHtml + `
            <div class="setups-cards-grid">
                ${fxSetups.length === 0
                    ? '<div class="no-setup-msg">در حال حاضر ستاپ فعالی برای فارکس یافت نشد.</div>'
                    : fxSetups.map(s => renderProSetupCard(s)).join('')}
            </div>
        `;

        if (cryptoEl) {
            cryptoEl.innerHTML = `
                <div class="setups-cards-grid">
                    ${cryptoSetups.length === 0
                        ? '<div class="no-setup-msg">در حال حاضر ستاپ فعالی برای کریپتو یافت نشد.</div>'
                        : cryptoSetups.map(s => renderProSetupCard(s)).join('')}
                </div>
            `;
        }
    } catch (e) {
        console.error("خطا در رندر تب F3:", e);
    }
}

function renderRelations() {
    if (!window.appState || !window.appState.relationships) return;
    const rels = window.appState.relationships.relations || [];
    const container = document.getElementById("corrTbl");
    if (!container) return;
    container.innerHTML = `
        <thead>
            <tr>
                <th>دارایی</th>
                <th>همبستگی ۲۰ روزه</th>
                <th>همبستگی ۶۰ روزه</th>
                <th>بتا</th>
                <th>قدرت رابطه</th>
            </tr>
        </thead>
        <tbody>
            ${rels.map(r => `
                <tr>
                    <td>${r.asset_b}</td>
                    <td class="num ${r.pearson_20d >= 0 ? 'up' : 'down'}">${fmtNum(r.pearson_20d)}</td>
                    <td class="num ${r.pearson_60d >= 0 ? 'up' : 'down'}">${fmtNum(r.pearson_60d)}</td>
                    <td class="num">${fmtNum(r.beta_30d)}</td>
                    <td>${r.strength}</td>
                </tr>
            `).join("")}
        </tbody>
    `;
}

// ================================================================
// بک‌تست
// ================================================================
function renderBacktestDefault() {
    if (!window.appState || !window.appState.backtest) return;
    const bt = window.appState.backtest;
    const el = document.getElementById("btStats");
    if (!el) return;
    el.innerHTML = `
        <div class="kpi-card">
            <h4>📅 دوره بک‌تست</h4>
            <div class="value">${bt.total_days || bt.days_used || 60}<span class="unit">روز</span></div>
        </div>
        <div class="kpi-card">
            <h4>🎯 MAPE انس طلا</h4>
            <div class="value">${fmtNum(bt.gold_mape)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>🎯 MAPE دلار</h4>
            <div class="value">${fmtNum(bt.usd_mape)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>🎯 MAPE طلای ۱۸</h4>
            <div class="value">${fmtNum(bt.iran_mape)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>🧭 صحت جهت انس</h4>
            <div class="value up">${fmtNum(bt.gold_direction_accuracy || bt.direction_accuracy || 0)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>🧭 صحت جهت دلار</h4>
            <div class="value up">${fmtNum(bt.usd_direction_accuracy || 0)}<span class="unit">%</span></div>
        </div>
    `;
}

// ================================================================
// گزارش‌ها
// ================================================================
function renderReports() {
    if (!window.appState) return;
    const j = window.appState.trade_journal || {};
    const el = document.getElementById("journalStatsWidget");
    if (!el) return;
    el.innerHTML = `
        <div class="kpi-card">
            <h4>🏆 نرخ برد</h4>
            <div class="value up">${fmtNum(j.win_rate || 0)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>💎 فاکتور سود</h4>
            <div class="value">${fmtNum(j.profit_factor || 0)}</div>
        </div>
        <div class="kpi-card">
            <h4>📊 تعداد معاملات</h4>
            <div class="value">${j.total_trades || 0}</div>
        </div>
    `;
}

// ================================================================
// ناوبری
// ================================================================
function renderCurrentPage() {
    const activeTab = document.querySelector(".nav-btn.active");
    if (!activeTab) { renderOverview(); return; }
    const pageId = activeTab.getAttribute("data-page");
    if (pageId === "page-overview") renderOverview();
    else if (pageId === "page-gold") renderGold();
    else if (pageId === "page-fx") renderFX();
    else if (pageId === "page-relations") renderRelations();
    else if (pageId === "page-backtest") renderBacktestDefault();
    else if (pageId === "page-reports") renderReports();
}

async function loadData() {
    try {
        const t0 = performance.now();
        const resp = await fetch("/api/data");
        if (resp.ok) {
            window.appState = await resp.json();
            renderCurrentPage();
            
            const ping = Math.round(performance.now() - t0);
            const pingEl = document.getElementById("pingMs");
            if (pingEl) pingEl.innerText = ping;
            
            const lastUp = document.getElementById("lastUp");
            if (lastUp && window.appState.last_update) {
                lastUp.innerText = toPersianDate(window.appState.last_update, true);
            }
        }
    } catch (e) { console.error("خطا:", e); }
}

async function refreshData() {
    try { await fetch("/api/refresh"); await loadData(); } catch (e) {}
}

// کیبورد شرت‌کات
document.addEventListener("keydown", (e) => {
    const keys = { F1: 'page-overview', F2: 'page-gold', F3: 'page-fx', F4: 'page-relations', F5: 'page-backtest', F6: 'page-reports' };
    if (keys[e.key]) {
        e.preventDefault();
        const btn = document.querySelector(`.nav-btn[data-page="${keys[e.key]}"]`);
        if (btn) btn.click();
    }
});

document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll(".nav-btn");
    btns.forEach(btn => {
        btn.addEventListener("click", () => {
            btns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            document.querySelectorAll(".page-section").forEach(p => {
                p.classList.remove("active");
                p.style.display = "none";
            });
            const targetPage = btn.getAttribute("data-page");
            const pageEl = document.getElementById(targetPage);
            if (pageEl) { pageEl.classList.add("active"); pageEl.style.display = "block"; }
            renderCurrentPage();
        });
    });

    const refreshBtn = document.getElementById("btnRefresh");
    if (refreshBtn) refreshBtn.addEventListener("click", refreshData);
    
    updateClock();
    loadData();
    setInterval(loadData, 45000);
});