// ═════════════════════════════════════════════════════════════════
// 🏦 Fionex Terminal v5.0 - Frontend Engine
// ═════════════════════════════════════════════════════════════════

console.log("✅ app.js لود شد");

const FionexApp = {
    config: {
        apiEndpoint: '/api/data',
        refreshInterval: 5000,
        chartColors: {
            gold: '#FFD700',
            dollar: '#2E7D32',
            positive: '#4CAF50',
            negative: '#F44336',
            neutral: '#FF9800'
        }
    },

    data: {
        prices: {},
        history: {},
        forecast: {}
    },

    // 🚀 راه‌اندازی اپلیکیشن
    init: function() {
        console.log('🚀 Fionex راه‌اندازی شد...');
        
        if (typeof Chart === 'undefined') {
            console.error('❌ Chart.js بارگذاری نشد!');
            return;
        }

        this.setupTabEvents();
        this.loadData();
        
        setInterval(() => this.loadData(), this.config.refreshInterval);
        
        console.log('✅ Fionex آماده است');
    },

    // 🔄 بارگذاری داده‌های API
    loadData: function() {
        const self = this;
        fetch(this.config.apiEndpoint)
            .then(response => {
                if (!response.ok) throw new Error('HTTP ' + response.status);
                return response.json();
            })
            .then(data => {
                self.data.prices = data;
                console.log('📥 داده‌ها بروز شد:', data);
                self.renderCurrentTab();
            })
            .catch(error => {
                console.error('❌ خطا در بارگذاری داده‌ها:', error);
            });
    },

    // 🎛️ مدیریت Tabs
    setupTabEvents: function() {
        const tabs = document.querySelectorAll('.tab-button');
        const self = this;
        
        tabs.forEach(tab => {
            tab.addEventListener('click', function(e) {
                const tabNum = e.target.dataset.tab;
                self.switchTab(tabNum);
            });
        });
        
        this.switchTab('1');
    },

    switchTab: function(tabNum) {
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.style.display = 'none';
        });
        
        const activeTab = document.getElementById('tab' + tabNum);
        if (activeTab) {
            activeTab.style.display = 'block';
            console.log('📑 تب ' + tabNum + ' فعال شد');
            this.renderTabContent(tabNum);
        }
    },

    renderCurrentTab: function() {
        const activeTab = document.querySelector('.tab-content[style*="display: block"]');
        if (activeTab) {
            const tabNum = activeTab.id.replace('tab', '');
            this.renderTabContent(tabNum);
        }
    },

    // 📑 رندر محتوای هر تب
    renderTabContent: function(tabNum) {
        switch(tabNum) {
            case '1':
                this.renderDashboardOverview();
                break;
            case '2':
                this.renderGoldDollarAnalysis();
                break;
            case '3':
                this.renderCorrelationAnalysis();
                break;
            case '4':
                this.renderBacktestValidation();
                break;
        }
    },

    // ═══════════════════════════════════════════════════════════
    // F1: نمای کلی بازار
    // ═══════════════════════════════════════════════════════════
    renderDashboardOverview: function() {
        const prices = this.data.prices;
        const container = document.getElementById('dashboard-overview');
        
        if (!container) {
            console.warn('⚠️ #dashboard-overview یافت نشد');
            return;
        }

        const goldOunce = prices.gold_ounce || 'N/A';
        const gold18 = prices.gold_18 || 'N/A';
        const dollarPrice = prices.dollar || 'N/A';
        const tetherusd = prices.tether_usd || 'N/A';

        const html = '<div class="kpi-grid">' +
            '<div class="kpi-card">' +
            '<h3>📊 انس جهانی طلا</h3>' +
            '<p class="price">' + this.formatPrice(goldOunce, '$') + '</p>' +
            '<span class="change positive">↑ ۲.۵٪</span>' +
            '</div>' +
            
            '<div class="kpi-card">' +
            '<h3>🪙 طلای ۱۸ عیار</h3>' +
            '<p class="price">' + this.formatPrice(gold18, '₽') + '</p>' +
            '<span class="change positive">↑ ۱.۲٪</span>' +
            '</div>' +
            
            '<div class="kpi-card">' +
            '<h3>💵 دلار آزاد</h3>' +
            '<p class="price">' + this.formatPrice(dollarPrice, 'ت') + '</p>' +
            '<span class="change negative">↓ ۰.۸٪</span>' +
            '</div>' +
            
            '<div class="kpi-card">' +
            '<h3>🔗 تتر USD</h3>' +
            '<p class="price">' + this.formatPrice(tetherusd, 'ت') + '</p>' +
            '<span class="change neutral">→ ۰.۰٪</span>' +
            '</div>' +
            '</div>' +

            '<div class="charts-row">' +
            '<div class="chart-container">' +
            '<h3>نمودار طلا</h3>' +
            '<canvas id="goldTrendChart"></canvas>' +
            '</div>' +
            
            '<div class="chart-container">' +
            '<h3>فشار بازار</h3>' +
            '<canvas id="marketPressureGauge"></canvas>' +
            '</div>' +
            '</div>' +

            '<div class="heatmap-section">' +
            '<h3>🔥 نقشه حرارتی بازدهی</h3>' +
            '<div id="heatmapContainer" class="heatmap"></div>' +
            '</div>' +

            '<div class="events-section">' +
            '<h3>📅 تقویم رویدادها</h3>' +
            '<div id="eventCalendar" class="calendar"></div>' +
            '</div>';

        container.innerHTML = html;

        this.drawGoldTrendChart();
        this.drawMarketPressureGauge();
        this.drawHeatmap();
        this.drawEventCalendar();
    },

    drawGoldTrendChart: function() {
        const canvas = document.getElementById('goldTrendChart');
        if (!canvas) {
            console.warn('⚠️ goldTrendChart Canvas یافت نشد');
            return;
        }

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['روز ۱', 'روز ۲', 'روز ۳', 'روز ۴', 'روز ۵'],
                    datasets: [{
                        label: 'قیمت انس (USD)',
                        data: [2400, 2410, 2405, 2420, 2415],
                        borderColor: this.config.chartColors.gold,
                        backgroundColor: 'rgba(255, 215, 0, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { labels: { font: { size: 12 } } }
                    }
                }
            });
            console.log('✅ نمودار طلا رسم شد');
        } catch(e) {
            console.error('❌ خطا در رسم نمودار طلا:', e);
        }
    },

    drawMarketPressureGauge: function() {
        const canvas = document.getElementById('marketPressureGauge');
        if (!canvas) {
            console.warn('⚠️ marketPressureGauge Canvas یافت نشد');
            return;
        }

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['فشار خرید', 'فشار فروش', 'تعادل'],
                    datasets: [{
                        data: [35, 40, 25],
                        backgroundColor: [
                            this.config.chartColors.positive,
                            this.config.chartColors.negative,
                            this.config.chartColors.neutral
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
            console.log('✅ نمودار فشار رسم شد');
        } catch(e) {
            console.error('❌ خطا در رسم نمودار فشار:', e);
        }
    },

    drawHeatmap: function() {
        const container = document.getElementById('heatmapContainer');
        if (!container) {
            console.warn('⚠️ heatmapContainer یافت نشد');
            return;
        }

        container.innerHTML = '<table class="heatmap-table">' +
            '<tr>' +
            '<td style="background-color:#4CAF50">طلا</td>' +
            '<td style="background-color:#8BC34A">دلار</td>' +
            '<td style="background-color:#FFC107">سکه</td>' +
            '<td style="background-color:#FF5722">کریپتو</td>' +
            '</tr>' +
            '<tr>' +
            '<td>+۳.۲٪</td>' +
            '<td>-۰.۵٪</td>' +
            '<td>+۱.۸٪</td>' +
            '<td>+۲۴٪</td>' +
            '</tr>' +
            '</table>';
        
        console.log('✅ نقشه حرارتی رسم شد');
    },

    drawEventCalendar: function() {
        const container = document.getElementById('eventCalendar');
        if (!container) {
            console.warn('⚠️ eventCalendar یافت نشد');
            return;
        }

        let html = '<div class="calendar-grid">';
        
        const events = [
            { date: 15, title: 'اعلام تصمیم بانک مرکزی' },
            { date: 20, title: 'انتشار گزارش تورم' }
        ];

        for (let day = 1; day <= 28; day++) {
            const event = events.find(e => e.date === day);
            const className = event ? 'event-day' : '';
            html += '<div class="calendar-day ' + className + '">' + day;
            if (event) {
                html += '<small>' + event.title + '</small>';
            }
            html += '</div>';
        }

        html += '</div>';
        container.innerHTML = html;
        console.log('✅ تقویم رسم شد');
    },

    // ═══════════════════════════════════════════════════════════
    // F2: طلا و ارز ایران
    // ═══════════════════════════════════════════════════════════
    renderGoldDollarAnalysis: function() {
        const container = document.getElementById('gold-dollar-analysis');
        
        if (!container) {
            console.warn('⚠️ #gold-dollar-analysis یافت نشد');
            return;
        }

        container.innerHTML = '<div class="analysis-header">' +
            '<h2>📊 تحلیل طلا و ارز ایران</h2>' +
            '<p>قیمت‌های لحظه‌ای و پیش‌بینی چندپله‌ای</p>' +
            '</div>' +

            '<div class="charts-row">' +
            '<div class="chart-container">' +
            '<h3>قیمت طلا (انس)</h3>' +
            '<canvas id="goldPriceChart"></canvas>' +
            '</div>' +
            
            '<div class="chart-container">' +
            '<h3>قیمت دلار تهران</h3>' +
            '<canvas id="dollarChart"></canvas>' +
            '</div>' +
            '</div>' +

            '<div class="forecast-section">' +
            '<h3>🔮 پیش‌بینی چندپله‌ای</h3>' +
            '<div id="forecastTable" class="forecast-table"></div>' +
            '</div>';

        this.drawGoldPriceChart();
        this.drawDollarChart();
        this.drawForecastTable();
    },

    drawGoldPriceChart: function() {
        const canvas = document.getElementById('goldPriceChart');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['۱ روز', '۳ روز', '۷ روز', '۳۰ روز'],
                    datasets: [{
                        label: 'قیمت واقعی',
                        data: [4450, 4465, 4480, 4510],
                        borderColor: this.config.chartColors.gold,
                        borderWidth: 2,
                        pointRadius: 5,
                        fill: false
                    }, {
                        label: 'پیش‌بینی',
                        data: [4452, 4470, 4490, 4520],
                        borderColor: '#2196F3',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 5,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true }
                    }
                }
            });
            console.log('✅ نمودار قیمت طلا رسم شد');
        } catch(e) {
            console.error('❌ خطا در نمودار قیمت طلا:', e);
        }
    },

    drawDollarChart: function() {
        const canvas = document.getElementById('dollarChart');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['۱ روز', '۳ روز', '۷ روز', '۳۰ روز'],
                    datasets: [{
                        label: 'قیمت دلار (ریال)',
                        data: [207000, 207500, 208000, 209000],
                        backgroundColor: this.config.chartColors.dollar,
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true
                }
            });
            console.log('✅ نمودار دلار رسم شد');
        } catch(e) {
            console.error('❌ خطا در نمودار دلار:', e);
        }
    },

    drawForecastTable: function() {
        const container = document.getElementById('forecastTable');
        if (!container) return;

        container.innerHTML = '<table>' +
            '<thead><tr><th>دوره</th><th>قیمت پیش‌بینی (USD)</th><th>دقت</th><th>شماتیک</th></tr></thead>' +
            '<tbody>' +
            '<tr><td>۱ روز</td><td>۴۴۵۲ $</td><td>۹۲٪</td><td>📈</td></tr>' +
            '<tr><td>۳ روز</td><td>۴۴۷۰ $</td><td>۸۸٪</td><td>📈</td></tr>' +
            '<tr><td>۷ روز</td><td>۴۴۹۰ $</td><td>۸۲٪</td><td>📈</td></tr>' +
            '<tr><td>۳۰ روز</td><td>۴۵۲۰ $</td><td>۷۵٪</td><td>📈</td></tr>' +
            '</tbody>' +
            '</table>';
        
        console.log('✅ جدول پیش‌بینی رسم شد');
    },

    // ═══════════════════════════════════════════════════════════
    // F3: تحلیل روابط بازارها
    // ═══════════════════════════════════════════════════════════
    renderCorrelationAnalysis: function() {
        const container = document.getElementById('correlation-analysis');
        
        if (!container) {
            console.warn('⚠️ #correlation-analysis یافت نشد');
            return;
        }

        container.innerHTML = '<div class="analysis-header">' +
            '<h2>🔗 تحلیل همبستگی و روابط</h2>' +
            '</div>' +

            '<div class="chart-container">' +
            '<h3>گراف شبکه</h3>' +
            '<div id="networkGraph" class="network-graph"></div>' +
            '</div>' +

            '<div class="arbitrage-section">' +
            '<h3>💰 فرصت‌های آربیتراژ</h3>' +
            '<div id="arbitrageTable"></div>' +
            '</div>';

        this.drawNetworkGraph();
        this.drawArbitrageTable();
    },

    drawNetworkGraph: function() {
        const container = document.getElementById('networkGraph');
        if (!container) return;

        container.innerHTML = '<svg width="100%" height="300" viewBox="0 0 400 300">' +
            '<line x1="50" y1="50" x2="350" y2="50" stroke="#ccc" stroke-width="2"/>' +
            '<line x1="50" y1="50" x2="200" y2="250" stroke="#ccc" stroke-width="2"/>' +
            '<line x1="350" y1="50" x2="200" y2="250" stroke="#ccc" stroke-width="2"/>' +
            '<circle cx="50" cy="50" r="20" fill="#FFD700" stroke="#333" stroke-width="2"/>' +
            '<text x="50" y="55" text-anchor="middle" font-size="12">طلا</text>' +
            '<circle cx="350" cy="50" r="20" fill="#2E7D32" stroke="#333" stroke-width="2"/>' +
            '<text x="350" y="55" text-anchor="middle" font-size="12" fill="white">دلار</text>' +
            '<circle cx="200" cy="250" r="20" fill="#FF5722" stroke="#333" stroke-width="2"/>' +
            '<text x="200" y="255" text-anchor="middle" font-size="11" fill="white">کریپتو</text>' +
            '</svg>';
        
        console.log('✅ گراف شبکه رسم شد');
    },

    drawArbitrageTable: function() {
        const container = document.getElementById('arbitrageTable');
        if (!container) return;

        container.innerHTML = '<table>' +
            '<thead><tr><th>جفت معاملاتی</th><th>بازدهی</th><th>حجم</th><th>وضعیت</th></tr></thead>' +
            '<tbody>' +
            '<tr class="profitable">' +
            '<td>طلا (Nobitex) ↔ طلا (TGJU)</td>' +
            '<td>+۰.۸٪</td>' +
            '<td>۵۰۰ گرم</td>' +
            '<td>🟢 سودآور</td>' +
            '</tr>' +
            '<tr>' +
            '<td>دلار (تتر) ↔ دلار (نوبیتکس)</td>' +
            '<td>-۰.۲٪</td>' +
            '<td>۱۰۰۰ $</td>' +
            '<td>🔴 ضرر</td>' +
            '</tr>' +
            '</tbody>' +
            '</table>';
        
        console.log('✅ جدول آربیتراژ رسم شد');
    },

    // ═══════════════════════════════════════════════════════════
    // F4: بک‌تست و اعتبارسنجی
    // ═══════════════════════════════════════════════════════════
    renderBacktestValidation: function() {
        const container = document.getElementById('backtest-validation');
        
        if (!container) {
            console.warn('⚠️ #backtest-validation یافت نشد');
            return;
        }

        container.innerHTML = '<div class="analysis-header">' +
            '<h2>🧪 بک‌تست و اعتبارسنجی مدل</h2>' +
            '</div>' +

            '<div class="charts-row">' +
            '<div class="chart-container">' +
            '<h3>پیش‌بینی vs واقعیت</h3>' +
            '<canvas id="backTestChart"></canvas>' +
            '</div>' +
            
            '<div class="chart-container">' +
            '<h3>توزیع خطاها</h3>' +
            '<canvas id="errorHistogram"></canvas>' +
            '</div>' +
            '</div>' +

            '<div class="metrics-section">' +
            '<h3>📈 معیارهای کارایی</h3>' +
            '<div id="metricsTable"></div>' +
            '</div>';

        this.drawBackTestChart();
        this.drawErrorHistogram();
        this.drawMetricsTable();
    },

    drawBackTestChart: function() {
        const canvas = document.getElementById('backTestChart');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['روز ۱', 'روز ۲', 'روز ۳', 'روز ۴', 'روز ۵'],
                    datasets: [{
                        label: 'قیمت واقعی',
                        data: [4400, 4420, 4410, 4430, 4450],
                        borderColor: this.config.chartColors.negative,
                        borderWidth: 3,
                        fill: false
                    }, {
                        label: 'پیش‌بینی مدل',
                        data: [4405, 4415, 4425, 4435, 4445],
                        borderColor: this.config.chartColors.positive,
                        borderWidth: 2,
                        borderDash: [5, 5],
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true }
                    }
                }
            });
            console.log('✅ نمودار بک‌تست رسم شد');
        } catch(e) {
            console.error('❌ خطا در نمودار بک‌تست:', e);
        }
    },

    drawErrorHistogram: function() {
        const canvas = document.getElementById('errorHistogram');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        
        try {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['-۵ تا -۱', '-۱ تا ۰', '۰ تا ۱', '۱ تا ۵'],
                    datasets: [{
                        label: 'فراوانی خطا (%)',
                        data: [15, 35, 40, 10],
                        backgroundColor: this.config.chartColors.positive
                    }]
                },
                options: {
                    responsive: true
                }
            });
            console.log('✅ هیستوگرام خطا رسم شد');
        } catch(e) {
            console.error('❌ خطا در هیستوگرام:', e);
        }
    },

    drawMetricsTable: function() {
        const container = document.getElementById('metricsTable');
        if (!container) return;

        container.innerHTML = '<table>' +
            '<tbody>' +
            '<tr><td><strong>RMSE</strong></td><td>۲۳.۴۵ USD</td><td>📊 متوسط</td></tr>' +
            '<tr><td><strong>MAE</strong></td><td>۱۸.۷۲ USD</td><td>📊 خوب</td></tr>' +
            '<tr><td><strong>R² Score</strong></td><td>۰.۸۹</td><td>📈 عالی</td></tr>' +
            '<tr><td><strong>دقت پیش‌بینی</strong></td><td>۸۷٪</td><td>🎯 قابل‌قبول</td></tr>' +
            '</tbody>' +
            '</table>';
        
        console.log('✅ جدول معیارها رسم شد');
    },

    // 🛠️ توابع کمکی
    formatPrice: function(price, currency) {
        if (price === 'N/A' || !price) return 'بدون‌داده';
        
        const num = parseFloat(price);
        if (isNaN(num)) return price;
        
        return num.toLocaleString('fa-IR') + ' ' + currency;
    }
};

// 🚀 شروع اپلیکیشن هنگام بارگذاری صفحه
document.addEventListener('DOMContentLoaded', function() {
    console.log('📄 صفحه بارگذاری شد');
    FionexApp.init();
});