// ================================================================
// مدیریت چندگانه نمودارها (Chart.js Wrapper)
// ================================================================
function renderMultiChart(canvasId, labels, data, label, color) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    
    if (window.multiCharts[canvasId]) {
        window.multiCharts[canvasId].destroy();
    }
    
    window.multiCharts[canvasId] = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: label,
                data: data,
                borderColor: color,
                backgroundColor: color + '15',
                borderWidth: 2,
                pointRadius: 0,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: true, labels: { color: '#94A3B8' } } },
            scales: {
                x: { ticks: { color: '#64748B', maxTicksLimit: 8 }, grid: { color: '#1E293B' } },
                y: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } }
            }
        }
    });
}


// محاسبه دقیق بازدهی آماری
function calcReturn(prices, days) {
    if (!prices || prices.length < days + 1) return 0;
    const cur = prices[prices.length - 1];
    const prev = prices[prices.length - 1 - days];
    if (prev === 0 || !prev) return 0;
    return ((cur - prev) / prev) * 100;
}

// ================================================================
// 🔥 رندر نقشه حرارتی بازدهی دارایی‌ها (۱ روزه / ۵ روزه / ۲۰ روزه)
// ================================================================
function renderHeatmap() {
    const el = document.getElementById("marketHeatmap");
    if (!el || !window.appState) return;
    const s = window.appState;
    
    const goldPrices = s.gold_history ? s.gold_history.prices : [];
    const usdPrices = s.usd_history ? s.usd_history.prices : [];
    const iranPrices = s.iran_gold_history ? s.iran_gold_history.prices : [];
    const btcPrices = s.btc_history ? s.btc_history.prices : [];
    const ethPrices = s.eth_history ? s.eth_history.prices : [];
    const solPrices = s.sol_history ? s.sol_history.prices : [];

    const assets = [
        { name: "💰 انس جهانی طلا", p: goldPrices },
        { name: "💵 دلار آزاد تهران", p: usdPrices },
        { name: "🥇 طلای ۱۸ عیار", p: iranPrices },
        { name: "₿ بیت‌کوین", p: btcPrices },
        { name: "Ξ اتریوم", p: ethPrices },
        { name: "☀️ سولانا", p: solPrices }
    ];

    const cellColor = (val) => {
        if (val > 1.5) return "rgba(34, 197, 94, 0.25)";
        if (val > 0) return "rgba(34, 197, 94, 0.12)";
        if (val < -1.5) return "rgba(239, 68, 68, 0.25)";
        if (val < 0) return "rgba(239, 68, 68, 0.12)";
        return "rgba(100, 116, 139, 0.1)";
    };

    const cellTextClass = (val) => val >= 0 ? "up" : "down";

    el.innerHTML = assets.map(a => {
        const r1 = calcReturn(a.p, 1);
        const r5 = calcReturn(a.p, 5);
        const r20 = calcReturn(a.p, 20);

        return `
            <div class="heatmap-row">
                <div class="heatmap-cell asset-label">${a.name}</div>
                <div class="heatmap-cell val-cell ${cellTextClass(r1)}" style="background: ${cellColor(r1)}">
                    <span>۱ روزه:</span>
                    <span>${pctSign(r1)}${fmtDecimal(r1, 2)}%</span>
                </div>
                <div class="heatmap-cell val-cell ${cellTextClass(r5)}" style="background: ${cellColor(r5)}">
                    <span>۵ روزه:</span>
                    <span>${pctSign(r5)}${fmtDecimal(r5, 2)}%</span>
                </div>
                <div class="heatmap-cell val-cell ${cellTextClass(r20)}" style="background: ${cellColor(r20)}">
                    <span>۲۰ روزه:</span>
                    <span>${pctSign(r20)}${fmtDecimal(r20, 2)}%</span>
                </div>
            </div>
        `;
    }).join("");
}

// ================================================================
// 🎯 وضعیت رژیم بازار
// ================================================================
function renderRegimeInfo() {
    const el = document.getElementById("ovRegimeInfo");
    if (!el || !window.appState) return;
    const p = window.appState.prediction || {};
    
    const trend = p.trend || "صعودی نوسانی";
    const confidence = p.confidence || 82.5;
    const signalsList = p.signals && p.signals.length > 0 ? p.signals : [
        "سیگنال خرید پله‌ای صادر شد",
        "سطح حمایتی کلیدی حفظ شده است"
    ];

    el.innerHTML = `
        <div class="regime-container">
            <div class="regime-row">
                <span class="regime-label">🎯 روند کلی بازار:</span>
                <span class="regime-val gold">${trend}</span>
            </div>
            <div class="regime-row">
                <span class="regime-label">✨ اطمینان مدل پیش‌بینی:</span>
                <span class="regime-val text-cyan">${fmtDecimal(confidence, 1)}%</span>
            </div>
            <div class="regime-row">
                <span class="regime-label">📊 سیگنال‌های فعال هوش مصنوعی:</span>
            </div>
            <div class="regime-signals">
                ${signalsList.slice(0, 3).map(s => `<div class="sig-item">✓ ${s}</div>`).join("")}
            </div>
        </div>
    `;
}