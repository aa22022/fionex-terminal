// ================================================================
// 🏦 سیستم فرانت‌اند جامع Gold Predictor v5.0 (نسخه خطی کامل)
// ================================================================

window.appState = null;
let charts = {};

// ------------------------------------------------------------------
// موتور تقویم شمسی
// ------------------------------------------------------------------
function gregorianToJalali(gy, gm, gd) {
    const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let jy = (gy <= 1600) ? 0 : 979;
    gy -= (gy <= 1600) ? 621 : 1600;
    const gy2 = (gm > 2) ? (gy + 1) : gy;
    let days = (365 * gy) + parseInt((gy2 + 3) / 4) - parseInt((gy2 + 99) / 100) + parseInt((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
    jy += 33 * parseInt(days / 12053);
    days %= 12053;
    jy += 4 * parseInt(days / 1461);
    days %= 1461;
    jy += parseInt((days - 1) / 365);
    if (days > 0) days = (days - 1) % 365;
    const jm = (days < 186) ? 1 + parseInt(days / 31) : 7 + parseInt((days - 186) / 30);
    const jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
    return [jy, jm, jd];
}

const PERSIAN_MONTHS = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];

function toPersianDate(dateStr, includeMonthName = false) {
    if (!dateStr) return "--";
    try {
        const cleanStr = String(dateStr).split("T")[0].split(" ")[0];
        const parts = cleanStr.split("-");
        if (parts.length < 3) return dateStr;
        const gy = parseInt(parts[0], 10);
        const gm = parseInt(parts[1], 10);
        const gd = parseInt(parts[2], 10);
        if (isNaN(gy) || isNaN(gm) || isNaN(gd)) return dateStr;
        const [jy, jm, jd] = gregorianToJalali(gy, gm, gd);
        if (includeMonthName) {
            return `${jd} ${PERSIAN_MONTHS[jm - 1]} ${jy}`;
        }
        return `${jy}/${String(jm).padStart(2, '0')}/${String(jd).padStart(2, '0')}`;
    } catch (e) {
        return dateStr;
    }
}

function formatPriceFa(num) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Math.round(Number(num)).toLocaleString('fa-IR');
}

// ------------------------------------------------------------------
// ساعت زنده گوشه صفحه
// ------------------------------------------------------------------
function updateClock() {
    const el = document.getElementById("navTime");
    if (!el) return;
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const ss = String(now.getSeconds()).padStart(2, '0');
    el.innerText = `${hh}:${mm}:${ss}`;
}
setInterval(updateClock, 1000);

// ------------------------------------------------------------------
// حذف چارت قبلی جهت جلوگیری از تداخل
// ------------------------------------------------------------------
function destroyChart(id) {
    if (charts[id]) {
        try { charts[id].destroy(); } catch (e) {}
        delete charts[id];
    }
}

// ------------------------------------------------------------------
// رسم نمودارهای خطی
// ------------------------------------------------------------------
function renderLineChart(canvasId, labels, dataPoints, labelName, color = "#00ff88", historicalDots = null) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    destroyChart(canvasId);

    const persianLabels = labels.map(d => toPersianDate(d));
    const datasets = [{
        label: labelName,
        data: dataPoints,
        borderColor: color,
        backgroundColor: color.replace('rgb', 'rgba').replace(')', ', 0.08)'),
        borderWidth: 2,
        pointRadius: 1,
        tension: 0.15,
        fill: true
    }];

    if (historicalDots && historicalDots.length > 0) {
        const predVals = labels.map(d => {
            const m = historicalDots.find(x => x.target_date === d);
            return m ? m.predicted : null;
        });
        datasets.push({
            label: 'پیش‌بینی‌های ثبت‌شده گذشته',
            data: predVals,
            borderColor: '#ffcc00',
            backgroundColor: '#ffcc00',
            pointRadius: 6,
            pointHoverRadius: 9,
            showLine: false,
            fill: false
        });
    }

    charts[canvasId] = new Chart(ctx, {
        type: 'line',
        data: { labels: persianLabels, datasets: datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: true, labels: { color: '#d1d4dc' } } },
            scales: {
                x: { grid: { color: 'rgba(42,46,57,0.5)' }, ticks: { color: '#a0aec0', maxTicksLimit: 8 } },
                y: { grid: { color: 'rgba(42,46,57,0.5)' }, ticks: { color: '#a0aec0' } }
            }
        }
    });
}

// ------------------------------------------------------------------
// رندر ویجت‌های صفحه نمای کلی
// ------------------------------------------------------------------
