}

function renderHeatmap() {
    const el = document.getElementById("marketHeatmap");
    if (!el || !window.appState) return;
    
    const gh = window.appState.gold_history.prices;
    const uh = window.appState.usd_history.prices;
    const ih = window.appState.iran_gold_history.prices;
    const btc = window.appState.btc_history ? window.appState.btc_history.prices : [];
    const eth = window.appState.eth_history ? window.appState.eth_history.prices : [];
    
    function calcChange(arr, days) {
        if (!arr || arr.length < days + 1) return 0;
        const now = arr[arr.length - 1];
        const past = arr[arr.length - days - 1];
        return ((now - past) / past) * 100;
    }
    
    const assets = [
        { name: "انس طلا", data: gh },
        { name: "دلار تهران", data: uh },
        { name: "طلای ۱۸", data: ih },
        { name: "بیت‌کوین", data: btc },
        { name: "اتریوم", data: eth }
    ];
    
    el.innerHTML = assets.map(a => {
        const ch1 = calcChange(a.data, 1);
        const ch5 = calcChange(a.data, 5);
        const ch20 = calcChange(a.data, 20);
        const color1 = ch1 >= 0 ? '#26a69a' : '#ef5350';
        const color5 = ch5 >= 0 ? '#26a69a' : '#ef5350';
        const color20 = ch20 >= 0 ? '#26a69a' : '#ef5350';
        return `
            <div class="heatmap-card">
                <h4>${a.name}</h4>
                <div style="display:flex;gap:8px;justify-content:space-between">
                    <span style="color:${color1}">۱ روز: ${ch1.toFixed(2)}%</span>
                    <span style="color:${color5}">۵ روز: ${ch5.toFixed(2)}%</span>
                    <span style="color:${color20}">۲۰ روز: ${ch20.toFixed(2)}%</span>
                </div>
            </div>
        `;
    }).join("");
}

function renderRegimeInfo() {
    const el = document.getElementById("ovRegimeInfo") || document.getElementById("sbRegime");
    if (!el || !window.appState) return;
    
    const p = window.appState.prediction;
    const trend = p ? p.trend : "نامشخص";
    const conf = p ? p.confidence : 0;
    
    el.innerHTML = `
        <div class="regime-card">
            <h4>📊 وضعیت رژیم بازار</h4>
            <p><strong>روند:</strong> ${trend}</p>
            <p><strong>اطمینان مدل:</strong> ${conf}%</p>
            <p><strong>سیگنال‌ها:</strong></p>
            <ul>
                ${(p && p.signals ? p.signals.map(s => `<li>${s}</li>`).join("") : "<li>--</li>")}
            </ul>
        </div>
    `;
}

function renderTopSetups() {
    const el = document.getElementById("ovTopSetups");
    if (!el || !window.appState) return;
    
    const setups = (window.appState.fx_scan && window.appState.fx_scan.setups) || [];
    const top5 = setups.slice(0, 5);
    
    if (top5.length === 0) {
        el.innerHTML = "<p>در حال حاضر ستاپ فعالی یافت نشد.</p>";
        return;
    }
    
    el.innerHTML = top5.map(s => `
        <div class="setup-mini">
            <strong>${s.symbol}</strong> [${s.bias}] 
            کیفیت: ${s.trade_quality || '--'} | 
            R/R: ${s.risk_reward || '--'}
        </div>
    `).join("");
}

function renderOverviewMiniChart() {
    if (!window.appState || !window.appState.gold_history) return;
    const gh = window.appState.gold_history;
    renderLineChart("ovChGoldMini", gh.dates, gh.prices, "روند انس جهانی طلا", "#ffcc00");
}

function renderOverview() {
    if (!window.appState) return;
    renderOverviewKpi();
    renderHeatmap();
    renderRegimeInfo();
    renderTopSetups();
    renderOverviewMiniChart();
    
    // بنر هشدار بازار
    const alertBanner = document.getElementById("alertBanner");
    if (alertBanner && window.appState.market_alert) {
        alertBanner.innerText = window.appState.market_alert.message;
    }
}

// ------------------------------------------------------------------
// رندر صفحه طلا و ارز ایران
// ------------------------------------------------------------------
function renderGold() {
    if (!window.appState) return;
    const gh = window.appState.gold_history;
    const uh = window.appState.usd_history;
    const ih = window.appState.iran_gold_history;
    const hDots = window.appState.historical_prediction_dots || {};

    renderLineChart("chGold", gh.dates, gh.prices, "انس جهانی طلا (USD)", "#ffcc00", hDots.gold_oz);
    renderLineChart("chUSD", uh.dates, uh.prices, "دلار تهران (تومان)", "#00ff88", hDots.usd_irr);
    renderLineChart("chIran", ih.dates, ih.prices, "طلای ۱۸ عیار (تومان)", "#e5a93b", hDots.iran_gold);
    
    // نمایش پیش‌بینی ۷ روزه
    const p = window.appState.prediction;
    const el = document.getElementById("goldPredGrid");
    if (el && p) {
        el.innerHTML = `
            <div class="pred-card">
                <h4>🎯 هدف قیمت انس طلا</h4>
                <p>پیش‌بینی: ${p.gold_oz.point.toFixed(2)} USD</p>
                <p>محدوده: ${p.gold_oz.low.toFixed(2)} تا ${p.gold_oz.high.toFixed(2)}</p>
            </div>
            <div class="pred-card">
                <h4>🎯 هدف قیمت دلار</h4>
                <p>پیش‌بینی: ${formatPriceFa(p.usd_irr.point)} تومان</p>
                <p>محدوده: ${formatPriceFa(p.usd_irr.low)} تا ${formatPriceFa(p.usd_irr.high)}</p>
            </div>
            <div class="pred-card">
                <h4>🎯 هدف قیمت طلای ۱۸</h4>
                <p>پیش‌بینی: ${formatPriceFa(p.iran_gold.point)} تومان</p>
                <p>محدوده: ${formatPriceFa(p.iran_gold.low)} تا ${formatPriceFa(p.iran_gold.high)}</p>
            </div>
        `;
    }
}

// ------------------------------------------------------------------
// رندر صفحه فارکس و کریپتو
// ------------------------------------------------------------------
function renderFX() {
    if (!window.appState || !window.appState.fx_scan) return;
    const setups = window.appState.fx_scan.setups || [];
    
    const fxEl = document.getElementById("fxSetups");
    const cryptoEl = document.getElementById("cryptoSetups");
    
    if (fxEl) {
        const fxSetups = setups.filter(s => s.category !== "crypto");
        fxEl.innerHTML = fxSetups.length === 0 ? "<p>ستاپ فعالی یافت نشد.</p>" : fxSetups.map(s => `
            <div class="setup-card">
                <h4>${s.symbol} [${s.bias}]</h4>
                <p>کیفیت: ${s.trade_quality} | R/R: ${s.risk_reward}</p>
                <p>تارگت ۱: ${formatPriceFa(s.target1)}</p>
                <p>استاپ: ${formatPriceFa(s.stop_loss)}</p>
            </div>
        `).join("");
    }
    
    if (cryptoEl) {
        const cryptoSetups = setups.filter(s => s.category === "crypto");
        cryptoEl.innerHTML = cryptoSetups.length === 0 ? "<p>ستاپ کریپتویی یافت نشد.</p>" : cryptoSetups.map(s => `
            <div class="setup-card">
                <h4>${s.symbol} [${s.bias}]</h4>
                <p>کیفیت: ${s.trade_quality} | R/R: ${s.risk_reward}</p>
            </div>
        `).join("");
    }
}

// ------------------------------------------------------------------
// رندر صفحه روابط بازارها
// ------------------------------------------------------------------
function renderRelations() {
    if (!window.appState || !window.appState.relationships) return;
    const rels = window.appState.relationships.relations || [];
    const container = document.getElementById("corrTbl");
    if (!container) return;

    container.innerHTML = `
        <table style="width:100%;border-collapse:collapse">
            <thead>
                <tr><th>دارایی</th><th>همبستگی ۲۰ روزه</th><th>همبستگی ۶۰ روزه</th><th>قدرت</th></tr>
            </thead>
            <tbody>
                ${rels.map(r => `
                    <tr>
                        <td>${r.asset_b}</td>
                        <td>${r.pearson_20d.toFixed(2)}</td>
                        <td>${r.pearson_60d.toFixed(2)}</td>
                        <td>${r.strength}</td>
                    </tr>
                `).join("")}
            </tbody>
        </table>
    `;
}

