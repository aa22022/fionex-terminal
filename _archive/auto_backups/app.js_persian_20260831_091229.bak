        <div class="kpi-card">
            <h4>MAPE دلار</h4><div class="value">${bt.usd_mape}%</div>
        </div>
        <div class="kpi-card">
            <h4>MAPE طلای ۱۸</h4><div class="value">${bt.iran_mape}%</div>
        </div>
        <div class="kpi-card">
            <h4>صحت جهت انس</h4><div class="value">${bt.gold_direction_accuracy || bt.direction_accuracy || 0}%</div>
        </div>
        <div class="kpi-card">
            <h4>صحت جهت دلار</h4><div class="value">${bt.usd_direction_accuracy || 0}%</div>
