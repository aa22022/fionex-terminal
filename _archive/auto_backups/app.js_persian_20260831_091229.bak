        </div>
        <div class="kpi-card">
            <h4>💵 دلار آزاد تهران</h4>
            <div class="value">${formatPriceFa(cp.usd_irr)} تومان</div>
            <div class="source-badge">${cp.providers ? cp.providers.usd : 'Live'}</div>
        </div>
        <div class="kpi-card">
            <h4>🥇 طلای ۱۸ عیار</h4>
            <div class="value">${formatPriceFa(cp.iran_gold_gram18)} تومان</div>
            <div class="source-badge">${cp.providers ? cp.providers.iran : 'Live'}</div>
        </div>
        <div class="kpi-card">
            <h4>🪙 سکه امامی</h4>
