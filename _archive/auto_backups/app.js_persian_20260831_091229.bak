}

// ------------------------------------------------------------------
// رندر صفحه گزارش‌ها و ژورنال
// ------------------------------------------------------------------
function renderReports() {
    if (!window.appState) return;
    const j = window.appState.trade_journal || {};
    const el = document.getElementById("journalStatsWidget");
    if (!el) return;
    el.innerHTML = `
        <div class="kpi-card">
            <h4>نرخ برد</h4><div class="value">${j.win_rate || 0}%</div>
        </div>
        <div class="kpi-card">
            <h4>فاکتور سود</h4><div class="value">${j.profit_factor || 0}</div>
        </div>
    `;
}

// ------------------------------------------------------------------
// کنترلر ناوبری صفحات
// ------------------------------------------------------------------
function renderCurrentPage() {
    const activeTab = document.querySelector(".nav-btn.active");
    if (!activeTab) {
        renderOverview();
        return;
    }
    const pageId = activeTab.getAttribute("data-page");
    
    if (pageId === "page-overview") renderOverview();
    else if (pageId === "page-gold") renderGold();
    else if (pageId === "page-fx") renderFX();
    else if (pageId === "page-relations") renderRelations();
    else if (pageId === "page-backtest") renderBacktestDefault();
    else if (pageId === "page-reports") renderReports();
}

async function loadData() {
    try {
        const statusDot = document.getElementById("statusDot");
        if (statusDot) statusDot.style.animation = "pulseLive 0.8s infinite alternate";
        
        const resp = await fetch("/api/data");
        if (resp.ok) {
            window.appState = await resp.json();
            renderCurrentPage();
            
            const lastUp = document.getElementById("lastUp");
            if (lastUp && window.appState.last_update) {
                lastUp.innerText = toPersianDate(window.appState.last_update, true) + " " + window.appState.last_update.split(" ")[1];
            }
        }
        if (statusDot) statusDot.style.animation = "none";
    } catch (e) {
        console.error("خطا در ارتباط با سرور:", e);
    }
}

async function refreshData() {
    try {
        await fetch("/api/refresh");
        await loadData();
    } catch (e) {
        console.error("خطا در رفرش دستی:", e);
    }
}

// ------------------------------------------------------------------
// راه‌اندازی نهایی
// ------------------------------------------------------------------
document.addEventListener("DOMContentLoaded", () => {
    // ناوبری بین تب‌ها
    const btns = document.querySelectorAll(".nav-btn");
    btns.forEach(btn => {
        btn.addEventListener("click", () => {
            btns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            
            document.querySelectorAll(".page-section, .page").forEach(p => {
                p.classList.remove("active");
                p.style.display = "none";
            });
            const targetPage = btn.getAttribute("data-page");
            const pageEl = document.getElementById(targetPage);
            if (pageEl) {
                pageEl.classList.add("active");
                pageEl.style.display = "block";
            }
            
            renderCurrentPage();
        });
    });

    // دکمه رفرش زنده
    const refreshBtn = document.querySelector("[onclick*='refresh'], .btn-refresh, #btnRefresh");
    if (refreshBtn) {
        refreshBtn.addEventListener("click", refreshData);
    }
    document.querySelectorAll(".nav-refresh, [data-action='refresh']").forEach(b => {
        b.addEventListener("click", refreshData);
    });

    updateClock();
    loadData();
    
    // آپدیت خودکار زنده هر ۴۵ ثانیه
    setInterval(loadData, 45000);
});