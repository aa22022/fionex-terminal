        </div>
        <div class="kpi-card">
            <h4>📈 شاخص DXY</h4>
            <div class="value">${cp.dxy_real || '--'}</div>
            <div class="source-badge">${cp.providers ? cp.providers.macro : 'Stooq'}</div>
        </div>
        <div class="kpi-card">
            <h4>🏛️ US10Y</h4>
            <div class="value">${cp.us10y || '--'}%</div>
            <div class="source-badge">Stooq</div>
        </div>
