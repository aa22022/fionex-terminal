<!-- ========================================================= -->
<!-- FINAL PAGE-NAVIGATION CONTROLLER (Compatible with page-* pattern) -->
<!-- ========================================================= -->
<script>
(function() {
    'use strict';
    
    // نگاشت متن دکمه‌ها به شناسه صفحات (با پیشوند page-)
    const TEXT_TO_PAGE = {
        "نمای کلی": "page-overview",
        "طلا و ارز": "page-gold",
        "طلا و ارز ایران": "page-gold",
        "اسکنر": "page-fx",
        "اسکنر فارکس": "page-fx",
        "اسکنر فارکس و کریپتو": "page-fx",
        "روابط": "page-relations",
        "روابط بازارها": "page-relations",
        "بک‌تست": "page-backtest",
        "بک تست": "page-backtest",
        "بک‌تست و اعتبارسنجی": "page-backtest",
        "گزارش": "page-reports",
        "آنالیز": "page-reports",
        "مرکز آنالیز": "page-reports",
        "مرکز آنالیز و گزارش‌ها": "page-reports"
    };
    
    function switchToPage(pageId) {
        if (!pageId) return;
        
        // اگر پیشوند page- نداشت، اضافه کن
        if (!pageId.startsWith('page-')) {
            pageId = 'page-' + pageId;
        }
        
        console.log("🔄 Switching to:", pageId);
        
        // ۱. پیدا کردن تمام صفحات (page-*)
        const allPages = document.querySelectorAll('[id^="page-"]');
        allPages.forEach(page => {
            page.classList.remove('active');
            page.style.display = 'none';
        });
        
        // ۲. نمایش صفحه هدف
        const targetPage = document.getElementById(pageId);
        if (targetPage) {
            targetPage.classList.add('active');
            targetPage.style.display = '';
            console.log("✅ Page displayed:", pageId);
        } else {
            console.warn("⚠️ Page not found:", pageId);
            return;
        }
        
        // ۳. آپدیت وضعیت active در منو
        const navItems = document.querySelectorAll('.nav-link, .nav-item, .sidebar a, .sidebar button, nav a, nav button');
        navItems.forEach(nav => {
            nav.classList.remove('active');
            if (nav.parentElement && nav.parentElement.tagName === 'LI') {
                nav.parentElement.classList.remove('active');
            }
        });
        
        // ۴. صدا زدن تابع رندر محتوای صفحه (این کلید حل مشکل است!)
        setTimeout(function() {
            try {
                if (typeof renderCurrentPage === 'function') {
                    console.log("🎨 Calling renderCurrentPage()...");
                    renderCurrentPage(pageId);
                }
                
                // فراخوانی توابع رندر مخصوص هر صفحه
                const pageRenderMap = {
                    'page-overview': 'renderOverview',
                    'page-gold': 'renderGold',
                    'page-fx': 'renderFX',
                    'page-relations': 'renderRelations',
                    'page-backtest': 'renderBacktestDefault',
                    'page-reports': 'renderReports'
                };
                
                const funcName = pageRenderMap[pageId];
                if (funcName && typeof window[funcName] === 'function') {
                    console.log("🎨 Calling:", funcName);
                    window[funcName]();
                }
                
                // آپدیت چارت‌ها
                window.dispatchEvent(new Event('resize'));
            } catch(err) {
                console.warn("⚠️ Render error (non-critical):", err);
            }
        }, 50);
    }
    
    function initNavigation() {
        console.log("🚀 Final Navigation Controller Initializing...");
        
        // پیدا کردن تمام دکمه‌های ناوبری در سایدبار و منو
        const selectors = [
            '.nav-link', '.nav-item', '.nav-btn',
            '.sidebar a', '.sidebar button',
            'nav a', 'nav button',
            '[data-page]', '[data-tab]', '[data-target]',
            '.menu-item', '.sidebar-item'
        ];
        const navElements = document.querySelectorAll(selectors.join(', '));
        
        console.log("📌 Found", navElements.length, "navigation elements");
        
        navElements.forEach((el, idx) => {
            // جلوگیری از ثبت مضاعف
            if (el.dataset.navInitialized === 'true') return;
            el.dataset.navInitialized = 'true';
            
            el.addEventListener('click', function(e) {
                let target = this.getAttribute('data-page') ||
                             this.getAttribute('data-tab') ||
                             this.getAttribute('data-target');
                
                // اگر href داشت
                if (!target) {
                    const href = this.getAttribute('href');
                    if (href && href !== '#' && !href.startsWith('http')) {
                        target = href.replace('#', '');
                    }
                }
                
                // اگر هنوز پیدا نشد، از متن دکمه استفاده کن
                if (!target) {
                    const text = (this.innerText || this.textContent || '').trim();
                    for (const key in TEXT_TO_PAGE) {
                        if (text.includes(key)) {
                            target = TEXT_TO_PAGE[key];
                            break;
                        }
                    }
                }
                
                if (target) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // آپدیت وضعیت active دکمه کلیک شده
                    document.querySelectorAll('.nav-link.active, .nav-item.active').forEach(a => a.classList.remove('active'));
                    this.classList.add('active');
                    
                    switchToPage(target);
                }
            });
        });
        
        console.log("✅ Navigation Controller Ready!");
    }
    
    // اجرای اولیه با تاخیر جهت اطمینان از لود کامل app.js
    if (document.readyState === 'complete') {
        setTimeout(initNavigation, 500);
    } else {
        window.addEventListener('load', function() {
            setTimeout(initNavigation, 500);
        });
    }
    
    // در دسترس قرار دادن جهانی جهت دیباگ
    window.switchToPage = switchToPage;
})();
</script>
</body>
</html>