      </div>

      <div class="level-legend-bar">
        <div class="legend-item"><span class="legend-line-sample" style="background:var(--up)"></span><span>حد سود ۱ و ۲ (Take Profit)</span></div>
        <div class="legend-item"><span class="legend-line-sample" style="background:var(--down)"></span><span>حد ضرر قطعی (Stop Loss)</span></div>
        <div class="legend-item"><span class="legend-line-sample" style="background:var(--info);border-top:1px dashed var(--info)"></span><span>محدوده ورود بهینه (Entry Zone)</span></div>
        <div class="legend-item"><span class="legend-line-sample" style="background:var(--accent)"></span><span>سطح پیوت (Pivot Point)</span></div>
        <div class="legend-item"><span class="legend-line-sample" style="background:var(--muted);border-top:1px dashed var(--muted)"></span><span>حمایت و مقاومت‌های S1/R1</span></div>
      </div>
    </div>
  </div>
</div>

