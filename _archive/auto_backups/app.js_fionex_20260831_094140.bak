}

function renderHeatmap() {
    const el = document.getElementById("marketHeatmap");
    if (!el || !window.appState) return;
    
    const gh = window.appState.gold_history.prices;
    const uh = window.appState.usd_history.prices;
    const ih = window.appState.iran_gold_history.prices;
    const btc = window.appState.btc_history ? window.appState.btc_history.prices : [];
    const eth = window.appState.eth_history ? window.appState.eth_history.prices : [];
    
    function calcChange(arr, days) {
        if (!arr || arr.length < days + 1) return 0;
        return ((arr[arr.length - 1] - arr[arr.length - days - 1]) / arr[arr.length - days - 1]) * 100;
    }
    
    const assets = [
        { name: "💰 انس جهانی طلا", data: gh },
        { name: "💵 دلار تهران", data: uh },
        { name: "🥇 طلای ۱۸ عیار", data: ih },
        { name: "₿ بیت‌کوین", data: btc },
        { name: "Ξ اتریوم", data: eth }
    ];
    
    el.innerHTML = assets.map(a => {
        const c1 = calcChange(a.data, 1);
        const c5 = calcChange(a.data, 5);
        const c20 = calcChange(a.data, 20);
        return `
            <div class="heatmap-card">
                <h4>${a.name}</h4>
                <div class="heatmap-row">
                    <span class="lbl">۱ روزه</span>
                    <span class="val ${c1 >= 0 ? 'up' : 'down'}">${pctSign(c1)}${fmtDecimal(c1)}%</span>
                </div>
                <div class="heatmap-row">
                    <span class="lbl">۵ روزه</span>
                    <span class="val ${c5 >= 0 ? 'up' : 'down'}">${pctSign(c5)}${fmtDecimal(c5)}%</span>
                </div>
                <div class="heatmap-row">
                    <span class="lbl">۲۰ روزه</span>
                    <span class="val ${c20 >= 0 ? 'up' : 'down'}">${pctSign(c20)}${fmtDecimal(c20)}%</span>
                </div>
            </div>
        `;
    }).join("");
}

function renderRegimeInfo() {
    const el = document.getElementById("ovRegimeInfo");
    if (!el || !window.appState) return;
    const p = window.appState.prediction;
    if (!p) { el.innerHTML = '<div style="text-align:center;color:#787B86;padding:20px">داده‌ای موجود نیست</div>'; return; }
    
    el.innerHTML = `
        <div class="regime-row">
            <span class="lbl">🎯 روند بازار</span>
            <span class="val">${p.trend || '--'}</span>
        </div>
        <div class="regime-row">
            <span class="lbl">✨ اطمینان مدل</span>
            <span class="val">${fmtDecimal(p.confidence)}%</span>
        </div>
        <div class="regime-row">
            <span class="lbl">📊 تعداد سیگنال</span>
            <span class="val">${p.signals ? p.signals.length : 0}</span>
        </div>
        <div style="margin-top:12px">
            ${(p.signals || []).map(s => `<div class="signal-badge">✓ ${s}</div>`).join("")}
        </div>
    `;
}

function renderSetupCard(s) {
    const bias = (s.bias || '').toLowerCase();
    const biasClass = bias.includes('long') || bias.includes('buy') ? 'long' : 'short';
    return `
        <div class="setup-card">
            <div class="setup-symbol">
                <span class="sym">${s.symbol}</span>
                <span class="bias ${biasClass}">${s.bias || '--'}</span>
            </div>
            <div class="setup-meta">
                <div class="setup-meta-item"><span class="lbl">R/R:</span><span class="val">${fmtDecimal(s.risk_reward)}</span></div>
                <div class="setup-meta-item"><span class="lbl">تارگت:</span><span class="val">${fmtPrice(s.target1)}</span></div>
                <div class="setup-meta-item"><span class="lbl">استاپ:</span><span class="val">${fmtPrice(s.stop_loss)}</span></div>
            </div>
            <div class="setup-quality">${s.trade_quality || 'A'}</div>
        </div>
    `;
}

function renderTopSetups() {
    const el = document.getElementById("ovTopSetups");
    if (!el || !window.appState) return;
    const setups = (window.appState.fx_scan && window.appState.fx_scan.setups) || [];
    const top5 = setups.slice(0, 5);
    if (top5.length === 0) {
        el.innerHTML = '<div style="text-align:center;color:#787B86;padding:20px">در حال حاضر ستاپ فعالی یافت نشد.</div>';
        return;
    }
    el.innerHTML = top5.map(s => renderSetupCard(s)).join("");
}

function renderOverview() {
    if (!window.appState) return;
    renderOverviewKpi();
    renderHeatmap();
    renderRegimeInfo();
    renderTopSetups();
    updateWatchlist();
    
    const gh = window.appState.gold_history;
    if (gh) renderLineChart("ovChGoldMini", gh.dates, gh.prices, "انس جهانی طلا", "#FFB300");
    
    const alertBanner = document.getElementById("alertBanner");
    if (alertBanner && window.appState.market_alert) {
        alertBanner.innerHTML = `<span class="summary-icon">💡</span><span>${window.appState.market_alert.message}</span>`;
    }
}

// ================================================================
// طلا و ارز
// ================================================================
function renderGold() {
    if (!window.appState) return;
    const gh = window.appState.gold_history;
    const uh = window.appState.usd_history;
    const ih = window.appState.iran_gold_history;
    const hDots = window.appState.historical_prediction_dots || {};

    renderLineChart("chGold", gh.dates, gh.prices, "انس جهانی طلا", "#FFB300", hDots.gold_oz);
    renderLineChart("chUSD", uh.dates, uh.prices, "دلار تهران", "#26A69A", hDots.usd_irr);
    renderLineChart("chIran", ih.dates, ih.prices, "طلای ۱۸ عیار", "#FF6D00", hDots.iran_gold);
    
    const p = window.appState.prediction;
    const el = document.getElementById("goldPredGrid");
    if (el && p) {
        el.innerHTML = `
            <div class="pred-card">
                <h4>🎯 پیش‌بینی انس طلا</h4>
                <div class="pred-row"><span class="lbl">هدف:</span><span class="val">${fmtDecimal(p.gold_oz.point)} USD</span></div>
                <div class="pred-row"><span class="lbl">کف:</span><span class="val">${fmtDecimal(p.gold_oz.low)}</span></div>
                <div class="pred-row"><span class="lbl">سقف:</span><span class="val">${fmtDecimal(p.gold_oz.high)}</span></div>
            </div>
            <div class="pred-card">
                <h4>🎯 پیش‌بینی دلار تهران</h4>
                <div class="pred-row"><span class="lbl">هدف:</span><span class="val">${fmtPrice(p.usd_irr.point)}</span></div>
                <div class="pred-row"><span class="lbl">کف:</span><span class="val">${fmtPrice(p.usd_irr.low)}</span></div>
                <div class="pred-row"><span class="lbl">سقف:</span><span class="val">${fmtPrice(p.usd_irr.high)}</span></div>
            </div>
            <div class="pred-card">
                <h4>🎯 پیش‌بینی طلای ۱۸</h4>
                <div class="pred-row"><span class="lbl">هدف:</span><span class="val">${fmtPrice(p.iran_gold.point)}</span></div>
                <div class="pred-row"><span class="lbl">کف:</span><span class="val">${fmtPrice(p.iran_gold.low)}</span></div>
                <div class="pred-row"><span class="lbl">سقف:</span><span class="val">${fmtPrice(p.iran_gold.high)}</span></div>
            </div>
        `;
    }
}

// ================================================================
// فارکس و کریپتو
// ================================================================
function renderFX() {
    if (!window.appState || !window.appState.fx_scan) return;
    const setups = window.appState.fx_scan.setups || [];
    const fxEl = document.getElementById("fxSetups");
    const cryptoEl = document.getElementById("cryptoSetups");
    
    function renderList(list) {
        if (list.length === 0) return '<div style="text-align:center;color:#787B86;padding:20px">ستاپ فعالی یافت نشد.</div>';
        return list.map(s => renderSetupCard(s)).join("");
    }
    
    if (fxEl) fxEl.innerHTML = renderList(setups.filter(s => s.category !== "crypto"));
    if (cryptoEl) cryptoEl.innerHTML = renderList(setups.filter(s => s.category === "crypto"));
}

// ================================================================
// روابط بازارها
// ================================================================
function renderRelations() {
    if (!window.appState || !window.appState.relationships) return;
    const rels = window.appState.relationships.relations || [];
    const container = document.getElementById("corrTbl");
    if (!container) return;
    container.innerHTML = `
        <thead>
            <tr>
                <th>دارایی</th>
                <th>همبستگی ۲۰ روزه</th>
                <th>همبستگی ۶۰ روزه</th>
                <th>بتا</th>
                <th>قدرت رابطه</th>
            </tr>
        </thead>
        <tbody>
            ${rels.map(r => `
                <tr>
                    <td>${r.asset_b}</td>
                    <td class="${r.pearson_20d >= 0 ? 'up' : 'down'}">${fmtDecimal(r.pearson_20d)}</td>
                    <td class="${r.pearson_60d >= 0 ? 'up' : 'down'}">${fmtDecimal(r.pearson_60d)}</td>
                    <td>${fmtDecimal(r.beta_30d)}</td>
                    <td>${r.strength}</td>
                </tr>
            `).join("")}
        </tbody>
    `;
}

