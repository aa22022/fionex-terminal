            <div class="value">${fmtDecimal(cp.gold_oz_usd)}<span class="unit">USD</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.gold : 'زنده'}</span>
        </div>
        <div class="kpi-card">
            <h4>دلار آزاد تهران</h4>
            <div class="value">${fmtPrice(cp.usd_irr)}<span class="unit">تومان</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.usd : 'زنده'}</span>
        </div>
        <div class="kpi-card">
            <h4>طلای ۱۸ عیار</h4>
            <div class="value">${fmtPrice(cp.iran_gold_gram18)}<span class="unit">تومان</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.iran : 'زنده'}</span>
        </div>
        <div class="kpi-card">
            <h4>سکه امامی</h4>
            <div class="value">${fmtPrice(cp.coin_emami)}<span class="unit">تومان</span></div>
            <span class="source-badge">فرمول</span>
        </div>
        <div class="kpi-card">
            <h4>شاخص دلار (DXY)</h4>
            <div class="value">${fmtDecimal(cp.dxy_real)}</div>
            <span class="source-badge">Stooq</span>
        </div>
        <div class="kpi-card">
            <h4>اوراق ۱۰ ساله آمریکا</h4>
            <div class="value">${fmtDecimal(cp.us10y)}<span class="unit">%</span></div>
            <span class="source-badge">Stooq</span>
        </div>
        <div class="kpi-card">
            <h4>شاخص ترس VIX</h4>
            <div class="value">${fmtDecimal(cp.vix)}</div>
            <span class="source-badge">CBOE</span>
        </div>
