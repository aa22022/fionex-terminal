// ================================================================
// 📈 گلد پردیکتور - TradingView Pro (فارسی)
// Gold Predictor v5.0
// ================================================================

window.appState = null;
let charts = {};

// ================================================================
// تقویم شمسی
// ================================================================
function gregorianToJalali(gy, gm, gd) {
    const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let jy = (gy <= 1600) ? 0 : 979;
    gy -= (gy <= 1600) ? 621 : 1600;
    const gy2 = (gm > 2) ? (gy + 1) : gy;
    let days = (365 * gy) + parseInt((gy2 + 3) / 4) - parseInt((gy2 + 99) / 100) + parseInt((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
    jy += 33 * parseInt(days / 12053);
    days %= 12053;
    jy += 4 * parseInt(days / 1461);
    days %= 1461;
    jy += parseInt((days - 1) / 365);
    if (days > 0) days = (days - 1) % 365;
    const jm = (days < 186) ? 1 + parseInt(days / 31) : 7 + parseInt((days - 186) / 30);
    const jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
    return [jy, jm, jd];
}

const PERSIAN_MONTHS = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];

function toPersianDate(dateStr) {
    if (!dateStr) return "--";
    try {
        const cleanStr = String(dateStr).split("T")[0].split(" ")[0];
        const parts = cleanStr.split("-");
        if (parts.length < 3) return dateStr;
        const [jy, jm, jd] = gregorianToJalali(parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));
        return `${jy}/${String(jm).padStart(2, '0')}/${String(jd).padStart(2, '0')}`;
    } catch (e) { return dateStr; }
}

function fmtPrice(num) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Math.round(Number(num)).toLocaleString('en-US');
}

function fmtDecimal(num, d = 2) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}

function pctSign(v) { return v >= 0 ? '+' : ''; }

// ================================================================
// ساعت زنده
// ================================================================
function updateClock() {
    const el = document.getElementById("navTime");
    if (!el) return;
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const ss = String(now.getSeconds()).padStart(2, '0');
    el.innerText = `${hh}:${mm}:${ss}`;
}
setInterval(updateClock, 1000);

// ================================================================
// چارت‌ها
// ================================================================
function destroyChart(id) {
    if (charts[id]) { try { charts[id].destroy(); } catch (e) {} delete charts[id]; }
}

function renderLineChart(canvasId, labels, dataPoints, labelName, color, historicalDots = null) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    destroyChart(canvasId);

    const persianLabels = labels.map(d => toPersianDate(d));
    const canvasCtx = ctx.getContext('2d');
    const gradient = canvasCtx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, color + '40');
    gradient.addColorStop(1, color + '00');
    
    const datasets = [{
        label: labelName,
        data: dataPoints,
        borderColor: color,
        backgroundColor: gradient,
        borderWidth: 2,
        pointRadius: 0,
        pointHoverRadius: 5,
        pointBackgroundColor: color,
        pointBorderColor: '#131722',
        pointBorderWidth: 2,
        tension: 0.3,
        fill: true
    }];

    if (historicalDots && historicalDots.length > 0) {
        const predVals = labels.map(d => {
            const m = historicalDots.find(x => x.target_date === d);
            return m ? m.predicted : null;
        });
        datasets.push({
            label: 'پیش‌بینی‌های ثبت‌شده',
            data: predVals,
            borderColor: '#FFB300',
            backgroundColor: '#FFB300',
            pointRadius: 6,
            pointHoverRadius: 9,
            pointBorderColor: '#131722',
            pointBorderWidth: 2,
            showLine: false,
            fill: false
        });
    }

    charts[canvasId] = new Chart(ctx, {
        type: 'line',
        data: { labels: persianLabels, datasets: datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    align: 'end',
                    labels: {
                        color: '#787B86',
                        font: { family: 'Vazirmatn', size: 11 },
                        padding: 10,
                        usePointStyle: true,
                        pointStyle: 'circle'
                    }
                },
                tooltip: {
                    backgroundColor: '#1E222D',
                    titleColor: '#FFFFFF',
                    bodyColor: '#D1D4DC',
                    borderColor: '#363A45',
                    borderWidth: 1,
                    padding: 10,
                    cornerRadius: 6,
                    titleFont: { family: 'Vazirmatn', weight: '600' },
                    bodyFont: { family: 'Vazirmatn' }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(54, 58, 69, 0.4)', drawBorder: false },
                    ticks: { color: '#5D6069', font: { family: 'Vazirmatn', size: 10 }, maxTicksLimit: 8 }
                },
                y: {
                    grid: { color: 'rgba(54, 58, 69, 0.4)', drawBorder: false },
                    ticks: { color: '#5D6069', font: { family: 'Vazirmatn', size: 10 } }
                }
            }
        }
    });
}

// ================================================================
// واچ‌لیست سمت چپ
// ================================================================
function updateWatchlist() {
    if (!window.appState) return;
    const cp = window.appState.current_prices;
    
    function calcChange(arr) {
        if (!arr || arr.length < 2) return 0;
        return ((arr[arr.length - 1] - arr[arr.length - 2]) / arr[arr.length - 2]) * 100;
    }
    
    function setChangeText(id, val) {
        const el = document.getElementById(id);
        if (!el) return;
        el.innerText = `${pctSign(val)}${fmtDecimal(val)}%`;
        el.className = 'wl-change ' + (val >= 0 ? 'up' : 'down');
    }
    
    const goldEl = document.getElementById("wlGold");
    if (goldEl) goldEl.innerText = fmtDecimal(cp.gold_oz_usd);
    const usdEl = document.getElementById("wlUsd");
    if (usdEl) usdEl.innerText = fmtPrice(cp.usd_irr);
    const iranEl = document.getElementById("wlIran");
    if (iranEl) iranEl.innerText = fmtPrice(cp.iran_gold_gram18);
    const coinEl = document.getElementById("wlCoin");
    if (coinEl) coinEl.innerText = fmtPrice(cp.coin_emami);
    
    const btcArr = window.appState.btc_history ? window.appState.btc_history.prices : [];
    const ethArr = window.appState.eth_history ? window.appState.eth_history.prices : [];
    const btcEl = document.getElementById("wlBtc");
    if (btcEl && btcArr.length) btcEl.innerText = fmtPrice(btcArr[btcArr.length - 1]);
    const ethEl = document.getElementById("wlEth");
    if (ethEl && ethArr.length) ethEl.innerText = fmtPrice(ethArr[ethArr.length - 1]);
    
    setChangeText("wlGoldChange", calcChange(window.appState.gold_history.prices));
    setChangeText("wlUsdChange", calcChange(window.appState.usd_history.prices));
    setChangeText("wlIranChange", calcChange(window.appState.iran_gold_history.prices));
    setChangeText("wlBtcChange", calcChange(btcArr));
    setChangeText("wlEthChange", calcChange(ethArr));
}

// ================================================================
// نمای کلی
// ================================================================
