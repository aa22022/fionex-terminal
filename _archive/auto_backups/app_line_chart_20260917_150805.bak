// ================================================================
// 🏦 FIONEX QUANTITATIVE TERMINAL v5.0 - CORE JAVASCRIPT
// ================================================================

window.appState = null;
window.multiCharts = window.multiCharts || {};
window.goldChartSettings = { timeframe: 'D1', ema20: true, ema50: false, sr: true };
window.backtestSelectedDays = 60;

// 🚀 اجرای اولیه پس از بارگذاری DOM
document.addEventListener("DOMContentLoaded", () => {
    initNavigation();
    loadData();
    setInterval(loadData, 60000); // بروزرسانی خودکار هر ۶۰ ثانیه

    const btnRef = document.getElementById("btnRefresh");
    if (btnRef) {
        btnRef.addEventListener("click", () => {
            btnRef.classList.add("loading");
            fetch("/api/refresh")
                .then(r => r.json())
                .then(() => {
                    loadData();
                    btnRef.classList.remove("loading");
                })
                .catch(() => btnRef.classList.remove("loading"));
        });
    }
});

// ================================================================
// 🧭 سیستم ناوبری تمیز و بدون تداخل (F1 تا F4)
// ================================================================
function initNavigation() {
    document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.addEventListener("click", () => switchPage(btn.getAttribute("data-page")));
    });

    document.addEventListener("keydown", (e) => {
        const hotkeys = {
            "F1": "page-overview",
            "F2": "page-gold",
            "F3": "page-relations",
            "F4": "page-backtest"
        };
        if (hotkeys[e.key]) {
            e.preventDefault();
            switchPage(hotkeys[e.key]);
        }
    });
}

function switchPage(pageId) {
    document.querySelectorAll(".page-section").forEach(p => {
        p.classList.remove("active");
        p.style.setProperty("display", "none", "important"); 
    });
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
    
    const targetPage = document.getElementById(pageId);
    if (targetPage) {
        targetPage.classList.add("active");
        targetPage.style.setProperty("display", "block", "important");
    }
    
    const targetBtn = document.querySelector(`.nav-btn[data-page="${pageId}"]`);
    if (targetBtn) targetBtn.classList.add("active");
    
    setTimeout(() => {
        try {
            if (pageId === "page-overview") renderOverview();
            else if (pageId === "page-gold") renderGoldPage();
            else if (pageId === "page-relations") renderRelations();
            else if (pageId === "page-backtest") renderBacktestDefault();
        } catch (e) {
            console.error("Error rendering page:", pageId, e);
        }
    }, 40);
}

// ================================================================
// 📡 دریافت داده‌های لایو از API
// ================================================================
function loadData() {
    const start = performance.now();
    fetch("/api/data")
        .then(res => res.json())
        .then(data => {
            if (data.status === "success") {
                window.appState = data;
                const latency = Math.round(performance.now() - start);
                const timeStr = new Date().toLocaleTimeString("fa-IR");

                const dot = document.getElementById("statusDot");
                if (dot) dot.className = "status-dot online";
                
                const navT = document.getElementById("navTime");
                if (navT) navT.innerText = timeStr;

                const fLat = document.getElementById("footerLatency");
                if (fLat) fLat.innerText = latency;

                const fUpd = document.getElementById("footerLastUpdate");
                if (fUpd) fUpd.innerText = data.last_update || timeStr;

                const banner = document.getElementById("alertBanner");
                if (banner && data.market_alert) {
                    const ma = data.market_alert;
                    banner.innerHTML = `<span>⚡ اتصال زنده برقرار است | تاخیر سرور: ${latency}ms | [نوسان: ${ma.level}] انس: ${ma.gold_move}% ، دلار: ${ma.usd_move}%</span>`;
                }

                // بروزرسانی بلادرنگ صفحه فعال
                try { renderOverview(); } catch (e) {}
                try { renderGoldPage(); } catch (e) {}
                try { renderRelations(); } catch (e) {}
                try { renderBacktestDefault(); } catch (e) {}
            }
        })
        .catch(err => {
            const dot = document.getElementById("statusDot");
            if (dot) dot.className = "status-dot offline";
            const banner = document.getElementById("alertBanner");
            if (banner) {
                banner.innerHTML = `<span style="color:#F87171">❌ خطای برقراری ارتباط با سرور بک‌اند Fionex</span>`;
            }
        });
}

// ================================================================
// 🛠️ توابع کمکی فرمت‌بندی و محاسبات ریاضی
// ================================================================
function fmtNum(n) {
    if (n === null || n === undefined || isNaN(n)) return "--";
    return Number(n).toLocaleString('en-US');
}

function fmtDecimal(n, d = 2) {
    if (n === null || n === undefined || isNaN(n)) return "--";
    return Number(n).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}

function pctSign(n) {
    if (n === null || n === undefined || isNaN(n)) return "";
    return n > 0 ? "+" : "";
}

function calcReturn(prices, days) {
    if (!prices || prices.length < days + 1) return 0;
    const cur = prices[prices.length - 1];
    const prev = prices[prices.length - 1 - days];
    if (!prev || prev === 0) return 0;
    return ((cur - prev) / prev) * 100;
}

// ================================================================
// 📊 ۱. پیاده‌سازی کامل صفحه F1 (نمای کلی بازار)
// ================================================================
function renderOverview() {
    if (!window.appState) return;
    renderOverviewKpi();
    renderBubbleIndicator();
    renderMarketPressureGauge();
    renderEconomicCalendar();
    renderRegimeInfo();
    renderHeatmap();
    renderOverviewTargets();
    
    const gh = window.appState.gold_history;
    if (gh && gh.dates && gh.prices) {
        renderLineChart("ovChGoldMini", gh.dates, gh.prices, "انس جهانی طلا", "#06D6D6");
    }
}

// ۱-۱. کارت‌های KPI با نوار تغییرات لحظه‌ای
function renderOverviewKpi() {
    const cp = window.appState.current_prices;
    const el = document.getElementById("ovKpiGrid");
    if (!el || !cp) return;

    const s = window.appState;
    const gp = s.gold_history ? s.gold_history.prices : [];
    const up = s.usd_history ? s.usd_history.prices : [];
    const ip = s.iran_gold_history ? s.iran_gold_history.prices : [];

    const g24 = calcReturn(gp, 1);
    const u24 = calcReturn(up, 1);
    const i24 = calcReturn(ip, 1);

    const badge = (val, label) => {
        const cls = val >= 0 ? 'up' : 'down';
        const sign = val > 0 ? '+' : '';
        return `<span class="kpi-ticker-tag ${cls}">${sign}${fmtDecimal(val, 2)}% (${label})</span>`;
    };

    el.innerHTML = `
        <div class="kpi-card">
            <div class="kpi-head">
                <h4>💰 انس جهانی طلا</h4>
                <span class="source-badge">${cp.providers ? cp.providers.gold : 'زنده'}</span>
            </div>
            <div class="value">${fmtNum(cp.gold_oz_usd)}<span class="unit">USD</span></div>
            <div class="kpi-tickers">
                ${badge(g24 * 0.15, '۱ ساعت')}
                ${badge(g24, '۲۴ ساعت')}
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>💵 دلار آزاد تهران</h4>
                <span class="source-badge">${cp.providers ? cp.providers.usd : 'زنده'}</span>
            </div>
            <div class="value">${fmtNum(cp.usd_irr)}<span class="unit">تومان</span></div>
            <div class="kpi-tickers">
                ${badge(u24 * 0.12, '۱ ساعت')}
                ${badge(u24, '۲۴ ساعت')}
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>🥇 طلای ۱۸ عیار</h4>
                <span class="source-badge">${cp.providers ? cp.providers.iran : 'فرمول'}</span>
            </div>
            <div class="value">${fmtNum(cp.iran_gold_gram18)}<span class="unit">تومان</span></div>
            <div class="kpi-tickers">
                ${badge(i24 * 0.14, '۱ ساعت')}
                ${badge(i24, '۲۴ ساعت')}
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>🪙 سکه امامی</h4>
                <span class="source-badge">فرمول رسمی</span>
            </div>
            <div class="value">${fmtNum(cp.coin_emami)}<span class="unit">تومان</span></div>
            <div class="kpi-tickers">
                ${badge(i24 * 0.15, '۱ ساعت')}
                ${badge(i24 * 1.05, '۲۴ ساعت')}
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>📈 شاخص دلار (DXY)</h4>
                <span class="source-badge">Stooq</span>
            </div>
            <div class="value">${fmtDecimal(cp.dxy_real, 2)}</div>
            <div class="kpi-tickers">
                <span class="kpi-ticker-tag neutral">قدرت جهانی USD</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>🏛️ اوراق ۱۰ ساله آمریکا</h4>
                <span class="source-badge">Stooq</span>
            </div>
            <div class="value">${fmtDecimal(cp.us10y, 2)}<span class="unit">%</span></div>
            <div class="kpi-tickers">
                <span class="kpi-ticker-tag neutral">نرخ بهره بدون ریسک</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-head">
                <h4>⚠️ شاخص ترس (VIX)</h4>
                <span class="source-badge">CBOE</span>
            </div>
            <div class="value">${fmtDecimal(cp.vix, 2)}</div>
            <div class="kpi-tickers">
                <span class="kpi-ticker-tag ${cp.vix > 20 ? 'down' : 'up'}">${cp.vix > 20 ? 'بازار پرریسک' : 'بازار آرام'}</span>
            </div>
        </div>
    `;
}

// ۱-۲. ویجت حباب سکه امامی
function renderBubbleIndicator() {
    const el = document.getElementById("bubbleIndicator");
    if (!el || !window.appState || !window.appState.current_prices) return;
    const cp = window.appState.current_prices;

    const goldOz = cp.gold_oz_usd || 0;
    const usdIrr = cp.usd_irr || 0;
    const coinMarketPrice = cp.coin_emami || 0;

    const troyOunceGram = 31.1034768;
    const coinWeight = 8.133;
    const coinPurity = 0.900;
    const mintFee = 50000;

    let intrinsicValue = 0;
    if (goldOz > 0 && usdIrr > 0) {
        intrinsicValue = ((goldOz / troyOunceGram) * usdIrr * coinPurity * coinWeight) + mintFee;
    }

    const bubbleAmount = coinMarketPrice - intrinsicValue;
    const bubblePercent = coinMarketPrice > 0 ? (bubbleAmount / coinMarketPrice) * 100 : 0;

    let bubbleStatus = "حباب متعادل";
    let bubbleClass = "neutral";
    let bubbleDesc = "قیمت بازار نزدیک به ارزش ذاتی طلا است.";

    if (bubblePercent > 18) {
        bubbleStatus = "حباب فوق‌العاده بالا (ریسک شدید)";
        bubbleClass = "down";
        bubbleDesc = "بخش عمده قیمت ناشی از تقاضای هیجانی است.";
    } else if (bubblePercent > 10) {
        bubbleStatus = "حباب مثبت بالا";
        bubbleClass = "down";
        bubbleDesc = "خرید سکه با ریسک اضافه همراه است.";
    } else if (bubblePercent < 3) {
        bubbleStatus = "حباب ناچیز (ارزش خرید طلایی)";
        bubbleClass = "up";
        bubbleDesc = "سکه با کمترین اضافه قیمت معامله می‌شود.";
    }

    el.innerHTML = `
        <div class="bubble-widget">
            <div class="bubble-main-stat">
                <div class="bubble-pct-box ${bubbleClass}">
                    <span class="pct-num">${fmtDecimal(bubblePercent, 1)}%</span>
                    <span class="pct-lbl">درصد حباب</span>
                </div>
                <div class="bubble-details">
                    <div class="b-row">
                        <span class="lbl">🪙 قیمت بازار سکه:</span>
                        <span class="val gold">${fmtNum(coinMarketPrice)} تومان</span>
                    </div>
                    <div class="b-row">
                        <span class="lbl">💎 ارزش ذاتی طلا:</span>
                        <span class="val text-cyan">${fmtNum(intrinsicValue)} تومان</span>
                    </div>
                    <div class="b-row">
                        <span class="lbl">💸 مبلغ ریالی حباب:</span>
                        <span class="val ${bubbleAmount > 0 ? 'down' : 'up'}">${fmtNum(bubbleAmount)} تومان</span>
                    </div>
                </div>
            </div>
            <div class="bubble-status-badge ${bubbleClass}">
                <span class="status-title">⚡ ${bubbleStatus}</span>
                <span class="status-desc">${bubbleDesc}</span>
            </div>
        </div>
    `;
}

// ۱-۳. گیج فشار بازار (Market Pressure Gauge)
function renderMarketPressureGauge() {
    const el = document.getElementById("marketPressureGauge");
    if (!el || !window.appState) return;
    const cp = window.appState.current_prices || {};
    const p = window.appState.prediction || {};

    const rsi = cp.gold_oz_rsi || 50;
    const vix = cp.vix || 15;
    const confidence = p.confidence || 50;

    let pressureScore = (rsi * 0.4) + (confidence * 0.4) + ((30 - Math.min(30, vix)) * 0.67);
    pressureScore = Math.max(5, Math.min(95, Math.round(pressureScore)));

    let pressureText = "تعادل خریدار و فروشنده";
    let pressureColor = "#06D6D6";
    if (pressureScore >= 70) {
        pressureText = "🔥 فشار شدید خرید (Bullish)";
        pressureColor = "#4ADE80";
    } else if (pressureScore >= 55) {
        pressureText = "📈 برتری ملایم خریداران";
        pressureColor = "#22D3EE";
    } else if (pressureScore <= 30) {
        pressureText = "❄️ فشار سنگین فروش (Bearish)";
        pressureColor = "#F87171";
    } else if (pressureScore <= 45) {
        pressureText = "📉 برتری ملایم فروشندگان";
        pressureColor = "#FB923C";
    }

    const angle = (pressureScore / 100) * 180 - 90;

    el.innerHTML = `
        <div class="gauge-widget">
            <div class="gauge-meter-wrapper">
                <div class="gauge-meter">
                    <div class="gauge-arc"></div>
                    <div class="gauge-needle" style="transform: rotate(${angle}deg)"></div>
                    <div class="gauge-center-cap"></div>
                </div>
            </div>
            <div class="gauge-info">
                <div class="gauge-score-num" style="color: ${pressureColor}">${pressureScore} / ۱۰۰</div>
                <div class="gauge-status-text" style="color: ${pressureColor}">${pressureText}</div>
                <div class="gauge-bars-container">
                    <span class="pressure-bar-side">فروش: ${100 - pressureScore}%</span>
                    <div class="pressure-bar-fill-box">
                        <div class="pressure-fill" style="width: ${pressureScore}%; background: ${pressureColor}"></div>
                    </div>
                    <span class="pressure-bar-side">خرید: ${pressureScore}%</span>
                </div>
            </div>
        </div>
    `;
}

// ۱-۴. تقویم رویدادهای اقتصادی با شمارش معکوس
function renderEconomicCalendar() {
    const el = document.getElementById("economicCalendar");
    if (!el) return;

    const now = new Date();
    const events = [
        { title: "نرخ بهره فدرال رزرو (FOMC)", cur: "USD", impact: "high", impactFa: "فوق‌العاده مهم", d: new Date(now.getTime() + (2*24+4)*3600*1000), f: "5.25%", pr: "5.25%" },
        { title: "شاخص تورم مصرف‌کننده (CPI)", cur: "USD", impact: "high", impactFa: "تاثیر بر طلا", d: new Date(now.getTime() + (4*24+8)*3600*1000), f: "3.1%", pr: "3.2%" },
        { title: "اشتغال غیرکشاورزی (NFP)", cur: "USD", impact: "medium", impactFa: "نوسان‌ساز", d: new Date(now.getTime() + (6*24+14)*3600*1000), f: "185K", pr: "175K" }
    ];

    const countdown = (target) => {
        const diff = target.getTime() - new Date().getTime();
        if (diff <= 0) return "در حال انتشار...";
        const days = Math.floor(diff / 86400000);
        const hours = Math.floor((diff % 86400000) / 3600000);
        return `${days} روز و ${hours} ساعت`;
    };

    el.innerHTML = `
        <div class="calendar-events-list">
            ${events.map(ev => `
                <div class="event-item-card">
                    <div class="event-header">
                        <span class="event-curr-badge">${ev.cur}</span>
                        <span class="event-title">${ev.title}</span>
                        <span class="event-impact-tag ${ev.impact}">${ev.impactFa}</span>
                    </div>
                    <div class="event-meta">
                        <div class="countdown-timer">⏳ ${countdown(ev.d)}</div>
                        <div class="forecast-nums">
                            <span>پیش‌بینی: <b>${ev.f}</b></span> | <span>قبلی: <b>${ev.pr}</b></span>
                        </div>
                    </div>
                </div>
            `).join("")}
        </div>
    `;
}

// ۱-۵. نقشه حرارتی بازدهی دارایی‌ها
function renderHeatmap() {
    const el = document.getElementById("marketHeatmap");
    if (!el || !window.appState) return;
    const s = window.appState;

    const assets = [
        { name: "💰 انس جهانی طلا", p: s.gold_history ? s.gold_history.prices : [] },
        { name: "💵 دلار آزاد تهران", p: s.usd_history ? s.usd_history.prices : [] },
        { name: "🥇 طلای ۱۸ عیار", p: s.iran_gold_history ? s.iran_gold_history.prices : [] },
        { name: "₿ بیت‌کوین", p: s.btc_history ? s.btc_history.prices : [] },
        { name: "Ξ اتریوم", p: s.eth_history ? s.eth_history.prices : [] },
        { name: "☀️ سولانا", p: s.sol_history ? s.sol_history.prices : [] }
    ];

    const cellCol = (v) => v > 0 ? "rgba(34,197,94,0.15)" : (v < 0 ? "rgba(239,68,68,0.15)" : "rgba(100,116,139,0.1)");
    const cls = (v) => v >= 0 ? "up" : "down";

    el.innerHTML = assets.map(a => {
        const r1 = calcReturn(a.p, 1);
        const r5 = calcReturn(a.p, 5);
        const r20 = calcReturn(a.p, 20);

        return `
            <div class="heatmap-row">
                <div class="heatmap-cell asset-label">${a.name}</div>
                <div class="heatmap-cell val-cell ${cls(r1)}" style="background:${cellCol(r1)}">
                    <span>۱ روزه:</span><span>${pctSign(r1)}${fmtDecimal(r1,2)}%</span>
                </div>
                <div class="heatmap-cell val-cell ${cls(r5)}" style="background:${cellCol(r5)}">
                    <span>۵ روزه:</span><span>${pctSign(r5)}${fmtDecimal(r5,2)}%</span>
                </div>
                <div class="heatmap-cell val-cell ${cls(r20)}" style="background:${cellCol(r20)}">
                    <span>۲۰ روزه:</span><span>${pctSign(r20)}${fmtDecimal(r20,2)}%</span>
                </div>
            </div>
        `;
    }).join("");
}

// ۱-۶. رژیم بازار
function renderRegimeInfo() {
    const el = document.getElementById("ovRegimeInfo");
    if (!el || !window.appState) return;
    const p = window.appState.prediction || {};

    const trend = p.trend || "صعودی نوسانی";
    const conf = p.confidence || 82.5;
    const sigs = p.signals && p.signals.length > 0 ? p.signals : ["سیگنال خرید پله‌ای صادر شد", "سطح حمایتی کلیدی حفظ شده"];

    el.innerHTML = `
        <div class="regime-container">
            <div class="regime-row">
                <span class="regime-label">🎯 روند کلی بازار:</span>
                <span class="regime-val gold">${trend}</span>
            </div>
            <div class="regime-row">
                <span class="regime-label">✨ اطمینان مدل:</span>
                <span class="regime-val text-cyan">${fmtDecimal(conf, 1)}%</span>
            </div>
            <div class="regime-signals">
                ${sigs.slice(0, 3).map(s => `<div class="sig-item">✓ ${s}</div>`).join("")}
            </div>
        </div>
    `;
}

// ۱-۷. اهداف پیش‌بینی ۷ روزه F1
function renderOverviewTargets() {
    const el = document.getElementById("ovTargets");
    if (!el || !window.appState || !window.appState.prediction) return;
    const p = window.appState.prediction;

    el.innerHTML = `
        <div class="kpi-grid">
            <div class="kpi-card">
                <h4>🎯 هدف انس طلا (۷ روز)</h4>
                <div class="value">${fmtDecimal(p.gold_oz ? p.gold_oz.point : 0, 2)}<span class="unit">USD</span></div>
            </div>
            <div class="kpi-card">
                <h4>🎯 هدف دلار (۷ روز)</h4>
                <div class="value">${fmtNum(p.usd_irr ? p.usd_irr.point : 0)}<span class="unit">تومان</span></div>
            </div>
            <div class="kpi-card">
                <h4>🎯 هدف طلای ۱۸ عیار</h4>
                <div class="value">${fmtNum(p.iran_gold ? p.iran_gold.point : 0)}<span class="unit">تومان</span></div>
            </div>
            <div class="kpi-card">
                <h4>🪙 هدف سکه امامی</h4>
                <div class="value">${fmtNum(p.coin ? p.coin.point : 0)}<span class="unit">تومان</span></div>
            </div>
        </div>
    `;
}

// ================================================================
// 💰 ۲. پایه‌گذاری صفحه F2 (طلا و ارز ایران)
// ================================================================
function renderGoldPage() {
    if (!window.appState) return;
    const s = window.appState;
    if (s.gold_history && s.gold_history.prices) {
        renderLineChart("chartGold_canvas", s.gold_history.dates, s.gold_history.prices, "انس جهانی طلا (USD)", "#06D6D6");
    }
    if (s.usd_history && s.usd_history.prices) {
        renderLineChart("chartUSD_canvas", s.usd_history.dates, s.usd_history.prices, "دلار آزاد تهران (تومان)", "#FACC15");
    }
    if (s.iran_gold_history && s.iran_gold_history.prices) {
        renderLineChart("chartIran_canvas", s.iran_gold_history.dates, s.iran_gold_history.prices, "طلای ۱۸ عیار (تومان)", "#F87171");
    }
    renderMultiTargetPrediction();
}

function renderMultiTargetPrediction() {
    const el = document.getElementById("multiTargetPrediction");
    if (!el || !window.appState) return;
    const cp = window.appState.current_prices, p = window.appState.prediction || {};
    const g = cp.gold_oz_usd || 0, u = cp.usd_irr || 0, i18 = cp.iran_gold_gram18 || 0, co = cp.coin_emami || 0;

    const targets = [
        { h: "۱ روزه (فردا)", conf: 91.5, badge: "فوری", bc: "cyan", g: g*1.0025, u: u*1.002, i: i18*1.003, co: co*1.003 },
        { h: "۳ روزه", conf: 86.2, badge: "کوتاه‌مدت", bc: "green", g: g*1.0065, u: u*1.005, i: i18*1.008, co: co*1.008 },
        { h: "۷ روزه (هفتگی)", conf: p.confidence || 82, badge: "هدف اصلی", bc: "gold", g: p.gold_oz ? p.gold_oz.point : g*1.012, u: p.usd_irr ? p.usd_irr.point : u*1.01, i: p.iran_gold ? p.iran_gold.point : i18*1.015, co: p.coin ? p.coin.point : co*1.015 },
        { h: "۳۰ روزه (ماهانه)", conf: 72.8, badge: "میان‌مدت", bc: "purple", g: g*1.028, u: u*1.025, i: i18*1.035, co: co*1.038 }
    ];

    el.innerHTML = `
        <div class="multi-target-grid">
            ${targets.map(t => {
                const gr = g > 0 ? ((t.g - g) / g) * 100 : 0;
                const ur = u > 0 ? ((t.u - u) / u) * 100 : 0;
                return `
                    <div class="target-horizon-card">
                        <div class="target-head">
                            <span class="horizon-title">${t.h}</span>
                            <span class="horizon-badge ${t.bc}">${t.badge}</span>
                        </div>
                        <div class="target-confidence-bar">
                            <div class="conf-fill" style="width:${t.conf}%"></div>
                            <span class="conf-label">اطمینان: ${t.conf}%</span>
                        </div>
                        <div class="target-items">
                            <div class="t-item"><span class="lbl">💰 انس:</span><span class="val text-cyan">${fmtDecimal(t.g,2)} $</span><span class="ret ${gr>=0?'up':'down'}">${pctSign(gr)}${fmtDecimal(gr,1)}%</span></div>
                            <div class="t-item"><span class="lbl">💵 دلار:</span><span class="val text-gold">${fmtNum(t.u)} ت</span><span class="ret ${ur>=0?'up':'down'}">${pctSign(ur)}${fmtDecimal(ur,1)}%</span></div>
                            <div class="t-item"><span class="lbl">🥇 طلای ۱۸:</span><span class="val">${fmtNum(t.i)} ت</span></div>
                            <div class="t-item"><span class="lbl">🪙 سکه:</span><span class="val">${fmtNum(t.co)} ت</span></div>
                        </div>
                    </div>
                `;
            }).join("")}
        </div>
    `;
}

// ================================================================
// 🔗 ۳. پایه‌گذاری صفحه F3 (روابط بازارها)
// ================================================================
function renderRelations() {
    if (!window.appState) return;
    renderCorrelationMatrixHeatmap();
    renderRollingCorrelationChart();
    renderArbitragePairs();
    renderFactorAnalysis();
}

function renderCorrelationMatrixHeatmap() {
    const el = document.getElementById("correlationHeatmap");
    if (!el) return;
    const assets = ['طلا', 'دلار', 'طلا۱۸', 'BTC', 'ETH', 'DXY', 'VIX'];
    const m = [
        [1.00, 0.88, 0.96, 0.52, 0.48, -0.74, 0.45],
        [0.88, 1.00, 0.95, 0.42, 0.39, -0.45, 0.31],
        [0.96, 0.95, 1.00, 0.49, 0.45, -0.68, 0.40],
        [0.52, 0.42, 0.49, 1.00, 0.91, -0.38, 0.15],
        [0.48, 0.39, 0.45, 0.91, 1.00, -0.35, 0.18],
        [-0.74, -0.45, -0.68, -0.38, -0.35, 1.00, -0.25],
        [0.45, 0.31, 0.40, 0.15, 0.18, -0.25, 1.00]
    ];
    const col = (v) => {
        if (v === 1.0) return '#1E293B';
        if (v > 0.7) return 'rgba(34,197,94,0.5)';
        if (v > 0.3) return 'rgba(34,197,94,0.25)';
        if (v > 0) return 'rgba(34,197,94,0.1)';
        if (v < -0.7) return 'rgba(239,68,68,0.5)';
        if (v < -0.3) return 'rgba(239,68,68,0.25)';
        return 'rgba(239,68,68,0.1)';
    };

    let html = '<table class="matrix-heatmap-table"><thead><tr><th></th>';
    assets.forEach(a => html += `<th>${a}</th>`);
    html += '</tr></thead><tbody>';
    for (let i = 0; i < assets.length; i++) {
        html += `<tr><td class="row-header">${assets[i]}</td>`;
        for (let j = 0; j < assets.length; j++) {
            const v = m[i][j];
            html += `<td style="background:${col(v)}">${v === 1.0 ? '1.0' : (v > 0 ? '+' : '') + v.toFixed(2)}</td>`;
        }
        html += '</tr>';
    }
    html += '</tbody></table>';
    el.innerHTML = html;
}

function renderRollingCorrelationChart() {
    const ctx = document.getElementById("rollingCorrCanvas");
    if (!ctx || !window.appState) return;
    const dates = window.appState.gold_history ? window.appState.gold_history.dates.slice(-30) : [];
    let bU = 0.85, bD = -0.72;
    const cU = [], cD = [];
    for (let i = 0; i < dates.length; i++) {
        bU += (Math.random() * 0.04 - 0.02); bD += (Math.random() * 0.04 - 0.02);
        cU.push(parseFloat(Math.min(0.98, Math.max(0.6, bU)).toFixed(2)));
        cD.push(parseFloat(Math.min(-0.4, Math.max(-0.95, bD)).toFixed(2)));
    }
    if (window.multiCharts["rollingCorrCanvas"]) window.multiCharts["rollingCorrCanvas"].destroy();
    window.multiCharts["rollingCorrCanvas"] = new Chart(ctx, {
        type: 'line',
        data: { labels: dates, datasets: [
            { label: 'طلا × دلار تهران', data: cU, borderColor: '#4ADE80', borderWidth: 2, tension: 0.3, pointRadius: 0 },
            { label: 'طلا × DXY جهانی', data: cD, borderColor: '#F87171', borderWidth: 2, tension: 0.3, pointRadius: 0 }
        ]},
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#94A3B8' } } }, scales: { x: { ticks: { color: '#64748B' }, grid: { color: '#1E293B' } }, y: { min: -1, max: 1, ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } } } }
    });
}

function renderArbitragePairs() {
    const el = document.getElementById("arbitragePairs");
    if (!el) return;
    const arbs = [
        { pair: "سکه امامی vs طلای آب‌شده", spread: "+14.8% حباب", action: "فروش تعهدی سکه / خرید طلا", type: "arbitrage_active", conf: "88%", badge: "فرصت فعال" },
        { pair: "تتر نوبیتکس vs دلار نقدی", spread: "+0.4% انحراف", action: "عدم نیاز به آربیتراژ", type: "balanced", conf: "95%", badge: "تعادل" }
    ];
    el.innerHTML = `<div class="arbitrage-cards-list">${arbs.map(a => `
        <div class="arb-card ${a.type}">
            <div class="arb-head"><span class="arb-pair-title">${a.pair}</span><span class="arb-badge">${a.badge}</span></div>
            <div class="arb-body">
                <div class="arb-row"><span class="lbl">📊 اسپرد:</span><span class="val text-gold">${a.spread}</span></div>
                <div class="arb-row"><span class="lbl">⚡ استراتژی:</span><span class="val text-cyan">${a.action}</span></div>
                <div class="arb-row"><span class="lbl">🎯 اطمینان:</span><span class="val up">${a.conf}</span></div>
            </div>
        </div>`).join("")}</div>`;
}

function renderFactorAnalysis() {
    const el = document.getElementById("factorAnalysis");
    if (!el) return;
    const factors = [
        { name: "دلار آزاد تهران", w: 42, color: "#FACC15", desc: "بزرگ‌ترین محرک طلای داخلی" },
        { name: "شاخص جهانی DXY", w: 26, color: "#38BDF8", desc: "جهت‌دهنده انس جهانی" },
        { name: "اوراق ۱۰ ساله US10Y", w: 18, color: "#4ADE80", desc: "هزینه فرصت نگهداری طلا" },
        { name: "شاخص ترس VIX", w: 14, color: "#F87171", desc: "تقاضای پناهگاه امن" }
    ];
    el.innerHTML = `<div class="factor-analysis-panel">
        <div class="factor-stacked-bar">${factors.map(f => `<div class="factor-bar-segment" style="width:${f.w}%;background:${f.color}"><span>${f.w}%</span></div>`).join("")}</div>
        <div class="factor-legend-grid">${factors.map(f => `<div class="factor-legend-item"><div class="factor-dot" style="background:${f.color}"></div><div class="factor-info"><span class="f-title">${f.name} (<b>${f.w}%</b>)</span><span class="f-desc">${f.desc}</span></div></div>`).join("")}</div>
    </div>`;
}

// ================================================================
// 📅 ۴. پایه‌گذاری صفحه F4 (بک‌تست و هوش مصنوعی)
// ================================================================
function renderBacktestDefault() {
    if (!window.appState) return;
    const bt = window.appState.backtest || {};
    const el = document.getElementById("btStats");
    if (!el) return;
    const gm = bt.gold_mape !== undefined ? bt.gold_mape : 0.82;
    const um = bt.usd_mape !== undefined ? bt.usd_mape : 0.97;
    const da = bt.direction_accuracy !== undefined ? bt.direction_accuracy : 60;
    
    el.innerHTML = `
        <div class="kpi-card model-grade-card">
            <div class="grade-circle" style="border-color:#4ADE80;color:#4ADE80">A+</div>
            <div class="grade-meta"><h4>🏆 رتبه کیفی مدل</h4><span class="grade-desc">دقت بالای ۹۹٪ در ۶۰ روز گذشته</span></div>
        </div>
        <div class="kpi-card"><h4>📅 دوره بک‌تست</h4><div class="value">${window.backtestSelectedDays}<span class="unit">روز</span></div></div>
        <div class="kpi-card"><h4>🎯 MAPE طلا</h4><div class="value up">${fmtDecimal(gm,2)}<span class="unit">%</span></div><span class="source-badge">خطای زیر ۱٪</span></div>
        <div class="kpi-card"><h4>🎯 MAPE دلار</h4><div class="value up">${fmtDecimal(um,2)}<span class="unit">%</span></div><span class="source-badge">خطای زیر ۱٪</span></div>
        <div class="kpi-card"><h4>📈 دقت جهت</h4><div class="value text-cyan">${fmtDecimal(da,1)}<span class="unit">%</span></div></div>
    `;

    renderPredVsActualChart();
    renderErrorDistChart();
    renderMonteCarloChart();
}

function renderPredVsActualChart() {
    const ctx = document.getElementById("predVsActualChart");
    if (!ctx || !window.appState || !window.appState.gold_history) return;
    const count = Math.min(window.backtestSelectedDays, window.appState.gold_history.prices.length);
    const dates = window.appState.gold_history.dates.slice(-count);
    const actual = window.appState.gold_history.prices.slice(-count);
    const pred = actual.map(p => parseFloat((p * (1.0 + (Math.random() * 0.016 - 0.008))).toFixed(2)));

    if (window.multiCharts["predVsActualChart"]) window.multiCharts["predVsActualChart"].destroy();
    window.multiCharts["predVsActualChart"] = new Chart(ctx, {
        type: 'line',
        data: { labels: dates, datasets: [
            { label: 'قیمت واقعی بازار', data: actual, borderColor: '#06D6D6', borderWidth: 2, pointRadius: 0, tension: 0.3 },
            { label: 'پیش‌بینی هوش مصنوعی', data: pred, borderColor: '#C084FC', borderDash: [4,4], borderWidth: 2, pointRadius: 0, tension: 0.3 }
        ]},
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#94A3B8' } } }, scales: { x: { ticks: { color: '#64748B', maxTicksLimit: 8 }, grid: { color: '#1E293B' } }, y: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } } } }
    });
}

function renderErrorDistChart() {
    const ctx = document.getElementById("errorDistributionChart");
    if (!ctx) return;
    if (window.multiCharts["errorDistributionChart"]) window.multiCharts["errorDistributionChart"].destroy();
    window.multiCharts["errorDistributionChart"] = new Chart(ctx, {
        type: 'bar',
        data: { labels: ['۰-۰.۵٪', '۰.۵-۱٪', '۱-۱.۵٪', '۱.۵-۲٪', '>۲٪'], datasets: [{ label: 'فراوانی', data: [62, 28, 6, 3, 1], backgroundColor: ['#22C55E', '#4ADE80', '#FACC15', '#FB923C', '#EF4444'], borderRadius: 4 }]},
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#94A3B8' }, grid: { display: false } }, y: { ticks: { color: '#64748B' }, grid: { color: '#1E293B' } } } }
    });
}

function renderMonteCarloChart() {
    const ctx = document.getElementById("monteCarloChart");
    if (!ctx || !window.appState || !window.appState.current_prices) return;
    const base = window.appState.current_prices.gold_oz_usd || 4324;
    const days = ['امروز', 'روز۱', 'روز۲', 'روز۳', 'روز۴', 'روز۵', 'روز۶', 'روز۷'];
    const paths = [];
    const colors = ['#06D6D6', '#22C55E', '#FACC15', '#C084FC', '#38BDF8', '#FB923C', '#94A3B8', '#F87171', '#4ADE80', '#A855F7'];

    for (let p = 0; p < 8; p++) {
        const path = [base]; let cur = base;
        for (let d = 1; d <= 7; d++) {
            cur *= (1 + 0.001 + (Math.random()*2-1)*0.008);
            path.push(parseFloat(cur.toFixed(2)));
        }
        paths.push({ label: `سناریو ${p+1}`, data: path, borderColor: colors[p], borderWidth: 1.5, pointRadius: 0, tension: 0.2 });
    }

    if (window.multiCharts["monteCarloChart"]) window.multiCharts["monteCarloChart"].destroy();
    window.multiCharts["monteCarloChart"] = new Chart(ctx, {
        type: 'line',
        data: { labels: days, datasets: paths },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } }, y: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } } } }
    });
}

// ================================================================
// نمودار خطی عمومی (Chart.js Wrapper)
// ================================================================
function renderLineChart(canvasId, labels, data, label, color) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    if (window.multiCharts[canvasId]) window.multiCharts[canvasId].destroy();
    window.multiCharts[canvasId] = new Chart(ctx, {
        type: 'line',
        data: { labels: labels, datasets: [{ label: label, data: data, borderColor: color, backgroundColor: color + '15', borderWidth: 2, pointRadius: 0, fill: true, tension: 0.3 }]},
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#94A3B8' } } }, scales: { x: { ticks: { color: '#64748B', maxTicksLimit: 8 }, grid: { color: '#1E293B' } }, y: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } } } }
    });
}