            datasets: [{
                label: 'درصد فراوانی روزها',
                data: [62, 28, 6, 3, 1], // ۹۰٪ خطاها زیر ۱ درصد
                backgroundColor: ['#22C55E', '#4ADE80', '#FACC15', '#FB923C', '#EF4444'],
