module DataFetcher

using Dates, Statistics, JSON3, SQLite, DBInterface

export fetch_all_data, fetch_upcoming_events, CurrencyData

struct CurrencyData
    symbol::String
    name_fa::String
    prices::Vector{Float64}
    dates::Vector{DateTime}
    latest::Float64
    change_pct::Float64
end

const BROWSER_UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
const DB_PATH = joinpath(@__DIR__, "..", "data", "forecast.db")

function fetch_raw_url(url::String; timeout::Int=8)::Union{String, Nothing}
    try
        cmd = `curl.exe -s -L -k --connect-timeout $timeout --max-time $(timeout + 4) -H "User-Agent: $BROWSER_UA" $url`
        out = read(cmd, String)
        length(out) > 10 && return out
    catch
    end
    return nothing
end

# ------------------------------------------------------------------
# دریافت قیمت زنده و کاملاً لحظه‌ای فارکس از ExchangeRate-API (ثانیه‌ای)
# ------------------------------------------------------------------
function fetch_realtime_forex_rates()::Dict{String, Float64}
    res = Dict{String, Float64}()
    # این API قیمت‌های فارکس را به صورت ۱۰۰٪ زنده و مستقیم مخابره می‌کند
    raw = fetch_raw_url("https://open.er-api.com/v6/latest/USD"; timeout=6)
    raw === nothing && return res
    try
        j = JSON3.read(raw)
        if haskey(j, :rates)
            for (k, v) in pairs(j.rates)
                res[string(k)] = Float64(v)
            end
        end
    catch
    end
    return res
end

# ------------------------------------------------------------------
# دریافت قیمت زنده از تابلوی TGJU
# ------------------------------------------------------------------
function extract_tgju_price(html::String, row_key::String)::Float64
    pat = Regex("<tr[^>]*data-market-row=[\"']" * row_key * "[\"'][^>]*>([\\s\\S]*?)</tr>")
    m = match(pat, html)
    if m !== nothing
        row_content = m.captures[1]
        cell_pat = Regex("<td[^>]*class=[\"'][^\"']*nf[^\"']*[\"'][^>]*>\\s*([0-9,.]+)\\s*</td>")
        m_cell = match(cell_pat, row_content)
        if m_cell !== nothing
            num_clean = replace(m_cell.captures[1], "," => "")
            v = tryparse(Float64, num_clean)
            v !== nothing && v > 0.0 && return v
        end
    end
    return 0.0
end

function fetch_tgju_live()::Dict{String, Float64}
    res = Dict{String, Float64}()
    html = fetch_raw_url("https://www.tgju.org"; timeout=6)
    html === nothing && return res

    usd = extract_tgju_price(html, "price_dollar_rl")
    usd <= 0.0 && (usd = extract_tgju_price(html, "price_dollar"))
    usd > 0.0 && (res["usd_toman"] = usd / 10.0)

    g18 = extract_tgju_price(html, "geram18")
    g18 > 0.0 && (res["gold_18k_toman"] = g18 / 10.0)

    ons = extract_tgju_price(html, "ons")
    ons > 0.0 && (res["gold_oz"] = ons)

    return res
end

# ------------------------------------------------------------------
# دریافت آمار زنده نوبیتکس (ثانیه‌ای)
# ------------------------------------------------------------------
function fetch_live_nobitex_stats()::Dict{String, Float64}
    res = Dict{String, Float64}()
    raw = fetch_raw_url("https://api.nobitex.ir/market/stats"; timeout=5)
    raw === nothing && return res
    try
        j = JSON3.read(raw)
        if haskey(j, :stats)
            for (k, v) in pairs(j.stats)
                if haskey(v, :latest)
                    val = tryparse(Float64, string(v.latest))
                    if val !== nothing && val > 0.0
                        res[lowercase(string(k))] = val
                    end
                end
            end
        end
    catch
    end
    return res
end

# ------------------------------------------------------------------
# دریافت تاریخچه UDF از نوبیتکس و والکس
# ------------------------------------------------------------------
function fetch_crypto_udf_history(symbol::String, days::Int)::Tuple{Vector{Float64}, Vector{DateTime}}
    prices = Float64[]
    dates = DateTime[]
    to_ts = Int(round(datetime2unix(now())))
    from_ts = Int(round(datetime2unix(now() - Day(days + 15))))
    
    url_nobi = "https://api.nobitex.ir/market/udf/history?symbol=$symbol&resolution=D&from=$from_ts&to=$to_ts"
    raw_nobi = fetch_raw_url(url_nobi; timeout=6)
    if raw_nobi !== nothing
        try
            j = JSON3.read(raw_nobi)
            if haskey(j, :s) && j.s == "ok" && haskey(j, :c) && haskey(j, :t)
                for i in 1:length(j.c)
                    p = tryparse(Float64, string(j.c[i]))
                    p !== nothing && p > 0.0 && push!(prices, p)
                    push!(dates, unix2datetime(Float64(j.t[i])))
                end
                length(prices) > 2 && return prices, dates
            end
        catch
        end
    end
    return prices, dates
end

# ------------------------------------------------------------------
# دریافت تاریخچه واقعی ارزهای فارکس از Frankfurter API
# ------------------------------------------------------------------
function fetch_frankfurter_history(days::Int, symbols::Vector{String})::Dict{String, Tuple{Vector{Float64}, Vector{DateTime}}}
    res = Dict{String, Tuple{Vector{Float64}, Vector{DateTime}}}()
    for s in symbols; res[s] = (Float64[], DateTime[]); end

    end_date = today()
    start_date = end_date - Day(days)
    sym_str = join(symbols, ",")
    url = "https://api.frankfurter.app/$(start_date)..$(end_date)?from=USD&to=$sym_str"
    raw = fetch_raw_url(url; timeout=7)
    raw === nothing && return res

    try
        j = JSON3.read(raw)
        if haskey(j, :rates)
            temp = Dict{String, Vector{Tuple{DateTime, Float64}}}()
            for s in symbols; temp[s] = Tuple{DateTime, Float64}[]; end

            for (date_str, val_obj) in pairs(j.rates)
                dt = DateTime(Date(string(date_str)))
                for s in symbols
                    ssym = Symbol(s)
                    if haskey(val_obj, ssym)
                        val = tryparse(Float64, string(val_obj[ssym]))
                        val !== nothing && push!(temp[s], (dt, val))
                    end
                end
            end

            for s in symbols
                sorted = sort(temp[s], by=x->x[1])
                res[s] = ([x[2] for x in sorted], [x[1] for x in sorted])
            end
        end
    catch
    end
    return res
end

# ------------------------------------------------------------------
# همگام‌سازی داده‌ها با Forward-Fill
# ------------------------------------------------------------------
function align_series_to_dates(source_prices::Vector{Float64}, source_dates::Vector{DateTime}, target_dates::Vector{DateTime})::Vector{Float64}
    isempty(source_prices) && return fill(0.0, length(target_dates))
    
    aligned = Float64[]
    for t_dt in target_dates
        idx = findlast(d -> d <= t_dt, source_dates)
        if idx !== nothing
            push!(aligned, source_prices[idx])
        else
            push!(aligned, source_prices[1])
        end
    end
    return aligned
end

# ------------------------------------------------------------------
# تجمیع نهایی فوق‌العاده زنده و مستقیم بازارها
# ------------------------------------------------------------------
function fetch_all_data(history_days::Int=180)
    days = clamp(history_days, 60, 365)
    
    # استعلام زنده و هم‌زمان تمام بازارها
    tgju_live = fetch_tgju_live()
    nobi_stats = fetch_live_nobitex_stats()
    live_forex = fetch_realtime_forex_rates()

    # ۱. دلار تهران
    usd_live_toman = get(tgju_live, "usd_toman", 0.0)
    usd_source = "TGJU"
    if usd_live_toman <= 0.0 && haskey(nobi_stats, "usdt-rls")
        usd_live_toman = nobi_stats["usdt-rls"] / 10.0
        usd_source = "Nobitex"
    end

    # ۲. انس جهانی طلا
    gold_live_usd = get(tgju_live, "gold_oz", 0.0)
    gold_source = "TGJU"
    if gold_live_usd <= 0.0 && haskey(nobi_stats, "paxg-usdt")
        gold_live_usd = nobi_stats["paxg-usdt"]
        gold_source = "Nobitex"
    end

    # ۳. طلای ۱۸ عیار
    g18_live_toman = get(tgju_live, "gold_18k_toman", 0.0)
    g18_source = "TGJU"

    # دریافت تاریخچه‌های واقعی
    raw_usd_p, raw_usd_d = fetch_crypto_udf_history("USDTIRT", days)
    if !isempty(raw_usd_p)
        med = median(raw_usd_p)
        med > 300000.0 && (raw_usd_p = raw_usd_p ./ 10.0)
    end

    raw_gold_p, raw_gold_d = fetch_crypto_udf_history("PAXGUSDT", days)

    base_dates = !isempty(raw_gold_d) ? raw_gold_d : (!isempty(raw_usd_d) ? raw_usd_d : [DateTime(today() - Day(days - i)) for i in 1:days])

    gold_prices = align_series_to_dates(raw_gold_p, raw_gold_d, base_dates)
    if gold_live_usd > 0.0 && !isempty(gold_prices)
        gold_prices[end] = gold_live_usd
    end

    usd_prices = align_series_to_dates(raw_usd_p, raw_usd_d, base_dates)
    if usd_live_toman > 0.0 && !isempty(usd_prices)
        usd_prices[end] = usd_live_toman
    end

    troy_gram = 31.1034768
    iran_prices = Float64[]
    for i in 1:length(base_dates)
        push!(iran_prices, (gold_prices[i] / troy_gram) * 0.75 * usd_prices[i] * 1.012)
    end
    if g18_live_toman > 0.0 && !isempty(iran_prices)
        iran_prices[end] = g18_live_toman
    end

    # ۴. تاریخچه و قیمت‌های لحظه‌ای رمزارزها (تزریق زنده از نوبیتکس)
    raw_btc_p, raw_btc_d = fetch_crypto_udf_history("BTCUSDT", days)
    raw_eth_p, raw_eth_d = fetch_crypto_udf_history("ETHUSDT", days)
    raw_sol_p, raw_sol_d = fetch_crypto_udf_history("SOLUSDT", days)

    btc_prices = align_series_to_dates(raw_btc_p, raw_btc_d, base_dates)
    eth_prices = align_series_to_dates(raw_eth_p, raw_eth_d, base_dates)
    sol_prices = align_series_to_dates(raw_sol_p, raw_sol_d, base_dates)

    # تزریق ۱۰۰٪ زنده آخرین نرخ‌های کریپتو به انتهای تاریخچه
    haskey(nobi_stats, "btc-usdt") && !isempty(btc_prices) && (btc_prices[end] = nobi_stats["btc-usdt"])
    haskey(nobi_stats, "eth-usdt") && !isempty(eth_prices) && (eth_prices[end] = nobi_stats["eth-usdt"])
    haskey(nobi_stats, "sol-usdt") && !isempty(sol_prices) && (sol_prices[end] = nobi_stats["sol-usdt"])

    # ۵. تاریخچه و قیمت‌های لحظه‌ای فارکس (تزریق زنده از ExchangeRate-API)
    fx_symbols = ["EUR", "GBP", "JPY", "CHF", "CAD", "AUD", "CNY", "TRY"]
    raw_fx_data = fetch_frankfurter_history(days, fx_symbols)

    currencies = CurrencyData[]
    names_fa = Dict(
        "EUR"=>"یورو", "GBP"=>"پوند", "JPY"=>"ین ژاپن", "CHF"=>"فرانک سوئیس",
        "CAD"=>"دلار کانادا", "AUD"=>"دلار استرالیا", "CNY"=>"یوان چین", "TRY"=>"لیر ترکیه"
    )
    rates = Dict{String, Float64}("USD" => 1.0)

    for sym in fx_symbols
        r_prices, r_dates = raw_fx_data[sym]
        aligned_prices = align_series_to_dates(r_prices, r_dates, base_dates)
        
        # استخراج نرخ لحظه‌ای و ثانیه‌ای از مرجع جهانی ExchangeRate-API
        latest_val = get(live_forex, sym, (isempty(aligned_prices) ? 1.0 : aligned_prices[end]))
        
        # تزریق نرخ فوق‌زنده به انتهای تاریخچه جهت اسکنر و چارت زنده
        if !isempty(aligned_prices)
            aligned_prices[end] = latest_val
        end
        rates[sym] = latest_val
        
        push!(currencies, CurrencyData(
            sym, get(names_fa, sym, sym), aligned_prices, base_dates, latest_val, 0.0
        ))
    end

    # چاپ قیمت‌های لحظه‌ای در کنسول جهت نظارت زنده
    println("       ✅ [زنده] دلار تهران: $(round(Int, usd_prices[end])) | انس طلا: $(round(gold_prices[end], digits=2)) USD")
    println("       ✅ [زنده] یورو جهانی: $(rates["EUR"]) USD | پوند جهانی: $(rates["GBP"]) USD")
    println("       ✅ [زنده] بیت‌کوین: $(btc_prices[end]) USD | سولانا: $(sol_prices[end]) USD")

    return Dict{String,Any}(
        "gold_oz"    => Dict("prices" => gold_prices, "dates" => base_dates, "provider" => gold_source),
        "usd_irr"    => Dict("prices" => usd_prices, "dates" => base_dates, "provider" => usd_source),
        "iran_gold"  => Dict("prices" => iran_prices, "dates" => base_dates, "provider" => g18_source),
        "currencies" => currencies,
        "rates"      => rates,
        "btc" => Dict("prices" => btc_prices, "dates" => base_dates, "provider" => "Nobitex"),
        "eth" => Dict("prices" => eth_prices, "dates" => base_dates, "provider" => "Nobitex"),
        "sol" => Dict("prices" => sol_prices, "dates" => base_dates, "provider" => "Nobitex")
    )
end

function fetch_upcoming_events(days_ahead::Int=14)
    return Dict[]
end

end