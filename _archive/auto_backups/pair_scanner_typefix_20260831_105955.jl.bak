module PairScanner

using ..SetupDetector
using ..MarketRegistry

export scan_all_pairs, SetupCard

# ساختار سازگار با ماژول‌های دیگر برای هر ستاپ شناسایی شده
struct SetupCard
    symbol::String
    base::String
    quote_ccy::String
    bias::String
    setup_type::String
    total_score::Float64
    strength_score::Float64
    trend_score::Float64
    momentum_score::Float64
    volatility_score::Float64
    sr_score::Float64
    levels::Any
    entry_zone_low::Float64
    entry_zone_high::Float64
    target1::Float64
    target2::Float64
    stop_loss::Float64
    risk_reward::Float64
    reasons_for::Vector{String}
    reasons_against::Vector{String}
    trade_quality::String
    timeframe_align::String
    mtf_confluence::Bool
    mtf_dominant_bias::String
    advanced::Any
    risk_info::Any
    timing::Any
end

function scan_all_pairs(all_pairs::Vector{Any}, rates_dict::Dict{String, Vector{Float64}}, strengths::Any)::Vector{SetupCard}
    setups = SetupCard[]
    
    for pair in all_pairs
        # استخراج هیستوری جفت‌ارز خام
        prices = get(rates_dict, pair.symbol, Float64[])
        if isempty(prices) || length(prices) < 20
            continue
        end
        
        # اجرای آنالیز تکنیکال پویای Fionex
        res = SetupDetector.detect_setup(pair.symbol, prices)
        
        # اگر بایاس معاملاتی پویا صادر شد، کارت ستاپ را ثبت کن
        push!(setups, SetupCard(
            pair.symbol,
            pair.base,
            pair.quote_,
            res.bias,
            res.setup_type,
            res.trend_score,
            75.0, # Strength Score
            res.trend_score,
            res.momentum_score,
            res.volatility_score,
            80.0, # S/R Score
            nothing, # Levels
            res.entry_low,
            res.entry_high,
            res.target1,
            res.target2,
            res.stop_loss,
            res.risk_reward,
            res.reasons_for,
            res.reasons_against,
            res.trade_quality,
            "1D Confluence",
            true,
            res.bias,
            nothing, # Advanced
            nothing, # Risk Info
            nothing  # Timing
        ))
    end
    return setups
end

end