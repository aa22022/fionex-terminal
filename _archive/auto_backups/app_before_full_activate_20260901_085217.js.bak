// ================================================================
// Fionex Terminal Frontend Core Logic v3.0 (Quant + MTF Support)
// ================================================================

window.appState = null;
let goldChart = null;

document.addEventListener("DOMContentLoaded", () => {
    initNavigation();
    loadData();
    setInterval(loadData, 180000); // به‌روزرسانی هوشمند هر ۳ دقیقه
    
    document.getElementById("btnRefresh").addEventListener("click", () => {
        const btn = document.getElementById("btnRefresh");
        btn.classList.add("loading");
        fetch("/api/refresh")
            .then(r => r.json())
            .then(() => {
                loadData();
                btn.classList.remove("loading");
            })
            .catch(() => btn.classList.remove("loading"));
    });
});

function initNavigation() {
    const buttons = document.querySelectorAll(".nav-btn");
    buttons.forEach(btn => {
        btn.addEventListener("click", () => {
            const pageId = btn.getAttribute("data-page");
            switchPage(pageId);
        });
    });

    // کلیدهای شرت‌کات F1-F6
    document.addEventListener("keydown", (e) => {
        const hotkeys = {
            "F1": "page-overview",
            "F2": "page-gold",
            "F3": "page-fx",
            "F4": "page-relations",
            "F5": "page-backtest",
            "F6": "page-reports"
        };
        if (hotkeys[e.key]) {
            e.preventDefault();
            switchPage(hotkeys[e.key]);
        }
    });
}

function switchPage(pageId) {
    // پنهان کردن تمام صفحات به صورت صریح با غلبه بر استایل درون‌خطی HTML
    document.querySelectorAll(".page-section").forEach(p => {
        p.classList.remove("active");
        p.style.setProperty("display", "none", "important"); 
    });
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
    
    const targetPage = document.getElementById(pageId);
    if (targetPage) {
        targetPage.classList.add("active");
        // نمایش صفحه هدف با اولویت بالا
        targetPage.style.setProperty("display", "block", "important");
    }
    
    const targetBtn = document.querySelector(`.nav-btn[data-page="${pageId}"]`);
    if (targetBtn) targetBtn.classList.add("active");
    
    // رندر مجدد نمودارها و ستاپ‌ها
    try {
        if (pageId === "page-overview" && window.appState) {
            setTimeout(renderOverview, 5);
        } else if (pageId === "page-fx" && window.appState) {
            setTimeout(renderFX, 5);
        } else if (pageId === "page-relations" && window.appState) {
            setTimeout(renderRelations, 5);
        } else if (pageId === "page-backtest" && window.appState) {
            setTimeout(renderBacktestDefault, 5);
        }
    } catch (err) {
        console.error("Error in page render:", err);
    }
}

function loadData() {
    const start = performance.now();
    fetch("/api/data")
        .then(res => res.json())
        .then(data => {
            if (data.status === "success") {
                window.appState = data;
                document.getElementById("statusDot").className = "status-dot online";
                document.getElementById("navTime").innerText = new Date().toLocaleTimeString("fa-IR");
                const latency = Math.round(performance.now() - start);
                document.getElementById("alertBanner").innerHTML = `<span>⚡ اتصال زنده برقرار است | تاخیر پاسخ سرور: ${latency} میلی‌ثانیه</span>`;
                
                // بروزرسانی تمام صفحات لود شده
                renderOverview();
                renderFX();
                renderRelations();
                renderBacktestDefault();
            } else {
                document.getElementById("alertBanner").innerHTML = `<span class="down">⚠️ ${data.message || 'خطا در بارگذاری اولیه داده‌ها'}</span>`;
            }
        })
        .catch(err => {
            document.getElementById("statusDot").className = "status-dot offline";
            document.getElementById("alertBanner").innerHTML = `<span class="down">❌ خطا در ارتباط با سرور بک‌اند Fionex</span>`;
        });
}

// ================================================================
// فرمت‌کننده‌های ریاضی لایه نمایش
// ================================================================
function fmtNum(num) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US');
}

function fmtDecimal(num, digits = 2) {
    if (num === null || num === undefined || isNaN(num)) return "--";
    return Number(num).toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function pctSign(num) {
    if (num === null || num === undefined || isNaN(num)) return "";
    return num > 0 ? "+" : "";
}

function fmtSmart(num) {
    if (num === null || num === undefined || isNaN(num) || num === 0) return "--";
    const n = Math.abs(num);
    if (n < 10) return Number(num).toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
    if (n < 1000) return Number(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return Math.round(Number(num)).toLocaleString('en-US');
}

function strengthColor(score) {
    if (score >= 75) return 'linear-gradient(90deg, #4ADE80, #22C55E)';
    if (score >= 60) return 'linear-gradient(90deg, #06D6D6, #22D3EE)';
    if (score >= 45) return 'linear-gradient(90deg, #FDE047, #FACC15)';
    if (score >= 30) return 'linear-gradient(90deg, #FB923C, #F97316)';
    return 'linear-gradient(90deg, #F87171, #EF4444)';
}

function biasClass(bias) {
    if (!bias) return 'neutral';
    const b = String(bias).toUpperCase();
    if (b.includes('BUY') || b.includes('صعودی')) return 'buy';
    if (b.includes('SELL') || b.includes('نزولی')) return 'sell';
    return 'neutral';
}

function biasTextFa(bias) {
    if (!bias) return 'خنثی';
    const b = String(bias).toUpperCase();
    if (b.includes('BUY')) return 'خرید';
    if (b.includes('SELL')) return 'فروش';
    return 'خنثی';
}

function gradeColor(quality) {
    if (quality === 'A+') return '#4ADE80';
    if (quality === 'A') return '#06D6D6';
    if (quality === 'B') return '#FDE047';
    if (quality === 'C') return '#FB923C';
    return '#F87171';
}

// ================================================================
// رندرساز کارت ۳ستونی فوق پیشرفته کوانت Fionex v3.0 (تایم‌فریم متقاطع)
// ================================================================
function renderProSetupCard(s) {
    try {
        const bias = (s.bias || '').toUpperCase();
        const biasClassCard = bias === 'BUY' ? 'buy' : bias === 'SELL' ? 'sell' : 'neutral';
        const biasIcon = bias === 'BUY' ? '📈' : bias === 'SELL' ? '📉' : '➖';
        const biasText = bias === 'BUY' ? 'خرید سویینگ' : bias === 'SELL' ? 'فروش سویینگ' : 'بدون ترید';
        const gradeCol = gradeColor(s.trade_quality || 'B');
        const confidence = s.confidence || 50;
        
        // متریک‌های کوانت لایو فاز ۲
        const q = s.real_quant || {};
        // گزارش مالتی‌تایم فریم فاز ۳
        const mtf = s.mtf_report || {};

        // Hurst Exponent Labeling
        let hurstText = "رنج نوسانی";
        let hurstClass = "neutral";
        if (q.hurst_exponent > 0.58) { hurstText = "رونددار فراکتالی"; hurstClass = "buy"; }
        else if (q.hurst_exponent < 0.42) { hurstText = "اشباع (برگشت میانگین)"; hurstClass = "sell"; }

        return `
            <div class="pro-setup-card ${biasClassCard}">
                <div class="pro-setup-header">
                    <div class="pro-symbol-block">
                        <span class="pro-symbol">${s.symbol}</span>
                        <span class="pro-bias-badge ${biasClassCard}">${biasIcon} ${biasText}</span>
                    </div>
                    <div class="pro-grade" style="background: ${gradeCol}; color: #0B0E14" title="شاخص کل ریسک به بازدهی">
                        ${s.trade_quality || 'B'}
                    </div>
                </div>

                <!-- 🔄 بخش ۱: وضعیت تاییدیه همسویی ۳ تایم‌فریم (فاز ۳) -->
                <div class="mtf-alignment-panel">
                    <div class="mtf-title">🔄 تایید همگرایی روندها (H1 / H4 / D1):</div>
                    <div class="mtf-grid">
                        <div class="mtf-col ${biasClass(mtf.h1_bias)}">
                            <span class="tf-name">H1 (۱ساعته)</span>
                            <span class="tf-val">${biasTextFa(mtf.h1_bias)}</span>
                            <span class="tf-score">${fmtDecimal(mtf.h1_score, 0)}%</span>
                        </div>
                        <div class="mtf-col ${biasClass(mtf.h4_bias)}">
                            <span class="tf-name">H4 (۴ساعته)</span>
                            <span class="tf-val">${biasTextFa(mtf.h4_bias)}</span>
                            <span class="tf-score">${fmtDecimal(mtf.h4_score, 0)}%</span>
                        </div>
                        <div class="mtf-col ${biasClass(mtf.d1_bias)}">
                            <span class="tf-name">D1 (روزانه)</span>
                            <span class="tf-val">${biasTextFa(mtf.d1_bias)}</span>
                            <span class="tf-score">${fmtDecimal(mtf.d1_score, 0)}%</span>
                        </div>
                    </div>
                </div>

                <div class="pro-confidence">
                    <div class="confidence-label">همگرایی کل سیستم:</div>
                    <div class="confidence-bar">
                        <div class="confidence-fill" style="width: ${confidence}%; background: ${gradeCol}"></div>
                    </div>
                    <div class="confidence-value">${fmtDecimal(confidence, 1)}%</div>
                </div>

                <div class="pro-setup-body">
                    <div class="pro-metric">
                        <span class="lbl">💵 ناحیه ورود:</span>
                        <span class="val">${fmtSmart(s.entry_low)} - ${fmtSmart(s.entry_high)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🎯 تارگت ۱:</span>
                        <span class="val up">${fmtSmart(s.target1)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🎯 تارگت ۲:</span>
                        <span class="val up">${fmtSmart(s.target2)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🛑 حد ضرر:</span>
                        <span class="val down">${fmtSmart(s.stop_loss)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">⚖️ نسبت R/R:</span>
                        <span class="val gold">${fmtDecimal(s.risk_reward, 2)}</span>
                    </div>
                    <div class="pro-metric">
                        <span class="lbl">🕐 تایم‌فریم:</span>
                        <span class="val">${s.timeframe_align || '1D'}</span>
                    </div>
                </div>

                <!-- 🔬 بخش ۲: نمایش ۸ فرمول محاسبات آماری کوانت (فاز ۲) -->
                <div class="quant-extra-panel">
                    <div class="quant-panel-title">🔬 متریک‌های کوانت و رژیم بازار:</div>
                    <div class="quant-metrics-grid">
                        <div class="q-metric" title="نقطه حجم متمرکز (Point of Control)">
                            <span class="q-lbl">نقطه کنترل حجم (POC):</span>
                            <span class="q-val text-cyan">${q.poc_price ? fmtSmart(q.poc_price) : '--'}</span>
                        </div>
                        <div class="q-metric" title="تاییدیه فراکتال ضریب ههرست">
                            <span class="q-lbl">ضریب ههرست (Hurst):</span>
                            <span class="q-val text-gold">${q.hurst_exponent ? fmtDecimal(q.hurst_exponent, 2) : '0.50'} <span class="badge ${hurstClass}">${hurstText}</span></span>
                        </div>
                        <div class="q-metric" title="پایداری ریسک در بازه طولانی">
                            <span class="q-lbl">ضریب شارپ / سورتینو:</span>
                            <span class="q-val text-green">${q.sharpe ? fmtDecimal(q.sharpe, 2) : '1.0'} / ${q.sortino ? fmtDecimal(q.sortino, 2) : '1.2'}</span>
                        </div>
                        <div class="q-metric">
                            <span class="q-lbl">ایچیموکو ابر تعادلی:</span>
                            <span class="q-val">${q.wyckoff_phase_fa || '--'}</span>
                        </div>
                        <div class="q-metric">
                            <span class="q-lbl">سطح فیبوناچی کلیدی:</span>
                            <span class="q-val">${q.fib_nearest_pct || '61.8%'} در ${q.fib_nearest_level ? fmtSmart(q.fib_nearest_level) : '--'}</span>
                        </div>
                        <div class="q-metric">
                            <span class="q-lbl">شکست ساختار (BOS):</span>
                            <span class="q-val text-cyan">${q.bos_status || 'NONE'} (${q.bos_price ? fmtSmart(q.bos_price) : '--'})</span>
                        </div>
                        <div class="q-metric">
                            <span class="q-lbl">سفارشات نهادی (OB):</span>
                            <span class="q-val">خرید: ${q.bullish_ob ? fmtSmart(q.bullish_ob) : '--'} | فروش: ${q.bearish_ob ? fmtSmart(q.bearish_ob) : '--'}</span>
                        </div>
                        <div class="q-metric">
                            <span class="q-lbl">شکاف ارزش (FVG):</span>
                            <span class="q-val">${q.fvg_active_count ? q.fvg_active_count + ' شکاف فعال' : 'بدون شکاف'}</span>
                        </div>
                    </div>
                </div>

                ${(s.reasons_for && s.reasons_for.length > 0) ? `
                    <div class="pro-reasons">
                        <div class="reasons-title">✅ تاییدیه همگرایی ریاضی:</div>
                        ${s.reasons_for.slice(0, 3).map(r => `<div class="reason-item">• ${r}</div>`).join('')}
                    </div>
                ` : ''}
            </div>
        `;
    } catch (e) {
        console.error("خطا در رندر کارت ستاپ:", e);
        return '';
    }
}

// ================================================================
// رندرساز صفحه F3
// ================================================================
function renderFX() {
    try {
        if (!window.appState || !window.appState.fx_scan) return;
        const scan = window.appState.fx_scan;
        const setups = scan.setups || [];
        const strengths = scan.strengths || [];

        const fxEl = document.getElementById("fxSetups");
        const cryptoEl = document.getElementById("cryptoSetups");
        if (!fxEl) return;

        // ساخت پنل قدرت ارزها در بالای صفحه
        let strengthHtml = '';
        if (strengths.length > 0) {
            strengthHtml = `
                <div class="strength-panel">
                    <div class="strength-title">
                        <span>⚡ قدرت لحظه‌ای ارزها (Currency Strength Meter)</span>
                        <span class="strength-legend">قوی‌ترین → ضعیف‌ترین</span>
                    </div>
                    <div class="strength-grid">
                        ${strengths.map((s, i) => `
                            <div class="strength-card rank-${i + 1}">
                                <div class="strength-rank">#${i + 1}</div>
                                <div class="strength-symbol">${s.currency}</div>
                                <div class="strength-name">${s.name_fa || s.currency}</div>
                                <div class="strength-stars">${s.strength_level || '⭐⭐⭐'}</div>
                                <div class="strength-score-bar">
                                    <div class="score-fill" style="width: ${s.score || 50}%; background: ${strengthColor(s.score || 50)}"></div>
                                </div>
                                <div class="strength-score-num">${fmtDecimal(s.score, 1)}%</div>
                                <div class="strength-bias ${biasClass(s.trend_bias)}">${s.trend_bias || 'خنثی'}</div>
                                <div class="strength-momentum">
                                    <span>۵ روزه:</span>
                                    <span class="${(s.momentum_5d || 0) >= 0 ? 'up' : 'down'}">${pctSign(s.momentum_5d)}${fmtDecimal(s.momentum_5d, 2)}%</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    ${strengths.length >= 2 ? `
                    <div class="best-pair-panel">
                        <span class="best-pair-label">🎯 بهترین ترکیب معاملاتی امروز:</span>
                        <span class="best-pair-value">${strengths[0].currency}/${strengths[strengths.length - 1].currency}</span>
                        <span class="best-pair-hint">(خرید قوی‌ترین در برابر ضعیف‌ترین)</span>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        const fxSetups = setups.filter(s => s.category !== "crypto");
        const cryptoSetups = setups.filter(s => s.category === "crypto");

        fxEl.innerHTML = strengthHtml + `
            <div class="setups-cards-grid">
                ${fxSetups.length === 0
                    ? '<div class="no-setup-msg">در حال حاضر ستاپ فعالی برای فارکس یافت نشد.</div>'
                    : fxSetups.map(s => renderProSetupCard(s)).join('')}
            </div>
        `;

        if (cryptoEl) {
            cryptoEl.innerHTML = `
                <div class="setups-cards-grid">
                    ${cryptoSetups.length === 0
                        ? '<div class="no-setup-msg">در حال حاضر ستاپ فعالی برای کریپتو یافت نشد.</div>'
                        : cryptoSetups.map(s => renderProSetupCard(s)).join('')}
                </div>
            `;
        }
    } catch (e) {
        console.error("خطا در رندر تب F3:", e);
    }
}

// ================================================================
// بقیه توابع رندرساز برنامه به صورت تمیز
// ================================================================
