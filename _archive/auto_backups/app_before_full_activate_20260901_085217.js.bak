    el.innerHTML = `
        <div class="kpi-card">
            <h4>💰 انس جهانی طلا</h4>
            <div class="value">${fmtNum(cp.gold_oz_usd)}<span class="unit">USD</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.gold : 'زنده'}</span>
        </div>
        <div class="kpi-card">
            <h4>💵 دلار آزاد تهران</h4>
            <div class="value">${fmtNum(cp.usd_irr)}<span class="unit">تومان</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.usd : 'زنده'}</span>
        </div>
        <div class="kpi-card">
            <h4>🥇 طلای ۱۸ عیار</h4>
            <div class="value">${fmtNum(cp.iran_gold_gram18)}<span class="unit">تومان</span></div>
            <span class="source-badge">${cp.providers ? cp.providers.iran : 'فرمول'}</span>
        </div>
        <div class="kpi-card">
            <h4>🪙 سکه امامی</h4>
            <div class="value">${fmtNum(cp.coin_emami)}<span class="unit">تومان</span></div>
            <span class="source-badge">فرمول رسمی</span>
        </div>
        <div class="kpi-card">
            <h4>📈 شاخص دلار (DXY)</h4>
            <div class="value">${fmtDecimal(cp.dxy_real, 2)}<span class="unit"></span></div>
            <span class="source-badge">Stooq</span>
        </div>
        <div class="kpi-card">
            <h4>🏛️ اوراق ۱۰ ساله آمریکا</h4>
            <div class="value">${fmtDecimal(cp.us10y, 2)}<span class="unit">%</span></div>
            <span class="source-badge">Stooq</span>
        </div>
        <div class="kpi-card">
            <h4>⚠️ شاخص ترس (VIX)</h4>
            <div class="value">${fmtDecimal(cp.vix, 2)}<span class="unit"></span></div>
            <span class="source-badge">CBOE</span>
        </div>
    `;
}

function renderOverview() {
    if (!window.appState) return;
    renderOverviewKpi();
    renderHeatmap();
    renderRegimeInfo();
    renderTopSetups();
    updateTicker();

    const gh = window.appState.gold_history;
    if (gh) renderLineChart("ovChGoldMini", gh.dates, gh.prices, "انس جهانی طلا", "#06D6D6");

    const alertBanner = document.getElementById("alertBanner");
    if (alertBanner && window.appState.market_alert) {
        const ma = window.appState.market_alert;
        alertBanner.innerHTML = `<span>[نوسان: ${ma.level}] - ${ma.message} | انس: ${ma.gold_move}% | دلار: ${ma.usd_move}%</span>`;
    }
}

function renderHeatmap() {
    // پیاده‌سازی نقشه حرارتی
}

function renderRegimeInfo() {
    // پیاده‌سازی رژیم بازار
}

function renderTopSetups() {
    const setups = (window.appState.fx_scan && window.appState.fx_scan.setups) || [];
    const el = document.getElementById("ovTopSetups");
    if (!el) return;
    const top5 = setups.slice(0, 5);
    if (top5.length === 0) {
        el.innerHTML = '<div style="text-align:center;color:#6B7699;padding:20px">در حال حاضر ستاپ فعالی یافت نشد.</div>';
        return;
    }
    el.innerHTML = top5.map(s => renderSetupRow(s)).join("");
}

function renderSetupRow(s) {
    const bias = (s.bias || '').toUpperCase();
    const cls = bias === 'BUY' ? 'up' : bias === 'SELL' ? 'down' : '';
    const biasFa = bias === 'BUY' ? 'خرید' : bias === 'SELL' ? 'فروش' : 'خنثی';
    return `
        <div class="setup-row">
            <span class="sym">${s.symbol}</span>
            <span class="bias ${cls}">${biasFa}</span>
            <span class="quality" style="color: ${gradeColor(s.trade_quality)}">${s.trade_quality}</span>
            <span class="rr">R/R: ${fmtDecimal(s.risk_reward)}</span>
        </div>
    `;
}

function updateTicker() {
    // آپدیت تیکر بالای صفحه
}

function renderLineChart(canvasId, labels, data, label, color) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    if (goldChart) goldChart.destroy();
    goldChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: label,
                data: data,
                borderColor: color,
                backgroundColor: 'rgba(6, 214, 214, 0.05)',
                borderWidth: 2,
                pointRadius: 0,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { display: false },
                y: { grid: { color: '#1E293B' }, ticks: { color: '#94A3B8' } }
            }
        }
    });
}

function renderRelations() {
    if (!window.appState || !window.appState.relationships) return;
    const rels = window.appState.relationships.relations || [];
    const container = document.getElementById("corrTbl");
    if (!container) return;
    container.innerHTML = `
        <thead>
            <tr>
                <th>دارایی</th>
                <th>همبستگی ۲۰ روزه</th>
                <th>همبستگی ۶۰ روزه</th>
                <th>بتا</th>
                <th>قدرت رابطه</th>
            </tr>
        </thead>
        <tbody>
            ${rels.map(r => `
                <tr>
                    <td>${r.asset_b}</td>
                    <td class="num ${r.pearson_20d >= 0 ? 'up' : 'down'}">${fmtNum(r.pearson_20d)}</td>
                    <td class="num ${r.pearson_60d >= 0 ? 'up' : 'down'}">${fmtNum(r.pearson_60d)}</td>
                    <td class="num">${fmtNum(r.beta_30d)}</td>
                    <td>${r.strength}</td>
                </tr>
            `).join("")}
        </tbody>
    `;
}

function renderBacktestDefault() {
    if (!window.appState || !window.appState.backtest) return;
    const bt = window.appState.backtest;
    const el = document.getElementById("btStats");
    if (!el) return;
    el.innerHTML = `
        <div class="kpi-card">
            <h4>📅 دوره بک‌تست</h4>
            <div class="value">${bt.total_days || bt.days_used || 60}<span class="unit">روز</span></div>
        </div>
        <div class="kpi-card">
            <h4>🎯 MAPE انس طلا</h4>
            <div class="value">${fmtNum(bt.gold_mape)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>🎯 MAPE دلار تهران</h4>
            <div class="value">${fmtNum(bt.usd_mape)}<span class="unit">%</span></div>
        </div>
        <div class="kpi-card">
            <h4>📈 دقت جهت مدل</h4>
            <div class="value">${fmtNum(bt.direction_accuracy)}<span class="unit">%</span></div>
        </div>
    `;
}